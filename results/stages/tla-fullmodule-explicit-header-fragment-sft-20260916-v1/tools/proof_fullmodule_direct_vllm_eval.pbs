#!/bin/bash
# Protected two-row model-generated SANY evaluation; no training or eval-row
# feedback is used. Uses the already admitted direct vLLM engine path.
#PBS -N direct-vllm-sany-fullspec
#PBS -A EVITA
#PBS -q by-gpu
#PBS -l select=1:ngpus=4:ncpus=64:mem=256gb
#PBS -l place=pack:shared
#PBS -l walltime=00:30:00
#PBS -l filesystems=home:grand
#PBS -j oe
exec > "/home/eric-spencer/direct_vllm_sany.${PBS_JOBID%%.*}.log" 2>&1
set -euxo pipefail
module load conda/2026-06-08 >/dev/null 2>&1
conda activate base >/dev/null 2>&1
export HF_HUB_OFFLINE=1 HF_HOME=/grand/EVITA/eric-spencer/hf-cache
export OMP_NUM_THREADS=8 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1
export VLLM_LOGGING_LEVEL=INFO PYTHONUNBUFFERED=1
export JAVA_HOME=/grand/EVITA/eric-spencer/tools/jre21
export PATH="$JAVA_HOME/bin:$PATH"
BASE=/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1
cd "$BASE"
export PYTHONPATH="$BASE:${PYTHONPATH:-}"
MODEL=/grand/EVITA/eric-spencer/hf-cache/hub/models--EricSpencer00--chattla-20b/snapshots/c1a3e8b5c6916ce4a0ed830e996662ca28e0a262
ADAPTER=${ADAPTER_PATH:-/grand/EVITA/eric-spencer/chattla_artifacts/tla_repair_proof_primary/178602/checkpoints/final}
INPUT=$BASE/train.json
STAGE=$BASE/results/runs/direct-vllm-sany-$(date +%Y%m%d-%H%M%S)-${PBS_JOBID%%.*}
MODEL_STAGE=/home/eric-spencer/direct-vllm-eval-base-${PBS_JOBID%%.*}
mkdir -p "$MODEL_STAGE"
for f in config.json generation_config.json tokenizer.json tokenizer_config.json chat_template.jinja model.safetensors; do
  ln -sfn "$MODEL/$f" "$MODEL_STAGE/$f"
done
MAX_TOKENS=${MAX_TOKENS:-1024}
python "$BASE/tools/proof_fullmodule_direct_vllm_eval.py" --input "$INPUT" --model-path "$MODEL_STAGE" --adapter-path "$ADAPTER" --output "$STAGE" --max-tokens "$MAX_TOKENS"
