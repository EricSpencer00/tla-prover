#!/bin/bash
#PBS -A EVITA
#PBS -q debug
#PBS -N tla-proof-rl-fresh
#PBS -l select=1:system=polaris
#PBS -l walltime=01:00:00
#PBS -l filesystems=home:grand
#PBS -j oe
set -euo pipefail
: "${PROOF_RL_FRESH_ROOT:?isolated paired evaluation stage required}"
cd "$PROOF_RL_FRESH_ROOT"
export OMP_NUM_THREADS=4 OPENBLAS_NUM_THREADS=4 MKL_NUM_THREADS=4 NUMEXPR_NUM_THREADS=4
export PYTHONUNBUFFERED=1
timeout --signal=TERM --kill-after=20s 3480s /home/eric-spencer/ChatTLA/.venv/bin/python \
 tools/proof_sumsequence_proof_rl_stochastic.py generate \
 --prompts /lus/grand/projects/EVITA/eric-spencer/prove-tla-sumsequence-repair-20260906-v1/prompts.json \
 --model-path /lus/grand/projects/EVITA/eric-spencer/hf-cache/hub/models--meta-llama--Llama-3.1-8B-Instruct/snapshots/0e9e39f249a16976918f6564b8830bc894c89659 \
 --checkpoint /lus/grand/projects/EVITA/eric-spencer/prove-tla-sumsequence-proof-rl-20260906-v1/results/training/policy_optimizer.pt \
 --training-inputs training-inputs.json \
 --training-output /lus/grand/projects/EVITA/eric-spencer/prove-tla-sumsequence-proof-rl-20260906-v1/results/training \
 --baseline-cycle /lus/grand/projects/EVITA/eric-spencer/prove-tla-sumsequence-repair-20260906-v1/results/cycle \
 --baseline-remote-root /lus/grand/projects/EVITA/eric-spencer/prove-tla-sumsequence-repair-20260906-v1 \
 --baseline-remote-parent /lus/grand/projects/EVITA/eric-spencer/prove-tla-token-rl-20260906-v3/results/cycle/training/policy_optimizer.pt \
 --admission paired-admission.json --output results/paired
