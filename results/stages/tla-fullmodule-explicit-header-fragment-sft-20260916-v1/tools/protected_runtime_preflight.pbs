#!/bin/bash
# Bounded same-node preflight for the protected paired experiment.
# Loads the exact base model and policy checkpoint, restores audited tensors,
# and compiles the frozen grammar.
#PBS -N tla-protected-preflight
#PBS -A EVITA
# Sophia by-gpu select counts GPUs. load_policy uses one CUDA device.
# Let PBS choose a production node; occupied capacity is a queue wait.
#PBS -q by-gpu
#PBS -l select=1
#PBS -l place=pack:shared
#PBS -l walltime=00:30:00
#PBS -l filesystems=home:grand
#PBS -j oe
set -euxo pipefail
exec > "/home/eric-spencer/tla-protected-preflight.${PBS_JOBID%%.*}.log" 2>&1
module load conda/2026-06-08 >/dev/null 2>&1
conda activate base >/dev/null 2>&1
export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 HF_HOME=/grand/EVITA/eric-spencer/hf-cache
export OMP_NUM_THREADS=8 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1
export PYTHONUNBUFFERED=1 TOKENIZERS_PARALLELISM=false
BASE=/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-learning-20260906-v1
MODEL=/grand/EVITA/eric-spencer/hf-cache/hub/models--meta-llama--Llama-3.1-8B-Instruct/snapshots/0e9e39f249a16976918f6564b8830bc894c89659
CHECKPOINT=$BASE/results/training/policy_optimizer.pt
GRAMMAR=$BASE/harness/grammars/tla_module_v0.ebnf
cd "$BASE"
python -u - "$MODEL" "$CHECKPOINT" "$GRAMMAR" <<'PY'
import hashlib, json, sys, torch, transformers, xgrammar
from pathlib import Path
from tools.proof_cuda_train import load_policy, restore_policy, model_files
model_path, checkpoint, grammar = map(Path, sys.argv[1:])
net = load_policy(model_path, device='cuda')
saved = torch.load(checkpoint, map_location='cpu', weights_only=False)
selected = restore_policy(net, saved, model_files(model_path))
assert all(torch.equal(p.detach().cpu(), saved['trainable_state'][n]) for n,p in selected.items())
ebnf = grammar.read_text()
assert xgrammar.Grammar.from_ebnf(ebnf) is not None
print(json.dumps({'status':'pass','hostname':__import__('socket').gethostname(),
 'torch':torch.__version__,'transformers':transformers.__version__,
 'xgrammar':getattr(xgrammar,'__version__','unknown'),'cuda':torch.cuda.get_device_name(),
 'checkpoint_sha256':hashlib.sha256(checkpoint.read_bytes()).hexdigest(),
 'grammar_sha256':hashlib.sha256(ebnf.encode()).hexdigest(),
 'restored_parameter_count':len(selected)}, sort_keys=True))
PY
