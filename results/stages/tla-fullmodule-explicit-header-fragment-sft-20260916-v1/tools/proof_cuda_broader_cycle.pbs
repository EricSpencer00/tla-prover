#!/bin/bash
#PBS -A EVITA
#PBS -q debug
#PBS -N tla-broader8b
#PBS -l select=1:system=polaris
#PBS -l walltime=01:00:00
#PBS -l filesystems=home:grand
#PBS -j oe
set -euo pipefail
: "${PROOF_BROADER_ROOT:?new isolated staging root required}"
: "${PROOF_BROADER_PARENT:?immutable whole6 checkpoint required}"
: "${PROOF_BROADER_TRAIN_SHA:?frozen TRAIN packet hash required}"
: "${PROOF_BROADER_PROMPTS_SHA:?frozen prompt packet hash required}"
cd "$PROOF_BROADER_ROOT"
export PYTHONUNBUFFERED=1
timeout --signal=TERM --kill-after=20s 3420s \
 /home/eric-spencer/ChatTLA/.venv/bin/python tools/proof_cuda_broader_cycle.py \
 --train-input train.json --prompts prompts.json \
 --train-input-sha256 "$PROOF_BROADER_TRAIN_SHA" --prompts-sha256 "$PROOF_BROADER_PROMPTS_SHA" \
 --model-path /grand/EVITA/eric-spencer/hf-cache/hub/models--meta-llama--Llama-3.1-8B-Instruct/snapshots/0e9e39f249a16976918f6564b8830bc894c89659 \
 --parent-checkpoint "$PROOF_BROADER_PARENT" --output results/cycle
