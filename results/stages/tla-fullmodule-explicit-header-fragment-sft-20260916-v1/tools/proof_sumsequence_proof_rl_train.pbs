#!/bin/bash
#PBS -A EVITA
#PBS -q debug
#PBS -N tla-proof-rl-one
#PBS -l select=1:system=polaris
#PBS -l walltime=01:00:00
#PBS -l filesystems=home:grand
#PBS -j oe
set -euo pipefail
: "${SUMSEQUENCE_PROOF_RL_ROOT:?isolated staged training root required}"
: "${SUMSEQUENCE_PROOF_RL_MODEL:?verified frozen model path required}"
: "${SUMSEQUENCE_PROOF_RL_CHECKPOINT:?verified immutable parent path required}"
cd "$SUMSEQUENCE_PROOF_RL_ROOT"
export OMP_NUM_THREADS=4 OPENBLAS_NUM_THREADS=4 MKL_NUM_THREADS=4 NUMEXPR_NUM_THREADS=4
export PYTHONUNBUFFERED=1
timeout --signal=TERM --kill-after=20s 950s /home/eric-spencer/ChatTLA/.venv/bin/python \
 tools/proof_sumsequence_proof_rl_train.py run \
 --broader-prompts broader-prompts.json --rollouts rollouts.jsonl \
 --inference-admission inference-admission.json --model-path "$SUMSEQUENCE_PROOF_RL_MODEL" \
 --checkpoint "$SUMSEQUENCE_PROOF_RL_CHECKPOINT" --verified-rows verified-rows.json \
 --verified-summary verified-summary.json --rng-before sampling_generator_before.pt \
 --rng-after sampling_generator_after.pt --feedback feedback.json \
 --probe-results successful-probe --admission training-admission.json --output results/training
