#!/bin/bash
#PBS -A EVITA
#PBS -q debug
#PBS -N tla-seq-repair
#PBS -l select=1:system=polaris
#PBS -l walltime=01:00:00
#PBS -l filesystems=home:grand
#PBS -j oe
set -euo pipefail
: "${SEQUENCE_REPAIR_ROOT:?isolated staging root required}"
: "${SEQUENCE_REPAIR_TRAIN_SHA:?exact training packet required}"
: "${SEQUENCE_REPAIR_PROMPTS_SHA:?exact evaluation packet required}"
: "${SEQUENCE_REPAIR_PARENT:?immutable current parent required}"
cd "$SEQUENCE_REPAIR_ROOT"
export PYTHONUNBUFFERED=1
export OMP_NUM_THREADS=4 OPENBLAS_NUM_THREADS=4 MKL_NUM_THREADS=4 NUMEXPR_NUM_THREADS=4
timeout --signal=TERM --kill-after=20s 3500s /home/eric-spencer/ChatTLA/.venv/bin/python \
 tools/proof_sumsequence_repair_cycle.py run --input train.json --prompts prompts.json \
 --train-sha "$SEQUENCE_REPAIR_TRAIN_SHA" --prompts-sha "$SEQUENCE_REPAIR_PROMPTS_SHA" \
 --model-path /grand/EVITA/eric-spencer/hf-cache/hub/models--meta-llama--Llama-3.1-8B-Instruct/snapshots/0e9e39f249a16976918f6564b8830bc894c89659 \
 --checkpoint "$SEQUENCE_REPAIR_PARENT" --freeze freeze.json --output results/cycle
