#!/bin/bash
#PBS -A EVITA
#PBS -q debug
#PBS -N tla-w4-structural-corruption-v2
#PBS -l select=1:system=polaris:ncpus=64:ngpus=1
#PBS -l walltime=00:15:00
#PBS -l filesystems=home:grand
#PBS -j oe
#PBS -o /home/eric-spencer/tla-fullmodule-structural-corruption-preference-20260915-v2/train.stdout
#PBS -e /home/eric-spencer/tla-fullmodule-structural-corruption-preference-20260915-v2/train.stderr
set -euo pipefail
PREFERENCE_ROOT="${PREFERENCE_ROOT:-/home/eric-spencer/tla-fullmodule-structural-corruption-preference-20260915-v2}"
PREFERENCE_MANIFEST_SHA="${PREFERENCE_MANIFEST_SHA:-0274c476620f45db9d485a9fead641d84ae09489edb90aef9a4e275e137b941b}"
RUN_ROOT=/home/eric-spencer/tla-parent-broader-sany-replay-20260915-v1
BASE=/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1
export PYTHONPATH="$PREFERENCE_ROOT:$RUN_ROOT:$BASE"
export TLA_TOOLS_PATHS="$PREFERENCE_ROOT/tools:$RUN_ROOT/tools:$BASE/tools"
export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 TOKENIZERS_PARALLELISM=false
export HF_HOME=/grand/EVITA/eric-spencer/hf-cache PYTHONUNBUFFERED=1
export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1
export PATH="/grand/EVITA/eric-spencer/tools/jre21/bin:$PATH"
export JAVA_HOME=/grand/EVITA/eric-spencer/tools/jre21
PYTHON=/home/eric-spencer/ChatTLA/.venv/bin/python
test -x "$PYTHON"
MODEL_PATH=/grand/EVITA/eric-spencer/hf-cache/hub/models--meta-llama--Llama-3.1-8B-Instruct/snapshots/0e9e39f249a16976918f6564b8830bc894c89659
if [[ ! -f "$MODEL_PATH/config.json" ]]; then MODEL_PATH=/grand/EVITA/eric-spencer/hf-cache/hub/models--meta--llama--Llama-3.1-8B-Instruct/snapshots/0e9e39f249a16976918f6564b8830bc894c89659; fi
test -f "$MODEL_PATH/config.json"
PACKET="$RUN_ROOT/packet.json"
JAR="$BASE/tools/tla2tools.jar"
SOURCE=/home/eric-spencer/tla-fullmodule-structural-curriculum-20260915-v3/result.7624329/policy_optimizer.pt
MANIFEST="$PREFERENCE_ROOT/preflight/manifest.json"
START="/tmp/tla-structural-corruption-${PBS_JOBID%%.*}.pt"
test -f "$PACKET" -a -f "$JAR" -a -f "$SOURCE" -a -f "$MANIFEST"
test "$(sha256sum "$PACKET" | awk '{print $1}')" = a125a0d5bf66dedfb664c692c69dcd612181a8b7ac316c264075ca434061ce6c
test "$(sha256sum "$SOURCE" | awk '{print $1}')" = 1559b6c3014dc18e8a27c57f9ef58c8f89c507f4995d1152eb1ea9f5f07dcc72
test "$(sha256sum "$MANIFEST" | awk '{print $1}')" = "$PREFERENCE_MANIFEST_SHA"
cp "$SOURCE" "$START"
test "$(sha256sum "$START" | awk '{print $1}')" = 1559b6c3014dc18e8a27c57f9ef58c8f89c507f4995d1152eb1ea9f5f07dcc72
# The immutable parent remains in its verified prior result namespace. Only the
# node-local scratch copy is used by training, so no second persistent parent
# copy is required.
OUT="$PREFERENCE_ROOT/result.${PBS_JOBID%%.*}"
test ! -e "$OUT"
"$PYTHON" -u "$PREFERENCE_ROOT/tools/proof_fullmodule_structural_corruption_preference_train.py" train \
  --packet "$PACKET" --jar "$JAR" --java "$JAVA_HOME/bin/java" --output "$OUT" \
  --manifest "$MANIFEST" --manifest-sha256 "$PREFERENCE_MANIFEST_SHA" \
  --checkpoint "$START" --model "$MODEL_PATH"
