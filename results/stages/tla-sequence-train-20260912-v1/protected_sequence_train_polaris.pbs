#!/bin/bash
# Bounded true-update sequence preference trainer; no generation or gate claim.
#PBS -A EVITA
#PBS -q debug
#PBS -N tla-seq-train
#PBS -l select=1:system=polaris:ngpus=1
#PBS -l walltime=00:15:00
#PBS -l filesystems=home:grand
#PBS -j oe
set -euo pipefail
STAGE=/home/eric-spencer/tla-sequence-train-20260912-v1
cd "$STAGE"
set -o noclobber
exec > "job.${PBS_JOBID%%.*}.log" 2>&1
export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 TOKENIZERS_PARALLELISM=false
export HF_HOME=/grand/EVITA/eric-spencer/hf-cache PYTHONUNBUFFERED=1
export OMP_NUM_THREADS=4 MKL_NUM_THREADS=4
MODEL=/grand/EVITA/eric-spencer/hf-cache/hub/models--meta-llama--Llama-3.1-8B-Instruct/snapshots/0e9e39f249a16976918f6564b8830bc894c89659
CHECKPOINT=/grand/EVITA/eric-spencer/tla-structured-polaris-20260911/result.7605656/policy_optimizer.pt
sha256sum -c SHA256SUMS
timeout --signal=TERM --kill-after=10s 720s /home/eric-spencer/ChatTLA/.venv/bin/python -u -B \
  tools/protected_sequence_preference_train.py train \
  --packet packet.json --plan plan.json --model "$MODEL" --checkpoint "$CHECKPOINT" \
  --output "result.${PBS_JOBID%%.*}"
