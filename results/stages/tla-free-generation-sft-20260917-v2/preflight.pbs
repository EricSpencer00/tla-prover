#!/bin/bash
#PBS -A EVITA
#PBS -q debug
#PBS -N tla-free-generation-preflight-v1
#PBS -l select=1:system=polaris:ncpus=4:ngpus=0
#PBS -l walltime=00:05:00
#PBS -l filesystems=home:grand
#PBS -j oe
#PBS -o /home/eric-spencer/tla-free-generation-sft-20260917-v2/preflight.stdout
#PBS -e /home/eric-spencer/tla-free-generation-sft-20260917-v2/preflight.stderr
set -euo pipefail

ROOT=/home/eric-spencer/tla-free-generation-sft-20260917-v2
PYTHON=/home/eric-spencer/ChatTLA/.venv/bin/python
export PYTHONUNBUFFERED=1
cd "$ROOT"
test "$(pwd)" = "$ROOT"
test -x "$PYTHON" && test -f manifest.json
test -f tools/proof_free_generation_sft.py
test ! -e "preflight.${PBS_JOBID%%.*}.json"
"$PYTHON" -m py_compile tools/proof_free_generation_sft.py
"$PYTHON" -u tools/proof_free_generation_sft.py preflight --manifest manifest.json
