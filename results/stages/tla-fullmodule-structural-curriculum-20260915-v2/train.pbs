#!/bin/bash
#PBS -A EVITA
#PBS -q debug
#PBS -N tla-w4-structural-curriculum-v2
#PBS -l select=1:system=polaris:ncpus=64:ngpus=1
#PBS -l walltime=00:15:00
#PBS -l filesystems=home:grand
#PBS -j oe
#PBS -o /home/eric-spencer/tla-fullmodule-structural-curriculum-20260915-v2/train.stdout
#PBS -e /home/eric-spencer/tla-fullmodule-structural-curriculum-20260915-v2/train.stderr
set -euo pipefail
: "${CURRICULUM_ROOT:?}"
RUN_ROOT=/home/eric-spencer/tla-parent-broader-sany-replay-20260915-v1
BASE=/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1
export PYTHONPATH="$CURRICULUM_ROOT:$RUN_ROOT:$BASE"
export TLA_TOOLS_PATHS="$CURRICULUM_ROOT/tools:$RUN_ROOT/tools:$BASE/tools"
export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 TOKENIZERS_PARALLELISM=false
export HF_HOME=/grand/EVITA/eric-spencer/hf-cache PYTHONUNBUFFERED=1
export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1
export PATH="/grand/EVITA/eric-spencer/tools/jre21/bin:$PATH"
export JAVA_HOME=/grand/EVITA/eric-spencer/tools/jre21
PYTHON=/home/eric-spencer/ChatTLA/.venv/bin/python
test -x "$PYTHON"
MODEL_PATH=/grand/EVITA/eric-spencer/hf-cache/hub/models--meta-llama--Llama-3.1-8B-Instruct/snapshots/0e9e39f249a16976918f6564b8830bc894c89659
if [[ ! -f "$MODEL_PATH/config.json" ]]; then MODEL_PATH=/grand/EVITA/eric-spencer/hf-cache/hub/models--meta--llama--Llama-3.1-8B-Instruct/snapshots/0e9e39f249a16976918f6564b8830bc894c89659; fi
test -f "$MODEL_PATH/config.json"
PACKET="$RUN_ROOT/packet.json"
SOURCE="$CURRICULUM_ROOT/starting-policy_optimizer.pt"
START="/tmp/tla-structural-curriculum-${PBS_JOBID%%.*}.pt"
test -f "$PACKET" -a -f "$SOURCE"
test "$(sha256sum "$PACKET" | awk '{print $1}')" = a125a0d5bf66dedfb664c692c69dcd612181a8b7ac316c264075ca434061ce6c
test "$(sha256sum "$SOURCE" | awk '{print $1}')" = 1d4fce896e0d55b10cf3f6943df58fabd6aeebb3649c98822dc0385b36fd32c4
cp "$SOURCE" "$START"
test "$(sha256sum "$START" | awk '{print $1}')" = 1d4fce896e0d55b10cf3f6943df58fabd6aeebb3649c98822dc0385b36fd32c4
# The immutable starting bytes are preserved locally and the exact remote copy
# is removed only after the scratch copy has passed its hash guard.
rm -f "$SOURCE"
test ! -e "$SOURCE"
ADMISSION="/tmp/tla-structural-curriculum-admission-${PBS_JOBID%%.*}.json"
OUT="$CURRICULUM_ROOT/result.${PBS_JOBID%%.*}"
test ! -e "$OUT"
"$PYTHON" -u "$CURRICULUM_ROOT/tools/proof_fullmodule_structural_curriculum_train.py" admit \
  --input "$PACKET" --checkpoint "$START" --output "$ADMISSION"
"$PYTHON" -u "$CURRICULUM_ROOT/tools/proof_fullmodule_structural_curriculum_train.py" worker \
  --input "$PACKET" --checkpoint "$START" --admission "$ADMISSION" \
  --model-path "$MODEL_PATH" --output "$OUT"
