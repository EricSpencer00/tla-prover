@!!BEGIN
@!!type:obligation
@!!id:87
@!!loc:256:5:256:7
@!!status:proved
@!!prover:isabelle
@!!meth:auto; time-limit: 30; time-used: 5.7 (19%)
@!!already:false
@!!obl:
ASSUME NEW CONSTANT Def(_, _),
       NEW CONSTANT R,
       NEW CONSTANT S,
       NEW CONSTANT f,
       IsWellFoundedOn(R, S) ,
       IsTransitivelyClosedOn(R, S) ,
       WFDefOn(R, S, Def) ,
       OpDefinesFcn(f, S, Def) ,
       ASSUME NEW CONSTANT x \in S,
              \A y \in SetLessThan(x, R, S) : ff[y] = Def(ff, y) 
       PROVE  ff[x] = Def(ff, x) ,
       ASSUME NEW CONSTANT P(_),
              NEW CONSTANT R_1,
              NEW CONSTANT S_1,
              IsWellFoundedOn(R_1, S_1) ,
              \A x \in S_1 :
                 (\A y \in SetLessThan(x, R_1, S_1) : P(y)) => P(x) 
       PROVE  \A x \in S_1 : P(x) ,
       TRUE 
PROVE  \A x \in S : ff[x] = Def(ff, x)

@!!END

@!!BEGIN
@!!type:obligation
@!!id:81
@!!loc:245:3:245:5
@!!status:proved
