                                          THEN CHOOSE x \in T : TRUE
                                          ELSE CHOOSE x \in T :
                                                 <<x, f[n - 1]>> \in R],
                                 CHOOSE x \in T : TRUE,
                                 LAMBDA v, n :
                                   CHOOSE x \in T : <<x, v>> \in R) ,
       (CHOOSE x \in T : TRUE) \in T ,
