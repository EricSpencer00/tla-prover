@!!obl:
ASSUME NEW CONSTANT R,
       NEW CONSTANT S,
       IsWellFoundedOn(R, S) ,
       NEW CONSTANT T,
       T \subseteq S ,
       T # {} ,
       \A x \in T : \E y \in T : <<y, x>> \in R ,
       NatInductiveDefConclusion(CHOOSE f :
                                   f
                                   = [n \in Nat |->
                                        IF n = 0
                                          THEN CHOOSE x \in T : TRUE
                                          ELSE CHOOSE x \in T :
                                                 <<x, f[n - 1]>> \in R],
                                 CHOOSE x \in T : TRUE,
                                 LAMBDA v, n :
                                   CHOOSE x \in T : <<x, v>> \in R) ,
       (CHOOSE x \in T : TRUE) \in T ,
       \A v \in T, n \in Nat \ {0} : (CHOOSE x \in T : <<x, v>> \in R) \in T ,
       ASSUME NEW CONSTANT Def(_, _),
              NEW CONSTANT S_1,
              NEW CONSTANT f,
              NEW CONSTANT f0 \in S_1,
              NatInductiveDefConclusion(f, f0, Def) ,
              f0 \in S_1 ,
              \A v \in S_1, n \in Nat \ {0} : Def(v, n) \in S_1 
       PROVE  f \in [Nat -> S_1] ,
       TRUE 
PROVE  (CHOOSE f :
          f
          = [n \in Nat |->
               IF n = 0
                 THEN CHOOSE x \in T : TRUE
                 ELSE CHOOSE x \in T : <<x, f[n - 1]>> \in R])
       \in [Nat -> T]

