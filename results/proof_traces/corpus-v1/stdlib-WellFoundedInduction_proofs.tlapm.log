       IsWellFoundedOn(R, S) ,
       NEW CONSTANT T,
       T \subseteq S ,
       T # {} ,
       \A x \in T : \E y \in T : <<y, x>> \in R ,
       f0 == CHOOSE x \in T : TRUE,
