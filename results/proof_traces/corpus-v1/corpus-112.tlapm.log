@!!meth:time-limit: 5; time-used: 0.5 (9%)
@!!already:false
@!!obl:
ASSUME NEW CONSTANT N,
       NEW CONSTANT maxClock,
       NEW VARIABLE clock,
       NEW VARIABLE req,
       NEW VARIABLE ack,
       NEW VARIABLE network,
       NEW VARIABLE crit,
       /\ clock \in [Proc -> Nat \ {0}]
       /\ req \in [Proc -> [Proc -> Nat]]
       /\ ack \in [Proc -> SUBSET Proc]
       /\ network \in [Proc -> [Proc -> Seq(Message)]]
       /\ crit \in SUBSET Proc ,
       BasicInv ,
       ClockInv ,
       [Next]_vars ,
       NEW CONSTANT n \in Proc,
       /\ ReqMessage(clock[n]) \in Message
       /\ ReqMessage(clock[n]).type = "req"
       /\ ReqMessage(clock[n]).clock = (req')[n][n] ,
       NEW CONSTANT p \in Proc,
       NEW CONSTANT q \in Proc \ {p},
       /\ \A i \in 1..Len(network[p][q]) :
             network[p][q][i].type = "req"
             => network[p][q][i].clock = req[p][p]
       /\ Contains(network[q][p], "ack") \/ q \in ack[p]
          => (/\ req[q][p] = req[p][p]
              /\ clock[q] > req[p][p]
              /\ Precedes(network[q][p], "ack", "req")
                 => (\A i \in 1..Len(network[q][p]) :
                        network[q][p][i].type = "req"
                        => network[q][p][i].clock > req[p][p]))
       /\ p \in crit
          => (\/ req[p][q] = 0
              \/ req[p][p] < req[p][q]
              \/ req[p][p] = req[p][q] /\ p < q) ,
       UNCHANGED <<network[p][q], req[p][p], req[p][q], req[q][p], ack[p],
                   crit>> ,
       ASSUME Contains(network[q][p]', "ack") \/ q \in (ack')[p] 
       PROVE  /\ (req')[q][p] = req[p][p]
              /\ (clock')[q] > (req')[p][p]
              /\ Precedes(network[q][p]', "ack", "req")
                 => (\A i \in 1..Len(network[q][p]') :
                        (network[q][p]')[i].type = "req"
                        => (network[q][p]')[i].clock > (req')[p][p]) 
PROVE  (/\ \A i \in 1..Len(network[p][q]) :
              network[p][q][i].type = "req"
              => network[p][q][i].clock = req[p][p]
        /\ Contains(network[q][p], "ack") \/ q \in ack[p]
           => (/\ req[q][p] = req[p][p]
               /\ clock[q] > req[p][p]
               /\ Precedes(network[q][p], "ack", "req")
                  => (\A i \in 1..Len(network[q][p]) :
                         network[q][p][i].type = "req"
                         => network[q][p][i].clock > req[p][p]))
        /\ p \in crit
           => (\/ req[p][q] = 0
               \/ req[p][p] < req[p][q]
               \/ req[p][p] = req[p][q] /\ p < q))'

@!!END

