       NEW VARIABLE clock,
       NEW VARIABLE req,
       NEW VARIABLE ack,
       NEW VARIABLE network,
       NEW VARIABLE crit,
       /\ clock \in [Proc -> Nat \ {0}]
       /\ req \in [Proc -> [Proc -> Nat]]
       /\ ack \in [Proc -> SUBSET Proc]
       /\ network \in [Proc -> [Proc -> Seq(Message)]]
       /\ crit \in SUBSET Proc ,
       BasicInv ,
       ClockInv ,
       [Next]_vars ,
       NEW CONSTANT n \in Proc,
       NEW CONSTANT k \in Proc \ {n},
       NEW CONSTANT p \in Proc,
       NEW CONSTANT q \in Proc \ {p},
       ASSUME NEW CONSTANT i \in 1..Len(network[q][p]'),
              (network[q][p]')[i].type = "req" 
       PROVE  i + 1 \in 1..Len(network[q][p])
              /\ (network[q][p]')[i] = network[q][p][i + 1] ,
       /\ \A i \in 1..Len(network[p][q]) :
             network[p][q][i].type = "req"
             => network[p][q][i].clock = req[p][p]
       /\ Contains(network[q][p], "ack") \/ q \in ack[p]
          => (/\ req[q][p] = req[p][p]
              /\ clock[q] > req[p][p]
              /\ Precedes(network[q][p], "ack", "req")
                 => (\A i \in 1..Len(network[q][p]) :
                        network[q][p][i].type = "req"
                        => network[q][p][i].clock > req[p][p]))
       /\ p \in crit
          => (\/ req[p][q] = 0
              \/ req[p][p] < req[p][q]
              \/ req[p][p] = req[p][q] /\ p < q) ,
       /\ network[q][p] # <<>>
       /\ Head(network[q][p]).type = "ack"
       /\ Contains(network[q][p], "ack")
       /\ network[q][p]' = Tail(network[q][p])
       /\ UNCHANGED <<network[p][q], clock, req, crit>> ,
       ASSUME Precedes(network[q][p]', "ack", "req") 
       PROVE  Precedes(network[q][p], "ack", "req") 
PROVE  ASSUME NEW CONSTANT i \in 1..Len(network[q][p]'),
              (network[q][p]')[i].type = "req" 
       PROVE  i + 1 \in 1..Len(network[q][p])
              /\ (network[q][p]')[i] = network[q][p][i + 1]

@!!END

@!!BEGIN
@!!type:obligation
@!!id:581
@!!loc:726:11:726:13
@!!status:normalized
@!!meth:time-limit: 5
@!!obl:ASSUME NEW CONSTANT N,
       NEW CONSTANT maxClock,
       NEW VARIABLE clock,
       NEW VARIABLE req,
       NEW VARIABLE ack,
       NEW VARIABLE network,
       NEW VARIABLE crit,
       /\ clock \in [Proc -> Nat \ {0}]
       /\ req \in [Proc -> [Proc -> Nat]]
       /\ ack \in [Proc -> SUBSET Proc]
       /\ network \in [Proc -> [Proc -> Seq(Message)]]
       /\ crit \in SUBSET Proc ,
       BasicInv ,
       ClockInv ,
       [Next]_vars ,
       NEW CONSTANT n \in Proc,
       NEW CONSTANT k \in Proc \ {n},
       NEW CONSTANT p \in Proc,
       NEW CONSTANT q \in Proc \ {p},
       /\ network[k][n] # <<>>
       /\ Head(network[k][n]).type = "ack"
       /\ ack' = [ack EXCEPT ![n] = ack[n] \cup {k}]
       /\ network'
          = [network EXCEPT
               ![k] = [network[k] EXCEPT ![n] = Tail(network[k][n])]]
       /\ UNCHANGED <<clock, req, crit>>
       /\ Contains(network[k][n], "ack") ,
       p = n /\ q = k 
PROVE  /\ network[q][p] # <<>>
       /\ Head(network[q][p]).type = "ack"
       /\ Contains(network[q][p], "ack")
       /\ network[q][p]' = Tail(network[q][p])
       /\ UNCHANGED <<network[p][q], clock, req, crit>>

@!!END

@!!BEGIN
@!!type:obligation
@!!id:563
@!!loc:704:9:704:11
@!!status:proved
@!!prover:zenon
@!!meth:time-limit: 10; time-used: 2.2 (22%)
@!!already:false
@!!obl:
ASSUME NEW CONSTANT N,
       NEW CONSTANT maxClock,
       NEW VARIABLE clock,
       NEW VARIABLE req,
       NEW VARIABLE ack,
       NEW VARIABLE network,
       NEW VARIABLE crit,
       /\ clock \in [Proc -> Nat \ {0}]
       /\ req \in [Proc -> [Proc -> Nat]]
       /\ ack \in [Proc -> SUBSET Proc]
       /\ network \in [Proc -> [Proc -> Seq(Message)]]
       /\ crit \in SUBSET Proc ,
       BasicInv ,
       ClockInv ,
       [Next]_vars ,
       NEW CONSTANT n \in Proc,
       NEW CONSTANT k \in Proc \ {n},
       AckMessage \in Message /\ AckMessage.type = "ack" ,
       NEW CONSTANT p \in Proc,
       NEW CONSTANT q \in Proc \ {p},
       /\ /\ \A i \in 1..Len(network[p][q]) :
                network[p][q][i].type = "req"
                => network[p][q][i].clock = req[p][p]
          /\ Contains(network[q][p], "ack") \/ q \in ack[p]
             => (/\ req[q][p] = req[p][p]
                 /\ clock[q] > req[p][p]
                 /\ Precedes(network[q][p], "ack", "req")
                    => (\A i \in 1..Len(network[q][p]) :
                           network[q][p][i].type = "req"
                           => network[q][p][i].clock > req[p][p]))
          /\ p \in crit
             => (\/ req[p][q] = 0
                 \/ req[p][p] < req[p][q]
                 \/ req[p][p] = req[p][q] /\ p < q)
       /\ UNCHANGED req[p][p] ,
       /\ network[k][n] # <<>>
       /\ Head(network[k][n]).type = "req"
       /\ req'
          = [req EXCEPT
               ![n] = [req[n] EXCEPT ![k] = Head(network[k][n]).clock]]
       /\ clock'
          = [clock EXCEPT
               ![n] = IF Head(network[k][n]).clock > clock[n]
                        THEN Head(network[k][n]).clock + 1
                        ELSE clock[n] + 1]
       /\ network'
          = [[network EXCEPT
                ![k] = [network[k] EXCEPT ![n] = Tail(network[k][n])]] EXCEPT
               ![n] = [[network EXCEPT
                          ![k] = [network[k] EXCEPT
                                    ![n] = Tail(network[k][n])]][n] EXCEPT
                         ![k] = Append([network EXCEPT
                                          ![k] = [network[k] EXCEPT
                                                    ![n] = Tail(network[k][n])]][n][k],
                                       AckMessage)]]
       /\ UNCHANGED <<ack, crit>>
       /\ Contains(network[k][n], "req") ,
       p \notin {n, k} /\ q # n ,
       TRUE 
PROVE  (/\ \A i \in 1..Len(network[p][q]) :
              network[p][q][i].type = "req"
              => network[p][q][i].clock = req[p][p]
        /\ Contains(network[q][p], "ack") \/ q \in ack[p]
           => (/\ req[q][p] = req[p][p]
               /\ clock[q] > req[p][p]
               /\ Precedes(network[q][p], "ack", "req")
                  => (\A i \in 1..Len(network[q][p]) :
                         network[q][p][i].type = "req"
                         => network[q][p][i].clock > req[p][p]))
        /\ p \in crit
           => (\/ req[p][q] = 0
               \/ req[p][p] < req[p][q]
               \/ req[p][p] = req[p][q] /\ p < q))'

@!!END

