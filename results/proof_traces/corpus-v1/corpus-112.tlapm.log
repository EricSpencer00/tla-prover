                 /\ \A i, j \in 1..Len(network[p][q]) :
                       network[p][q][i].type = "req"
                       /\ network[p][q][j].type = "req" => i = j
                 /\ \A i, j \in 1..Len(network[p][q]) :
                       network[p][q][i].type = "ack"
                       /\ network[p][q][j].type = "ack" => i = j
                 /\ \A i, j \in 1..Len(network[p][q]) :
                       network[p][q][i].type = "rel"
                       /\ network[p][q][j].type = "rel" => i = j
                 /\ network[p][p] = <<>>
           /\ \A p \in Proc :
                 \/ /\ req[p][p] = 0 /\ ack[p] = {} /\ p \notin crit
                    /\ \A q \in Proc :
                          ~(\E i \in 1..Len(network[p][q]) :
                               network[p][q][i].type = "req")
                          /\ ~(\E i \in 1..Len(network[q][p]) :
                                  network[q][p][i].type = "ack")
                 \/ /\ req[p][p] > 0 /\ p \in ack[p]
                    /\ p \in crit => ack[p] = Proc
                    /\ \A q \in Proc :
                          \/ /\ q \in ack[p]
                             /\ ~(\E i \in 1..Len(network[p][q]) :
                                     network[p][q][i].type = "req")
                                /\ ~(\E i \in 1..Len(network[q][p]) :
                                        network[q][p][i].type = "ack")
                                /\ ~(\E i \in 1..Len(network[p][q]) :
                                        network[p][q][i].type = "rel")
                          \/ /\ q \notin ack[p]
                                /\ (\E i \in 1..Len(network[q][p]) :
                                       network[q][p][i].type = "ack")
                             /\ ~(\E i \in 1..Len(network[p][q]) :
                                     network[p][q][i].type = "req")
                                /\ ~(\E i \in 1..Len(network[p][q]) :
                                        network[p][q][i].type = "rel")
                          \/ /\ q \notin ack[p]
                                /\ (\E i \in 1..Len(network[p][q]) :
                                       network[p][q][i].type = "req")
                             /\ ~(\E i \in 1..Len(network[q][p]) :
                                     network[q][p][i].type = "ack")
                                /\ Precedes(network[p][q], "rel", "req"))

@!!END

