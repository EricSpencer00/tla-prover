@!!BEGIN
@!!type:obligation
@!!id:417
@!!loc:579:13:579:15
@!!status:normalized
@!!meth:time-limit: 5
@!!obl:ASSUME NEW CONSTANT N,
       NEW CONSTANT maxClock,
       NEW VARIABLE clock,
       NEW VARIABLE req,
       NEW VARIABLE ack,
       NEW VARIABLE network,
       NEW VARIABLE crit,
       /\ clock \in [Proc -> Nat \ {0}]
       /\ req \in [Proc -> [Proc -> Nat]]
       /\ ack \in [Proc -> SUBSET Proc]
       /\ network \in [Proc -> [Proc -> Seq(Message)]]
       /\ crit \in SUBSET Proc ,
       BasicInv ,
       ClockInv ,
       [Next]_vars ,
       NEW CONSTANT n \in Proc,
       /\ ReqMessage(clock[n]) \in Message
       /\ ReqMessage(clock[n]).type = "req"
       /\ ReqMessage(clock[n]).clock = (req')[n][n] ,
       NEW CONSTANT p \in Proc,
       NEW CONSTANT q \in Proc \ {p},
       (\E i \in 1..Len(network[q][p]) : network[q][p][i].type = "ack")
       \/ q \in ack[p] ,
       /\ req[n][n] = 0
       /\ req' = [req EXCEPT ![n] = [req[n] EXCEPT ![n] = clock[n]]]
       /\ network'
          = [network EXCEPT
               ![n] = [r \in Proc |->
                         IF n = r
                           THEN network[n][r]
                           ELSE Append(network[n][r], ReqMessage(clock[n]))]]
       /\ ack' = [ack EXCEPT ![n] = {n}]
       /\ UNCHANGED <<clock, crit>>
       /\ n \notin crit
       /\ \A q_1 \in Proc :
             ~(\E i \in 1..Len(network[n][q_1]) :
                  network[n][q_1][i].type = "req")
             /\ ~(\E i \in 1..Len(network[q_1][n]) :
                     network[q_1][n][i].type = "ack") ,
       q = n ,
       /\ \A i \in 1..Len(network[p][q]) :
             network[p][q][i].type = "req"
             => network[p][q][i].clock = req[p][p]
       /\ (\E i \in 1..Len(network[q][p]) : network[q][p][i].type = "ack")
          \/ q \in ack[p]
          => (/\ req[q][p] = req[p][p]
              /\ clock[q] > req[p][p]
              /\ Precedes(network[q][p], "ack", "req")
                 => (\A i \in 1..Len(network[q][p]) :
                        network[q][p][i].type = "req"
                        => network[q][p][i].clock > req[p][p]))
       /\ p \in crit => beats(p, q) 
PROVE  /\ (req')[q][p] = req[p][p]
       /\ (clock')[q] > (req')[p][p]
       /\ Precedes(network[q][p]', "ack", "req")
          => (\A i \in 1..Len(network[q][p]') :
                 (network[q][p]')[i].type = "req"
                 => (network[q][p]')[i].clock > (req')[p][p])

@!!END

