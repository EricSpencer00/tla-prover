       NEW VARIABLE crit
PROVE  (/\ clock = [p \in Proc |-> 1]
        /\ req = [p \in Proc |-> [q \in Proc |-> 0]]
        /\ ack = [p \in Proc |-> {}]
        /\ network = [p \in Proc |-> [q \in Proc |-> <<>>]]
        /\ crit = {})
       => (\A p \in Proc :
              \A q \in Proc \ {p} :
                 /\ \A i \in 1..Len(network[p][q]) :
                       network[p][q][i].type = "req"
                       => network[p][q][i].clock = req[p][p]
                 /\ (\E i \in 1..Len(network[q][p]) :
                        network[q][p][i].type = "ack")
                    \/ q \in ack[p]
                    => (/\ req[q][p] = req[p][p]
                        /\ clock[q] > req[p][p]
                        /\ Precedes(network[q][p], "ack", "req")
                           => (\A i \in 1..Len(network[q][p]) :
                                  network[q][p][i].type = "req"
                                  => network[q][p][i].clock > req[p][p]))
                 /\ p \in crit => beats(p, q))

