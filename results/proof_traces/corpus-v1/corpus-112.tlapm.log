@!!BEGIN
@!!type:obligation
@!!id:52
@!!loc:73:7:73:9
@!!status:proved
@!!prover:smt
@!!meth:time-limit: 5; time-used: 0.5 (10%)
@!!already:false
@!!obl:
ASSUME NEW CONSTANT N,
       NEW CONSTANT maxClock,
       NEW VARIABLE clock,
       NEW VARIABLE req,
       NEW VARIABLE ack,
       NEW VARIABLE network,
       NEW VARIABLE crit,
       /\ clock \in [Proc -> Nat \ {0}]
       /\ req \in [Proc -> [Proc -> Nat]]
       /\ ack \in [Proc -> SUBSET Proc]
       /\ network \in [Proc -> [Proc -> Seq(Message)]]
       /\ crit \in SUBSET Proc ,
       [Next]_vars ,
       NEW CONSTANT p \in Proc,
       NEW CONSTANT q \in Proc \ {p},
       /\ network[q][p] # <<>>
       /\ Head(network[q][p]).type = "req"
       /\ req'
          = [req EXCEPT
               ![p] = [req[p] EXCEPT ![q] = Head(network[q][p]).clock]]
       /\ clock'
          = [clock EXCEPT
               ![p] = IF Head(network[q][p]).clock > clock[p]
                        THEN Head(network[q][p]).clock + 1
                        ELSE clock[p] + 1]
       /\ network'
          = [[network EXCEPT
                ![q] = [network[q] EXCEPT ![p] = Tail(network[q][p])]] EXCEPT
               ![p] = [[network EXCEPT
                          ![q] = [network[q] EXCEPT
                                    ![p] = Tail(network[q][p])]][p] EXCEPT
                         ![q] = Append([network EXCEPT
                                          ![q] = [network[q] EXCEPT
                                                    ![p] = Tail(network[q][p])]][p][q],
                                       AckMessage)]]
       /\ UNCHANGED <<ack, crit>> 
PROVE  /\ ack' \in [Proc -> SUBSET Proc]
       /\ crit' \in SUBSET Proc

@!!END

