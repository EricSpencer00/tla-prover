@!!BEGIN
@!!type:obligation
@!!id:73
@!!loc:169:1:169:3
@!!status:proved
@!!prover:smt
@!!meth:time-limit: 5; time-used: 1.3 (25%)
@!!already:false
@!!obl:
ASSUME NEW CONSTANT N,
       NEW CONSTANT maxClock,
       NEW VARIABLE clock,
       NEW VARIABLE req,
       NEW VARIABLE ack,
       NEW VARIABLE network,
       NEW VARIABLE crit,
       NEW CONSTANT s \in Seq(Message),
       NEW CONSTANT mt1,
       NEW CONSTANT mt2,
       NEW CONSTANT m \in Message,
       m.type # mt1 
PROVE  (\A i, j \in 1..Len(Append(s, m)) :
           Append(s, m)[i].type = mt1 /\ Append(s, m)[j].type = mt2 => i < j)
       <=> (\A i, j \in 1..Len(s) :
               s[i].type = mt1 /\ s[j].type = mt2 => i < j)

@!!END

