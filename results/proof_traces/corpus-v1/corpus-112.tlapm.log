       /\ clock \in [Proc -> Nat \ {0}]
       /\ req \in [Proc -> [Proc -> Nat]]
       /\ ack \in [Proc -> SUBSET Proc]
       /\ network \in [Proc -> [Proc -> Seq(Message)]]
       /\ crit \in SUBSET Proc ,
       /\ \A p, q \in Proc :
             /\ AtMostOne(network[p][q], "req")
             /\ AtMostOne(network[p][q], "ack")
             /\ AtMostOne(network[p][q], "rel")
             /\ network[p][p] = <<>>
       /\ \A p \in Proc : CommInv(p) ,
       [Next]_vars ,
       NEW CONSTANT n \in Proc,
       /\ ReqMessage(clock[n]) \in Message
       /\ ReqMessage(clock[n]).type = "req" ,
