         /\ clock = [p \in Proc |-> 1]
         /\ req = [p \in Proc |-> [q \in Proc |-> 0]]
         /\ ack = [p \in Proc |-> {}]
         /\ network = [p \in Proc |-> [q \in Proc |-> <<>>]]
         /\ crit = {},
       Contains(s, mtype) == \E i \in 1..Len(s) : s[i].type = mtype,
       ClockInvInner(p, q) ==
         LET pq == network[p][q]
             qp == network[q][p]
         IN  /\ \A i \in 1..Len(pq) :
                   pq[i].type = "req" => pq[i].clock = req[p][p]
             /\ Contains(qp, "ack") \/ q \in ack[p]
                => (/\ req[q][p] = req[p][p]
                    /\ clock[q] > req[p][p]
                    /\ Precedes(qp, "ack", "req")
                       => (\A i \in 1..Len(qp) :
                              qp[i].type = "req" => qp[i].clock > req[p][p]))
             /\ p \in crit => beats(p, q),
       ClockInv == \A p \in Proc : \A q \in Proc \ {p} : ClockInvInner(p, q)
PROVE  Init => ClockInv

@!!END

