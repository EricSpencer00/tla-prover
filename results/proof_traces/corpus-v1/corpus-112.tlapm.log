       NEW CONSTANT q \in Proc,
       /\ req[n][n] = 0
       /\ req' = [req EXCEPT ![n] = [req[n] EXCEPT ![n] = clock[n]]]
       /\ network'
          = [network EXCEPT
               ![n] = [r \in Proc |->
