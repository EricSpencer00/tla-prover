@!!BEGIN
@!!type:obligation
@!!id:100
@!!loc:245:7:245:9
@!!status:normalized
@!!meth:time-limit: 5
@!!obl:ASSUME NEW CONSTANT N,
       NEW CONSTANT maxClock,
       NEW VARIABLE clock,
       NEW VARIABLE req,
       NEW VARIABLE ack,
       NEW VARIABLE network,
       NEW VARIABLE crit,
       /\ clock \in [Proc -> Nat \ {0}]
       /\ req \in [Proc -> [Proc -> Nat]]
       /\ ack \in [Proc -> SUBSET Proc]
       /\ network \in [Proc -> [Proc -> Seq(Message)]]
       /\ crit \in SUBSET Proc ,
       /\ \A p, q \in Proc : NetworkInv(p, q)
       /\ \A p \in Proc :
             \/ /\ req[p][p] = 0 /\ ack[p] = {} /\ p \notin crit
                /\ \A q \in Proc :
                      ~Contains(network[p][q], "req")
                      /\ ~Contains(network[q][p], "ack")
             \/ /\ req[p][p] > 0 /\ p \in ack[p]
                /\ p \in crit => ack[p] = Proc
                /\ \A q \in Proc :
                      \/ /\ q \in ack[p]
                         /\ ~Contains(network[p][q], "req")
                            /\ ~Contains(network[q][p], "ack")
                            /\ ~Contains(network[p][q], "rel")
                      \/ /\ q \notin ack[p] /\ Contains(network[q][p], "ack")
                         /\ ~Contains(network[p][q], "req")
                            /\ ~Contains(network[p][q], "rel")
                      \/ /\ q \notin ack[p] /\ Contains(network[p][q], "req")
                         /\ ~Contains(network[q][p], "ack")
                            /\ Precedes(network[p][q], "rel", "req") ,
       [Next]_vars ,
       NEW CONSTANT n \in Proc,
       /\ ReqMessage(clock[n]) \in Message
       /\ ReqMessage(clock[n]).type = "req" ,
       ~req[n][n] > 0 
PROVE  /\ n \notin crit
       /\ \A q \in Proc :
             ~Contains(network[n][q], "req")
             /\ ~Contains(network[q][n], "ack")

@!!END

