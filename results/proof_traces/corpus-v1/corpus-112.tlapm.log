       NEW CONSTANT n \in Proc,
       <2>1 
PROVE  /\ req[n][n] = 0
       /\ req' = [req EXCEPT ![n][n] = clock[n]]
       /\ network'
          = [network EXCEPT ![n] = Broadcast(n, ReqMessage(clock[n]))]
       /\ ack' = [ack EXCEPT ![n] = {n}]
       /\ UNCHANGED <<clock, crit>>
       /\ n \notin crit
       /\ \A q \in Proc :
             ~Contains(network[n][q], "req")
             /\ ~Contains(network[q][n], "ack")

