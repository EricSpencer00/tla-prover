@!!status:normalized
@!!meth:time-limit: 5
@!!obl:ASSUME NEW CONSTANT B1,
       NEW CONSTANT B2,
       NEW CONSTANT B3,
       IsABag(B1) ,
       IsABag(B2) ,
       IsABag(B3) 
PROVE  /\ [e
           \in DOMAIN [e \in DOMAIN B1 \cup DOMAIN B2 |->
                         (IF e \in DOMAIN B1 THEN B1[e] ELSE 0)
                         + (IF e \in DOMAIN B2 THEN B2[e] ELSE 0)]
               \cup DOMAIN B3 |->
             (IF
                e
                \in DOMAIN [e_1 \in DOMAIN B1 \cup DOMAIN B2 |->
                              (IF e_1 \in DOMAIN B1 THEN B1[e_1] ELSE 0)
                              + (IF e_1 \in DOMAIN B2 THEN B2[e_1] ELSE 0)]
                THEN [e_1 \in DOMAIN B1 \cup DOMAIN B2 |->
                        (IF e_1 \in DOMAIN B1 THEN B1[e_1] ELSE 0)
                        + (IF e_1 \in DOMAIN B2 THEN B2[e_1] ELSE 0)][e]
                ELSE 0)
             + (IF e \in DOMAIN B3 THEN B3[e] ELSE 0)]
          = [e \in DOMAIN B1 \cup DOMAIN B2 \cup DOMAIN B3 |->
               (IF e \in DOMAIN B1 THEN B1[e] ELSE 0)
               + (IF e \in DOMAIN B2 THEN B2[e] ELSE 0)
               + (IF e \in DOMAIN B3 THEN B3[e] ELSE 0)]
       /\ [e
           \in DOMAIN B1
               \cup DOMAIN [e \in DOMAIN B2 \cup DOMAIN B3 |->
                              (IF e \in DOMAIN B2 THEN B2[e] ELSE 0)
                              + (IF e \in DOMAIN B3 THEN B3[e] ELSE 0)] |->
             (IF e \in DOMAIN B1 THEN B1[e] ELSE 0)
             + (IF
                  e
                  \in DOMAIN [e_1 \in DOMAIN B2 \cup DOMAIN B3 |->
                                (IF e_1 \in DOMAIN B2 THEN B2[e_1] ELSE 0)
                                + (IF e_1 \in DOMAIN B3 THEN B3[e_1] ELSE 0)]
                  THEN [e_1 \in DOMAIN B2 \cup DOMAIN B3 |->
                          (IF e_1 \in DOMAIN B2 THEN B2[e_1] ELSE 0)
                          + (IF e_1 \in DOMAIN B3 THEN B3[e_1] ELSE 0)][e]
                  ELSE 0)]
          = [e \in DOMAIN B1 \cup (DOMAIN B2 \cup DOMAIN B3) |->
               (IF e \in DOMAIN B1 THEN B1[e] ELSE 0)
               + ((IF e \in DOMAIN B2 THEN B2[e] ELSE 0)
                  + (IF e \in DOMAIN B3 THEN B3[e] ELSE 0))]

@!!END

