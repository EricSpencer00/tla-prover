@!!BEGIN
@!!type:obligation
@!!id:81
@!!loc:306:1:306:3
@!!status:proved
@!!prover:smt
@!!meth:time-limit: 5; time-used: 1.4 (29%)
@!!already:false
@!!obl:
ASSUME NEW CONSTANT B,
       B \in [DOMAIN B -> {n \in Nat : n > 0}] ,
       NEW CONSTANT n \in Nat,
       NEW CONSTANT e
PROVE  (IF
          e
          \in DOMAIN (IF n > 0
                        THEN [i \in DOMAIN B |-> n * B[i]]
                        ELSE [e_1 \in {} |-> 1])
          THEN (IF n > 0
                  THEN [i \in DOMAIN B |-> n * B[i]]
                  ELSE [e_1 \in {} |-> 1])[e]
          ELSE 0)
       = n * (IF e \in DOMAIN B THEN B[e] ELSE 0)

@!!END

