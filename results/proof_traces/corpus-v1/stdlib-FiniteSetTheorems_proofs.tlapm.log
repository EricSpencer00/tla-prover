       NEW CONSTANT T,
       IsFiniteSet(T) ,
       NEW CONSTANT A \in SUBSET T,
       NEW CONSTANT x \in T \ A,
       /\ Cardinality(A) \in Nat
       /\ Cardinality(S) \in Nat ,
       [s \in S |-> <<s, x>>] \in Bijection(S, {<<s, x>> : s \in S}) 
PROVE  Bijection(S, {<<s, x>> : s \in S}) # {}

@!!END

