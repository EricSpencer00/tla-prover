              = [B_1 \in SUBSET A |-> B_1 \cup {x}][C] 
       PROVE  B = C ,
       ASSUME NEW CONSTANT S_1,
              NEW CONSTANT T,
              NEW CONSTANT F \in [S_1 -> T],
              \A a, b \in S_1 : F[a] = F[b] => a = b 
       PROVE  F \in Injection(S_1, T) ,
       TRUE 
PROVE  [B \in SUBSET A |-> B \cup {x}]
       \in Injection(SUBSET A, {B \cup {x} : B \in SUBSET A})

@!!END

