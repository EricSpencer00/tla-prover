                      THEN Cardinality(S_1) - 1
                      ELSE Cardinality(S_1)) ,
       ASSUME NEW CONSTANT S_1,
              IsFiniteSet(S_1) ,
              NEW CONSTANT T_1 \in SUBSET S_1
       PROVE  /\ IsFiniteSet(T_1)
