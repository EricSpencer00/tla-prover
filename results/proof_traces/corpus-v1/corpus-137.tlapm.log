                   /\ IF toVroot[self] # {}
                        THEN /\ \E w \in toVroot[self] :
                                   /\ vroot' = vroot \cup {w}
                                   /\ toVroot'
                                      = [toVroot EXCEPT
                                           ![self] = toVroot[self] \ {w}]
                             /\ pc' = [pc EXCEPT ![self] = "c"]
                        ELSE /\ pc' = [pc EXCEPT ![self] = "a"]
                             /\ UNCHANGED <<vroot, toVroot>>
                   /\ UNCHANGED <<marked, u>>))
           \/ (/\ \A self \in Procs : pc[self] = "Done"
               /\ UNCHANGED <<marked, vroot, pc, u, toVroot>>)]_<<marked,
                                                                  vroot, pc,
                                                                  u,
                                                                  toVroot>>
       => (/\ marked \in SUBSET Nodes
           /\ vroot \in SUBSET Nodes
           /\ u \in [Procs -> Nodes]
           /\ toVroot \in [Procs -> SUBSET Nodes]
           /\ pc \in [Procs -> {"a", "b", "c", "Done"}]
           /\ \A q \in Procs :
                 /\ pc[q] \in {"a", "b", "Done"} => toVroot[q] = {}
                 /\ pc[q] = "b" => u[q] \in vroot \cup marked)'

@!!END

