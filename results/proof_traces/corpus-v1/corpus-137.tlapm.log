@!!BEGIN
@!!type:obligation
@!!id:14
@!!loc:20:5:20:7
@!!status:normalized
@!!meth:time-limit: 5
@!!obl:ASSUME NEW CONSTANT Nodes,
       NEW CONSTANT Succ,
       NEW CONSTANT Root,
       NEW CONSTANT Procs,
       NEW VARIABLE marked,
       NEW VARIABLE vroot,
       NEW VARIABLE pc,
       NEW VARIABLE u,
       NEW VARIABLE toVroot,
       /\ Procs # {}
       /\ IsFiniteSet(Procs) 
PROVE  (/\ marked = {}
        /\ vroot = {Root}
        /\ u = [self \in Procs |-> Root]
        /\ toVroot = [self \in Procs |-> {}]
        /\ pc = [self \in Procs |-> "a"])
       => (/\ marked = {}
           /\ vroot \cup (UNION {toVroot[i] : i \in Procs}) = {Root}
           /\ (IF \A q \in Procs : pc[q] = "Done" THEN "Done" ELSE "a") = "a")

@!!END

