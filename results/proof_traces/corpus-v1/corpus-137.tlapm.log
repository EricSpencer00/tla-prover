@!!BEGIN
@!!type:obligation
@!!id:47
@!!loc:53:5:53:7
@!!status:normalized
@!!meth:time-limit: 5
@!!obl:ASSUME NEW CONSTANT Nodes,
       NEW CONSTANT Succ,
       NEW CONSTANT Root,
       NEW CONSTANT Procs,
       NEW VARIABLE marked,
       NEW VARIABLE vroot,
       NEW VARIABLE pc,
       NEW VARIABLE u,
       NEW VARIABLE toVroot,
       /\ marked \in SUBSET Nodes
       /\ vroot \in SUBSET Nodes
       /\ u \in [Procs -> Nodes]
       /\ toVroot \in [Procs -> SUBSET Nodes]
       /\ pc \in [Procs -> {"a", "b", "c", "Done"}]
       /\ \A q \in Procs :
             /\ pc[q] \in {"a", "b", "Done"} => toVroot[q] = {}
             /\ pc[q] = "b" => u[q] \in vroot \cup marked ,
       [(\E self \in Procs : p(self))
        \/ (/\ \A self \in ProcSet : pc[self] = "Done"
            /\ UNCHANGED <<marked, vroot, pc, u, toVroot>>)]_<<marked, vroot,
                                                               pc, u,
                                                               toVroot>> ,
       NEW CONSTANT self \in Procs,
       /\ pc[self] = "b"
       /\ IF u[self] \notin marked
            THEN /\ marked' = marked \cup {u[self]}
                 /\ toVroot' = [toVroot EXCEPT ![self] = Succ[u[self]]]
                 /\ pc' = [pc EXCEPT ![self] = "c"]
                 /\ vroot' = vroot
            ELSE /\ vroot' = vroot \ {u[self]}
                 /\ pc' = [pc EXCEPT ![self] = "a"]
                 /\ UNCHANGED <<marked, toVroot>>
       /\ u' = u 
PROVE  [(/\ (IF \A q \in Procs : pc[q] = "Done" THEN "Done" ELSE "a") = "a"
         /\ IF vroot \cup (UNION {toVroot[i] : i \in Procs}) # {}
              THEN /\ \E v \in vroot \cup (UNION {toVroot[i] : i \in Procs}) :
                         IF v \notin marked
                           THEN /\ marked' = marked \cup {v}
                                /\ (vroot
                                    \cup (UNION {toVroot[i] : i \in Procs}))'
                                   = vroot
                                     \cup (UNION {toVroot[i] : i \in Procs})
                                     \cup Succ[v]
                           ELSE /\ (vroot
                                    \cup (UNION {toVroot[i] : i \in Procs}))'
                                   = (vroot
                                      \cup (UNION {toVroot[i] : i \in Procs}))
                                     \ {v}
                                /\ UNCHANGED marked
                   /\ (IF \A q \in Procs : pc[q] = "Done"
                         THEN "Done"
                         ELSE "a")'
                      = "a"
              ELSE /\ (IF \A q \in Procs : pc[q] = "Done"
                         THEN "Done"
                         ELSE "a")'
                      = "Done"
                   /\ UNCHANGED <<marked,
                                  vroot
                                  \cup (UNION {toVroot[i] : i \in Procs})>>)
        \/ R!Terminating]_<<marked,
                            vroot \cup (UNION {toVroot[i] : i \in Procs}),
                            IF \A q \in Procs : pc[q] = "Done"
                              THEN "Done"
                              ELSE "a">>

@!!END

