                                 ![i] = IF j > i THEN "black" ELSE color[i]]
                   /\ UNCHANGED <<tpos, tcolor>>)
                  \/ (/\ active[i]
                      /\ active' = [active EXCEPT ![i] = FALSE]
                      /\ UNCHANGED <<color, tpos, tcolor>>))]_<<active,
                                                                color, tpos,
                                                                tcolor>>
       => (\/ P0::\A i \in 0..N - 1 : tpos < i => ~active[i]
           \/ P1::\E j \in 0..tpos : color[j] = "black"
           \/ P2::(tcolor = "black"))'

