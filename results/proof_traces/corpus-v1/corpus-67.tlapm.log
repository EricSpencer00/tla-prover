       NEW VARIABLE tcolor,
       N \in Nat \ {0} 
PROVE  (/\ active \in [0..N - 1 -> BOOLEAN]
        /\ color \in [0..N - 1 -> {"white", "black"}]
        /\ tpos \in 0..N - 1
        /\ tcolor \in {"white", "black"})
       /\ (\/ P0::\A i \in 0..N - 1 : tpos < i => ~active[i]
           \/ P1::\E j \in 0..tpos : color[j] = "black"
           \/ P2::(tcolor = "black"))
       /\ [(/\ tpos = 0
            /\ tcolor = "black" \/ color[0] = "black"
            /\ tpos' = N - 1
            /\ tcolor' = "white"
            /\ active' = active
            /\ color' = [color EXCEPT ![0] = "white"])
           \/ (\E i \in 0..N - 1 \ {0} :
                  /\ tpos = i
                  /\ ~active[i] \/ color[i] = "black" \/ tcolor = "black"
                  /\ tpos' = i - 1
                  /\ tcolor'
                     = (IF color[i] = "black" THEN "black" ELSE tcolor)
                  /\ active' = active
                  /\ color' = [color EXCEPT ![i] = "white"])
           \/ (\E i \in 0..N - 1 :
                  (/\ active[i]
                   /\ \E j \in 0..N - 1 \ {i} :
                         /\ active' = [active EXCEPT ![j] = TRUE]
