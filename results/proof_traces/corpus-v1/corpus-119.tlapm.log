@!!BEGIN
@!!type:obligation
@!!id:45
@!!loc:145:3:145:5
@!!status:normalized
@!!meth:time-limit: 5
@!!obl:ASSUME NEW VARIABLE f,
       NEW VARIABLE h,
       NEW VARIABLE i,
       NEW VARIABLE pc
PROVE  (/\ f \in Seq(Nat)
        /\ i \in 1..Len(f) + 1
        /\ i \in Nat
        /\ h \in Nat \cup {-1})
       /\ (\A idx \in 1..i - 1 : f[idx] =< h)
       /\ (pc = "Done" => i = Len(f) + 1)
       => (pc = "Done" => (\A idx \in DOMAIN f : f[idx] =< h))

@!!END

