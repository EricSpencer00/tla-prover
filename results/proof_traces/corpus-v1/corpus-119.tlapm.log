@!!BEGIN
@!!type:obligation
@!!id:25
@!!loc:114:7:114:9
@!!status:proved
@!!prover:smt
@!!meth:time-limit: 5; time-used: 0.0 (1%)
@!!already:false
@!!obl:
ASSUME NEW VARIABLE f,
       NEW VARIABLE h,
       NEW VARIABLE i,
       NEW VARIABLE pc
PROVE  (\A idx \in 1..i - 1 : f[idx] =< h)
       /\ (/\ f \in Seq(Nat)
           /\ i \in 1..Len(f) + 1
           /\ i \in Nat
           /\ h \in Nat \cup {-1})
       /\ (/\ pc = "lb"
           /\ IF i =< Len(f)
                THEN /\ h' = (IF h >= f[i] THEN h ELSE f[i])
                     /\ i' = i + 1
                     /\ pc' = "lb"
                ELSE /\ pc' = "Done"
                     /\ UNCHANGED <<h, i>>
           /\ f' = f)
       => (\A idx \in 1..i - 1 : f[idx] =< h)'

@!!END

