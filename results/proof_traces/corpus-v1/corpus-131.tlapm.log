@!!BEGIN
@!!type:obligation
@!!id:16
@!!loc:33:1:33:3
@!!status:normalized
@!!meth:time-limit: 5
@!!obl:ASSUME NEW CONSTANT Value,
       NEW VARIABLE seq,
       NEW VARIABLE i,
       NEW VARIABLE cand,
       NEW VARIABLE cnt,
       /\ seq \in Seq(Value)
       /\ i \in 1..Len(seq) + 1
       /\ cand \in Value
       /\ cnt \in Nat ,
       NEW CONSTANT j \in 1..Len(seq),
       NEW CONSTANT v
PROVE  {k \in 1..(j + 1) - 1 : seq[k] = v}
       = (IF seq[j] = v
            THEN {k \in 1..j - 1 : seq[k] = v} \cup {j}
            ELSE {k \in 1..j - 1 : seq[k] = v})

@!!END

