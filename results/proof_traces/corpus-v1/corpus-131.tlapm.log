@!!BEGIN
@!!type:obligation
@!!id:9
@!!loc:26:1:26:3
@!!status:normalized
@!!meth:time-limit: 10
@!!obl:ASSUME NEW CONSTANT Value,
       NEW VARIABLE seq,
       NEW VARIABLE i,
       NEW VARIABLE cand,
       NEW VARIABLE cnt,
       NEW CONSTANT v,
       NEW CONSTANT j \in Int,
       1 \in Int ,
       j - 1 \in Int ,
       \A v_1, j_1 : PositionsBefore(v_1, j_1) \in SUBSET 1..j_1 - 1 ,
       ASSUME NEW CONSTANT a \in Int,
              NEW CONSTANT b \in Int
       PROVE  /\ IsFiniteSet(a..b)
              /\ Cardinality(a..b) = (IF a > b THEN 0 ELSE b - a + 1) ,
       ASSUME NEW CONSTANT S,
              IsFiniteSet(S) ,
              NEW CONSTANT T \in SUBSET S
       PROVE  /\ IsFiniteSet(T)
              /\ Cardinality(T) =< Cardinality(S)
              /\ Cardinality(S) = Cardinality(T) => S = T ,
       TRUE 
PROVE  IsFiniteSet(PositionsBefore(v, j))

@!!END

