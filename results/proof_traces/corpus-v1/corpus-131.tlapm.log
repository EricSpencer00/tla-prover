@!!BEGIN
@!!type:obligation
@!!id:6
@!!loc:11:3:11:5
@!!status:proved
@!!prover:smt
@!!meth:time-limit: 5; time-used: 0.3 (5%)
@!!already:false
@!!obl:
ASSUME NEW CONSTANT Value,
       NEW VARIABLE seq,
       NEW VARIABLE i,
       NEW VARIABLE cand,
       NEW VARIABLE cnt
PROVE  (/\ seq \in Seq(Value)
        /\ i \in 1..Len(seq) + 1
        /\ cand \in Value
        /\ cnt \in Nat)
       /\ [/\ i =< Len(seq)
           /\ i' = i + 1 /\ seq' = seq
           /\ \/ /\ cnt = 0
                 /\ cand' = seq[i]
                 /\ cnt' = 1
              \/ /\ cnt # 0 /\ cand = seq[i]
                 /\ cand' = cand
                 /\ cnt' = cnt + 1
              \/ /\ cnt # 0 /\ cand # seq[i]
                 /\ cand' = cand
                 /\ cnt' = cnt - 1]_<<seq, i, cand, cnt>>
       => (/\ seq \in Seq(Value)
           /\ i \in 1..Len(seq) + 1
           /\ cand \in Value
           /\ cnt \in Nat)'

@!!END

