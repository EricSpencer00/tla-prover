@!!obl:
ASSUME NEW CONSTANT Value,
       NEW VARIABLE seq,
       NEW VARIABLE i,
       NEW VARIABLE cand,
       NEW VARIABLE cnt,
       /\ seq \in Seq(Value)
       /\ i \in 1..Len(seq) + 1
       /\ cand \in Value
       /\ cnt \in Nat ,
       /\ cnt =< OccurrencesBefore(cand, i)
       /\ 2 * (OccurrencesBefore(cand, i) - cnt) =< i - 1 - cnt
       /\ \A v \in Value \ {cand} :
             2 * OccurrencesBefore(v, i) =< i - 1 - cnt ,
       Next ,
       i =< Len(seq) /\ i' = i + 1 /\ seq' = seq ,
       \A v : \A j \in Int : OccurrencesBefore(v, j) \in Nat ,
       NEW CONSTANT v \in Value \ {cand'},
       cnt # 0 /\ cand # seq[i] /\ cand' = cand /\ cnt' = cnt - 1 ,
       ASSUME /\ seq \in Seq(Value)
              /\ i \in 1..Len(seq) + 1
              /\ cand \in Value
              /\ cnt \in Nat ,
              NEW CONSTANT j \in 1..Len(seq),
              NEW CONSTANT v_1
       PROVE  OccurrencesBefore(v_1, j + 1)
              = (IF seq[j] = v_1
                   THEN OccurrencesBefore(v_1, j) + 1
                   ELSE OccurrencesBefore(v_1, j)) 
PROVE  2 * OccurrencesBefore(v, i') =< i' - 1 - cnt'

@!!END

