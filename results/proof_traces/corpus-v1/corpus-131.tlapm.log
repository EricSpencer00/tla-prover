       NEW VARIABLE cnt
PROVE  (/\ seq \in Seq(Value)
        /\ i \in 1..Len(seq) + 1
        /\ cand \in Value
        /\ cnt \in Nat)
       /\ [/\ i =< Len(seq)
           /\ i' = i + 1 /\ seq' = seq
           /\ \/ /\ cnt = 0
                 /\ cand' = seq[i]
                 /\ cnt' = 1
              \/ /\ cnt # 0 /\ cand = seq[i]
                 /\ cand' = cand
                 /\ cnt' = cnt + 1
              \/ /\ cnt # 0 /\ cand # seq[i]
                 /\ cand' = cand
                 /\ cnt' = cnt - 1]_<<seq, i, cand, cnt>>
       => (/\ seq \in Seq(Value)
           /\ i \in 1..Len(seq) + 1
           /\ cand \in Value
           /\ cnt \in Nat)'

@!!END

