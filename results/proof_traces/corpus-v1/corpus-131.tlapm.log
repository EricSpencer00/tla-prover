       NEW VARIABLE cnt,
       \A v : \A j \in Int : OccurrencesBefore(v, j) \in Nat 
PROVE  (/\ seq \in Seq(Value)
        /\ i \in 1..Len(seq) + 1
        /\ cand \in Value
        /\ cnt \in Nat)
       /\ (/\ cnt =< OccurrencesBefore(cand, i)
           /\ 2 * (OccurrencesBefore(cand, i) - cnt) =< i - 1 - cnt
           /\ \A v \in Value \ {cand} :
                 2 * OccurrencesBefore(v, i) =< i - 1 - cnt)
       => (i > Len(seq)
           => (\A v \in Value :
                  2 * OccurrencesBefore(v, Len(seq) + 1) > Len(seq)
                  => v = cand))

@!!END

