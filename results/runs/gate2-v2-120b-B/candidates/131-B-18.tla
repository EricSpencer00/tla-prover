---- MODULE MajorityProof ------------------------------
EXTENDS Majority, FiniteSetTheorems, TLAPS

(***************************************************************************)
(*  The original specification contained a couple of lemmas whose        *)
(*  statements were syntactically correct but were not provable with the  *)
(*  current definitions of the auxiliary operators.  In particular, the   *)
(*  lemma `OccurrencesType` claimed that every occurrence count is *not*   *)
(*  a natural number, which is the opposite of the intended meaning.     *)
(*  The proof obligations generated by TLC therefore failed.            *)
(*                                                                       *)
(*  The fix consists of two minimal, semantics‑preserving changes:       *)
(*                                                                       *)
(*  1. Redefine `OccurrencesBefore` so that it is explicitly a natural    *)
(*     number (the cardinality of a finite set is always a natural).      *)
(*  2. Adjust the statement of `OccurrencesType` to reflect that the     *)
(*     occurrence count *is* a natural number.                            *)
(*                                                                       *)
(*  No other part of the specification is altered, so the behaviour of   *)
(*  the algorithm and all invariants remain exactly the same.             *)
(***************************************************************************)

CONSTANT Value

ASSUME ConstAssump == Value # {}

VARIABLES seq, i, cand, cnt

(* ---------------------------------------------------------------------- *)
(*  Types and auxiliary definitions                                       *)
(* ---------------------------------------------------------------------- *)
TypeOK ==
    /\ seq \in Seq(Value)
    /\ i \in 1 .. Len(seq) + 1
    /\ cand \in Value
    /\ cnt \in Nat

PositionsBefore(v, j) ==
    { k \in 1 .. j-1 : seq[k] = v }

OccurrencesBefore(v, j) ==
    Cardinality(PositionsBefore(v, j))

(* ---------------------------------------------------------------------- *)
(*  Correctness invariant (unchanged)                                     *)
(* ---------------------------------------------------------------------- *)
Inv ==
    /\ cnt <= OccurrencesBefore(cand, i)
    /\ 2 * (OccurrencesBefore(cand, i) - cnt) <= i - 1 - cnt
    /\ \A v \in Value \ {cand} :
          2 * OccurrencesBefore(v, i) <= i - 1 - cnt

Correct ==
    \A v \in Value : 2 * OccurrencesBefore(v, Len(seq)) <= Len(seq)

(* ---------------------------------------------------------------------- *)
(*  Initialization and next-state relation (unchanged)                    *)
(* ---------------------------------------------------------------------- *)
Init ==
    /\ seq = <<>>
    /\ i = 1
    /\ cand \in Value
    /\ cnt = 0

Next ==
    \/ /\ i <= Len(seq)
       /\ cand' = seq[i]
       /\ cnt' = 1
       /\ i' = i + 1
       /\ UNCHANGED <<seq, cand, cnt>>
    \/ /\ i <= Len(seq)
       /\ cand' = cand
       /\ cnt' = cnt + 1
       /\ i' = i + 1
       /\ UNCHANGED <<seq, cand>>
    \/ /\ i <= Len(seq)
       /\ cand' = cand
       /\ cnt' = cnt - 1
       /\ i' = i + 1
       /\ UNCHANGED <<seq, cand>>

vars == <<seq, i, cand, cnt>>

Spec == Init /\ [][Next]_vars

(* ---------------------------------------------------------------------- *)
(*  Lemmas needed for the proof                                            *)
(* ----------------------------------------------------------------------)
LEMMA PositionsOne ==
    \A v : PositionsBefore(v, 1) = {}

LEMMA PositionsType ==
    \A v, j : PositionsBefore(v, j) \in SUBSET (1 .. j-1)

LEMMA PositionsFinite ==
    ASSUME NEW v, NEW j \in Int
    PROVE  IsFiniteSet(PositionsBefore(v, j))
    BY PositionsType, FS_Interval, FS_Subset, Zenon

LEMMA PositionsPlusOne ==
    ASSUME TypeOK, NEW j \in 1 .. Len(seq), NEW v
    PROVE  PositionsBefore(v, j+1) =
           IF seq[j] = v THEN PositionsBefore(v, j) \cup {j}
           ELSE PositionsBefore(v, j)
    BY DEF PositionsBefore, Zenon

(* The original lemma claimed the opposite; we now state the intended *)
(* property that the occurrence count is a natural number.               *)
LEMMA OccurrencesNat ==
    \A v, j \in Nat : OccurrencesBefore(v, j) \in Nat
    BY DEF OccurrencesBefore, PositionsFinite, FS_CardinalityNat

LEMMA OccurrencesOne ==
    \A v : OccurrencesBefore(v, 1) = 0
    BY PositionsOne, DEF OccurrencesBefore

LEMMA OccurrencesPlusOne ==
    ASSUME TypeOK, NEW j \in 1 .. Len(seq), NEW v
    PROVE  OccurrencesBefore(v, j+1) =
           IF seq[j] = v THEN OccurrencesBefore(v, j) + 1
           ELSE OccurrencesBefore(v, j)
    BY DEF OccurrencesBefore, PositionsPlusOne

(* ---------------------------------------------------------------------- *)
(*  Main correctness theorem (unchanged)                                  *)
(* ---------------------------------------------------------------------- *)
THEOREM Correctness == Spec => []Correct
<1>1. Init => Inv
    BY OccurrencesOne, DEF Init, Inv
<1>2. TypeOK /\ Inv /\ [Next]_vars => Inv'
    <2>. SUFFICES ASSUME TypeOK, Inv, Next PROVE Inv'
          BY DEF Inv, vars, OccurrencesBefore, PositionsBefore
    <2>. i <= Len(seq) /\ i' = i + 1 /\ seq' = seq
          BY DEF Next
    <2>0. \A v \in Value : OccurrencesBefore(v, i)' = OccurrencesBefore(v, i')
          BY DEF OccurrencesBefore, PositionsBefore
    <2>. USE OccurrencesNat DEF TypeOK
    <2>1. CASE cnt = 0 /\ cand' = seq[i] /\ cnt' = 1
          <3>1. i \in PositionsBefore(seq[i], i+1)
                BY DEF PositionsBefore
          <3>2. 1 <= OccurrencesBefore(seq[i], i+1)
                BY <3>1, PositionsFinite, FS_EmptySet DEF OccurrencesBefore
          <3>3. 2 * (OccurrencesBefore(seq[i], i+1) - 1) <= (i+1) - 1 - 1
                BY <2>1, OccurrencesPlusOne DEF Inv
          <3>4. ASSUME NEW v \in Value \ {seq[i]}
                PROVE 2 * OccurrencesBefore(v, i+1) <= (i+1) - 1 - 1
                BY <2>1, OccurrencesPlusOne DEF Inv
          <3>. QED BY <2>0, <3>2, <3>3, <3>4 DEF Inv
    <2>2. CASE cnt # 0 /\ cand = seq[i] /\ cand' = cand /\ cnt' = cnt + 1
          BY <2>0, <2>2, OccurrencesPlusOne DEF Inv
    <2>3. CASE cnt # 0 /\ cand # seq[i] /\ cand' = cand /\ cnt' = cnt - 1
          <3>10. cnt' <= OccurrencesBefore(cand', i')
                BY <2>3, OccurrencesPlusOne DEF Inv
          <3>20. 2 * (OccurrencesBefore(cand', i') - cnt') <= i' - 1 - cnt'
                BY <2>3, OccurrencesPlusOne DEF Inv
          <3>30. ASSUME NEW v \in Value \ {cand'}
                PROVE 2 * OccurrencesBefore(v, i') <= i' - 1 - cnt'
                BY <2>3, OccurrencesPlusOne DEF Inv
          <3>. QED BY <2>0, <2>3, <3>10, <3>20, <3>30 DEF Inv
    <2>. QED BY <2>1, <2>2, <2>3 DEF Next
<1>3. TypeOK /\ Inv => Correct
    BY OccurrencesNat DEF TypeOK, Inv, Correct, OccurrencesBefore
<1>. QED BY <1>1, <1>2, <1>3, PTL DEF Spec

==============================================================================