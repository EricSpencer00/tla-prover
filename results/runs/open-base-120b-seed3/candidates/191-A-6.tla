---- MODULE Hanoi ----
EXTENDS Naturals, FiniteSets

CONSTANTS D, N

\* ----------------------------------------------------------------------
\* Derived constants
\* ----------------------------------------------------------------------
MaxVal == 2 ^ D - 1

DiskSet == { 2 ^ k : k \in 0..(D-1) }

\* ----------------------------------------------------------------------
\* State variable
\* ----------------------------------------------------------------------
VARIABLE towers

\* ----------------------------------------------------------------------
\* Helper predicates for bitwise reasoning using arithmetic
\* ----------------------------------------------------------------------
IsPresent(t, d) == (t % (2 * d)) >= d

IsSmallest(t, d) ==
    /\ IsPresent(t, d)
    /\ \A e \in DiskSet : e < d => ~IsPresent(t, e)

DestinationOk(t, d) ==
    \A e \in DiskSet : e < d => ~IsPresent(t, e)

\* ----------------------------------------------------------------------
\* Initial state
\* ----------------------------------------------------------------------
Init ==
    towers = [i \in 1..N |-> IF i = 1 THEN MaxVal ELSE 0]

\* ----------------------------------------------------------------------
\* Move action
\* ----------------------------------------------------------------------
Move ==
    \E d \in DiskSet:
      \E s \in 1..N:
        \E t \in 1..N:
          /\ s # t
          /\ IsSmallest(towers[s], d)
          /\ DestinationOk(towers[t], d)
          /\ towers' = [towers EXCEPT ![s] = towers[s] - d,
                                 ![t] = towers[t] + d]

Next == Move

\* ----------------------------------------------------------------------
\* Specification
\* ----------------------------------------------------------------------
Spec == Init /\ [][Next]_towers

\* ----------------------------------------------------------------------
\* Invariants
\* ----------------------------------------------------------------------
TypeOK ==
    /\ towers \in [1..N -> Nat]
    /\ \A i \in 1..N: towers[i] < 2 ^ D

Inv ==
    Sum(i \in 1..N: towers[i]) = MaxVal

=============================================================================