---- MODULE GameOfLife ----
EXTENDS Integers, FiniteSets

CONSTANT N

VARIABLES Grid

(*---------------------------------------------------------------*)
(*   Domain of positions                                          *)
(*---------------------------------------------------------------*)
Pos == 1..N \X 1..N

(*---------------------------------------------------------------*)
(*   Neighbor relation (8‑neighborhood, respecting boundaries)   *)
(*---------------------------------------------------------------*)
Neighbor(p) == { q \in Pos :
                  (Abs(q[1] - p[1]) <= 1) /\ (Abs(q[2] - p[2]) <= 1) /\ (q # p) }

(*---------------------------------------------------------------*)
(*   Number of live neighbours of a position                     *)
(*---------------------------------------------------------------*)
LiveNeighbors(grid, p) == Cardinality({ q \in Neighbor(p) : grid[q] })

(*---------------------------------------------------------------*)
(*   Update rule for a single cell                               *)
(*---------------------------------------------------------------*)
Update(grid, p) ==
    (grid[p] /\ (LiveNeighbors(grid, p) = 2 \/ LiveNeighbors(grid, p) = 3))
    \/ (~grid[p] /\ LiveNeighbors(grid, p) = 3)

(*---------------------------------------------------------------*)
(*   Initialization: any configuration is possible               *)
(*---------------------------------------------------------------*)
Init == /\ Grid \in [Pos -> BOOLEAN]

(*---------------------------------------------------------------*)
(*   Simultaneous step (deterministic)                           *)
(*---------------------------------------------------------------*)
Next == /\ Grid' = [p \in Pos |-> Update(Grid, p)]

(*---------------------------------------------------------------*)
(*   Specification                                               *)
(*---------------------------------------------------------------*)
Spec == Init /\ [][Next]_<<Grid>>

(*---------------------------------------------------------------*)
(*   Type invariant                                              *)
(*---------------------------------------------------------------*)
TypeOK == Grid \in [Pos -> BOOLEAN]

====