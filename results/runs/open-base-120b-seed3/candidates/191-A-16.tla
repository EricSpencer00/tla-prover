---- MODULE Hanoi ----
EXTENDS Naturals, Integers, Bitwise

CONSTANTS D, N

\*--------------------------------------------------------------------
\* Helper definitions
\*--------------------------------------------------------------------
MaxVal == 2 ^ D - 1

Disk(i) == 2 ^ i

DiskSet == { Disk(i) : i \in 0 .. D-1 }

\*--------------------------------------------------------------------
\* State variable
\*--------------------------------------------------------------------
VARIABLES towers

\*--------------------------------------------------------------------
\* Initialization
\*--------------------------------------------------------------------
Init ==
    towers = [i \in 1 .. N |-> IF i = 1 THEN MaxVal ELSE 0]

\*--------------------------------------------------------------------
\* Move predicate
\*--------------------------------------------------------------------
IsOn(t, d) == BAnd(t, d) = d

IsSmallest(t, d) == BAnd(t, d - 1) = 0

CanPlace(t, d) == (t = 0) \/ (BAnd(t, d - 1) = 0)

MoveAction ==
    \E d \in DiskSet :
        \E src \in 1 .. N :
            \E dst \in 1 .. N :
                /\ src # dst
                /\ IsOn(towers[src], d)
                /\ IsSmallest(towers[src], d)
                /\ CanPlace(towers[dst], d)
                /\ towers' = [towers EXCEPT
                                 ![src] = towers[src] - d,
                                 ![dst] = towers[dst] + d]

\*--------------------------------------------------------------------
\* Next-state relation
\*--------------------------------------------------------------------
Next ==
    \/ MoveAction
    \/ UNCHANGED towers

\*--------------------------------------------------------------------
\* Specification
\*--------------------------------------------------------------------
Spec == Init /\ [][Next]_<<towers>>

\*--------------------------------------------------------------------
\* Invariants
\*--------------------------------------------------------------------
TypeOK ==
    /\ \A i \in 1 .. N : towers[i] \in 0 .. MaxVal

Inv ==
    /\ TypeOK
    /\ Sum(i \in 1 .. N, towers[i]) = MaxVal

====