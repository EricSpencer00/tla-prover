---- MODULE GameOfLife ----
EXTENDS Naturals, FiniteSets, TLC

CONSTANT N

VARIABLES grid

(* ------------------------------------------------------------------------ *)
(* Domain definitions                                                       *)
(* ------------------------------------------------------------------------ *)

Pos == 1..N
Cell == Pos \X Pos

(* ------------------------------------------------------------------------ *)
(* Neighbor relation                                                       *)
(* ------------------------------------------------------------------------ *)

IsNeighbor(p, q) ==
  LET rp == p[1], cp == p[2],
      rq == q[1], cq == q[2] IN
    (p # q) /\ (Abs(rp - rq) <= 1) /\ (Abs(cp - cq) <= 1)

Neighbors(p) == { q \in Cell : IsNeighbor(p, q) }

LiveNeighborCount(p) == Cardinality({ q \in Neighbors(p) : grid[q] })

(* ------------------------------------------------------------------------ *)
(* Initialization                                                          *)
(* ------------------------------------------------------------------------ *)

Init == grid \in [Cell -> BOOLEAN]

(* ------------------------------------------------------------------------ *)
(* Transition (simultaneous update)                                         *)
(* ------------------------------------------------------------------------ *)

Next ==
  grid' = [p \in Cell |-> 
            IF grid[p] 
               THEN (LiveNeighborCount(p) = 2) \/ (LiveNeighborCount(p) = 3)
               ELSE LiveNeighborCount(p) = 3
          ]

(* ------------------------------------------------------------------------ *)
(* Specification                                                            *)
(* ------------------------------------------------------------------------ *)

Spec == Init /\ [] [Next]_grid

(* ------------------------------------------------------------------------ *)
(* Type invariant                                                           *)
(* ------------------------------------------------------------------------ *)

TypeOK == grid \in [Cell -> BOOLEAN]

====