\* This file is automatically generated.  Do not edit manually.
\* 
\* The base reachability algorithm is assumed to be defined in the module
\* MisraReachability, which must be available in the same directory or in the
\* search path of the TLA+ tools.

EXTENDS Naturals, Sequences, TLC, MisraReachability

CONSTANTS
    Nodes,
    Root,
    Succ,
    Seq

ASSUME
    /\ Nodes = {1, 2, 3, 4}
    /\ Root \in Nodes
    /\ Succ \in [Nodes -> SUBSET Nodes]
    /\ \A n \in Nodes : Succ[n] = { ((n % 4) + 1), (((n + 1) % 4) + 1) }
    /\ Seq = {s \in [1.. Cardinality(Nodes) -> Nodes]}

VARIABLES
    marked,
    frontier,
    pc

vars == {"marked", "frontier", "pc"}

\* -------------------------------------------------------------
\* Helper predicate: a node is reachable from Root if there exists a
\* path of length at most |Nodes| using the Succ relation.
\* -------------------------------------------------------------
ReachPath(n) == \E p \in Seq :
    /\ p[1] = Root
    /\ p[Len(p)] = n
    /\ \A i \in 1..Len(p)-1 : p[i+1] \in Succ[p[i]]

\* -------------------------------------------------------------
\* Initialization
\* -------------------------------------------------------------
Init == /\ marked = {}
        /\ frontier = {n \in Succ[Root] : n \in Nodes}
        /\ pc = "Init"

\* -------------------------------------------------------------
\* Next step (delegated to the underlying algorithm)
\* -------------------------------------------------------------
Next == MisraReachability.Next

\* -------------------------------------------------------------
\* Specification
\* -------------------------------------------------------------
Spec == Init /\ [][Next]_vars

\* -------------------------------------------------------------
\* Type correctness invariant
\* -------------------------------------------------------------
TypeOK == /\ marked \subseteq Nodes
          /\ frontier \subseteq Nodes
          /\ pc \in {"Init", "Mark", "Done"}

\* -------------------------------------------------------------
\* Successor closure: every frontier node is a successor of some marked node
\* -------------------------------------------------------------
Inv1 == \A n \in frontier : \E m \in marked : n \in Succ[m]

\* -------------------------------------------------------------
\* Reachability decomposition: every marked node is reachable from Root
\* -------------------------------------------------------------
Inv2 == \A n \in marked : ReachPath(n)

\* -------------------------------------------------------------
\* Frontier and marked are disjoint
\* -------------------------------------------------------------
Inv3 == frontier \cap marked = {}

\* -------------------------------------------------------------
\* Partial correctness: the union of marked and frontier equals the set
\* of nodes reachable from Root
\* -------------------------------------------------------------
PartialCorrectness ==
    frontier \cup marked = { n \in Nodes : ReachPath(n) }

\* -------------------------------------------------------------
\* Termination property: eventually the algorithm reaches the Done state
\* -------------------------------------------------------------
Termination == <> (pc = "Done")

