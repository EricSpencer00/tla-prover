        "raw_reply": "VARIABLES banks, lock, last, crashed\n\nCONSTANTS NumBanks\n\nvars == <<NumBanks, lock, last, crashed>>\n\nInit == /\\ lock = \"none\"\n       /\\ last = \"none\"\n       /\\ crashed = [ <<1..NumBanks>> |-> \"none\" ]\n       /\\ banks = [ <<1..NumBANKS>> |-> \"idle\" ]\n\nNext == \\/ lock' = IF banks' = banks /\\ crashed' = crashed\n                 THEN IF banks' = [ <<1..NumBANks>> |-> \"idle\" ]\n                          THEN \"none\"\n                          ELSE \"none\"\n                 ELSE \"none\"\n            \\/ lock' = \"none\"\n            \\/ last' = \"none\"\n            \\/ crashed' = [ <<1..Numbanks>> |-> \"none\" ]\n            \\/ banks' = [ <<1..numbanks>> |-> \"idle\" ]\n            \\/ \\A i \\in 1..NumBanks : banks' = [ <<1..i>> |-> \"idle\" ]\n                 => banks' = [ <<1..(i-1)>, <i>, (i+1)..NumBanks>> |-> \"idle\" ]\n                      /\\ banks' = [ <<1..((i-1)), i, (i+1)..NumBANKS>> |-> IF crashed' = \"none\" THEN \"idle\" ELSE crashed' END ]\n                      /\\ banks' = [ 1..(i-1) |-> \"idle\" ] /\\ [ i |-> \"posting\" ] /\\ [ (i+1)..NumBANks |-> \"idle\" ]\n                      \\/ banks' = [ 1..((i-1)), (i+1)..NumBAnks |-> \"idle\" ] /\\ crashed' = \"none\"\n                      /\\ banks' = [  <<1..(i-1)>> |-> \"idle\" ] /\\ banks' = [ <<(i+1)..NumBanks >> |-> \"idle\" ]\n                      => banks' = [  <<1>(i-1)>, <i+1>..",
