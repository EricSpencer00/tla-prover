---- MODULE Util ----
EXTENDS Naturals, FiniteSets, Sequences, Integers
CONSTANTS V

VARIABLES
    a0, a1, a2, a3, a4, a5, a6, a7, a8, a9

vars == {a0, a1, a2, a3, a4, a5, a6, a7, a8, a9}

None == "none"
Gap == -1

\* seqF operates on a sequence, setF on a set, both as tail-recursive folds.
\* Ordinals are used for indexes rather than Nat, because Nat's 0 start is not
\* the same as Sequence's 1 start.

SeqFold(f, s, a) == IF s = <<>> THEN a
                    ELSE SeqFold(f, Tail(s), f(Head(s), a))

SetFold(f, S, a) == IF S = {} THEN a
                   ELSE SetFold(f, S \ {CHOOSE e \in S : TRUE}, f(CHOOSE e \in S : TRUE, a))

Range(n) == {i \in Nat : i < n}

\* Permutations are generated by inserting the next element into every position
\* of every partial permutation of the previous elements (incremental insertion
\* rather than generation of all permutations at once).
Permutations(n) ==
  LET insAt(k, s) == SubSeq(s, 1, k) \o <<n>> \o SubSeq(s, k + 1, Len(s))
  IN
  IF n = 0 THEN (<<>>)
  ELSE LET sub == Permutations(n - 1) IN { insAt(k, s) : s \in sub, k \in Range(n) }

\* Tests whether any element of S lies in T (overlap of two sets).
Overlap(S, T) == \E x \in S : x \in T

\* Returns the (empty) set of elements that appear in every member of S.
AllIntersect(S) == {x \in V : \A s \in S : x \in s}

\* Generalized sequence indexing: kth index is k+1 in a Sequence (Ordinal k).
SeqIndex(s, k) == IF k \in Range(Len(s)) THEN s[k + 1] ELSE None

\* Elements of a sequence turned into a set; uses SetFold on the domain indices.
SeqToSet(s) == SetFold( (i, a) |-> a \cup {s[i + 1]}, Range(Len(s)), {})

Rewind(s, x) == {k \in Range(Len(s)) : SeqIndex(s, k) = x}

\* Removes all occurrences of x from s by folding over it.
SeqStrip(s, x) == SeqFold((y, a) |-> IF y = x THEN a ELSE Append(a, y), s, <<>>)

Strip(s, x) == SeqStrip(s, x)

\* A test helper that runs a test and prints its result on the console on
\* failure, so the assertion in a .cfg is never a silent no-op.
\* The <<x>> argument to print must be a sequence, so every test that uses it
\* must pass at least an empty sequence.
Test(f, d, x) == LET res == f(d) IN IF res THEN TRUE
                 ELSE (Print(x), Print(res), FALSE)

TypeOK ==
  /\ a0 \in BOOLEAN
  /\ a1 \in BOOLEAN
  /\ a2 \in BOOLEAN
  /\ a3 \in BOOLEAN
  /\ a4 \in BOOLEAN
  /\ a5 \in BOOLEAN
  /\ a6 \in BOOLEAN
  /\ a7 \in BOOLEAN
  /\ a8 \in BOOLEAN
  /\ a9 \in BOOLEAN

Init ==
  /\ a0 = TRUE
  /\ a1 = FALSE
  /\ a2 = TRUE
  /\ a3 = FALSE
  /\ a4 = FALSE
  /\ a5 = FALSE
  /\ a6 = FALSE
  /\ a7 = FALSE
  /\ a8 = FALSE
  /\ a9 = FALSE

Next ==
  \/ /\ a0 = TRUE  /\ a0' = FALSE
     /\ UNCHANGED <<a1, a2, a3, a4, a5, a6, a7, a8, a9>>
  \/ /\ a1 = FALSE /\ a1' = TRUE
     /\ UNCHANGED <<a0, a2, a3, a4, a5, a6, a7, a8, a9>>
  \/ /\ a2 = TRUE  /\ a2' = FALSE
     /\ UNCHANGED <<a0, a1, a3, a4, a5, a6, a7, a8, a9>>
  \/ /\ a3 = FALSE /\ a3' = TRUE
     /\ UNCHANGED <<a0, a1, a2, a4, a5, a6, a7, a8, a9>>
  \/ /\ a4 = FALSE /\ a4' = TRUE
     /\ UNCHANGED <<a0, a1, a2, a3, a5, a6, a7, a8, a9>>
  \/ /\ a5 = FALSE /\ a5' = TRUE
     /\ UNCHANGED <<a0, a1, a2, a3, a4, a6, a7, a8, a9>>
  \/ /\ a6 = FALSE /\ a6' = TRUE
     /\ UNCHANGED <<a0, a1, a2, a3, a4, a5, a7, a8, a9>>
  \/ /\ a7 = FALSE /\ a7' = TRUE
     /\ UNCHANGED <<a0, a1, a2, a3, a4, a5, a6, a8, a9>>
  \/ /\ a8 = FALSE /\ a8' = TRUE
     /\ UNCHANGED <<a0, a1, a2, a3, a4, a5, a6, a7, a9>>
  \/ /\ a9 = FALSE /\ a9' = TRUE
     /\ UNCHANGED <<a0, a1, a2, a3, a4, a5, a6, a7, a8>>

Spec == Init /\ [][Next]_vars

NextSlice ==
  /\ a0 = FALSE
  /\ a1 = FALSE
  /\ a2 = FALSE
  /\ a3 = FALSE
  /\ a4 = FALSE
  /\ a5 = TRUE
  /\ a6 = TRUE
  /\ a7 = FALSE
  /\ a8 = FALSE
  /\ a9 = FALSE

SectionA ==
  /\ a0 = TRUE
  /\ a1 = FALSE
  /\ a2 = TRUE
  /\ a3 = FALSE
  /\ a4 = FALSE
  /\ a5 = FALSE
  /\ a6 = FALSE
  /\ a7 = FALSE
  /\ a8 = FALSE
  /\ a9 = FALSE

SectionB ==
  /\ a0 = FALSE
  /\ a1 = TRUE
  /\ a2 = FALSE
  /\ a3 = TRUE
  /\ a4 = FALSE
  /\ a5 = FALSE
  /\ a6 = FALSE
  /\ a7 = FALSE
  /\ a8 = FALSE
  /\ a9 = FALSE

\* Since the test section is a deadlock (no Next enabled after the slice), the
\* real system's ordinary runs must all stay out of it.
NoDeadlock == SectionA ~> SectionB
Fairness == WF_vars(NoDeadlock)

