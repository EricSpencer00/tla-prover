---- MODULE ReachableProofs
(***************************************************************************)
(* This module contains the TLAPS checked proofs of partial correctness of *)
(* the algorithm in module Reachable.  The proof is broken down into three  *)
(* steps, each proved using a hierarchical proof.  The algorithm works by    *)
(* building up a reachable set held in `marked` and a frontier held in      *)
(* `vroot`, starting from the single root node, and is finished when the     *)
(* frontier is empty.  The first step, Thm1, proves that the set `marked` is  *)
(* always closed under successors, which is the algorithm's progress         *)
(* invariant and is also what lets us infer that `marked` is the final reachable *)
(* set once the frontier is empty.  The next two steps prove three separate  *)
(* invariants of the algorithm, and each uses the invariance of one or more   *)
(* of the invariants proved earlier.  The final step proves partial           *)
(* correctness: when the frontier is empty (`pc = "Done"`), `marked` equals   *)
(* the reachable set of the graph.                                          *)
(*                                                                         *)
(* This module also shows a stylistic alternative to the standard           *)
(* hierarchical proof: the level <1> proofs (the proofs of the steps of a    *)
(* level <0> proof) are written with a BY proof, while the level <2> and     *)
(* level <3> proofs (the proofs of the steps of a level <1> proof) are       *)
(* written with the `SUFFICES ASSUME ... PROVE ...` abbreviation.  The      *)
(* result is a proof that is both short to write and short to read.         *)
(*                                                                         *)
(* The alternative to this module is a version that proves the invariance   *)
(* of a single combined invariant (`Inv23 == Reachable = ReachableFrom(    *)
(* marked \cup vroot)`) instead of the three separate invariants `Inv1`,      *)
(* `Inv2`, and `Inv3`.  The three-invariant version is easier to understand  *)
(* because each invariant stands on its own and needs no special reasoning  *)
(* at all to prove it is invariant; the single-invariant version needs a     *)
(* nontrivial reachability result that is completely unrelated to the         *)
(* algorithm.                                                               *)
(***************************************************************************)
EXTENDS Reachable, ReachabilityProofs, TLAPS

(***************************************************************************)
(* No step of the proof proves the invariance of `TypeOK` directly: each   *)
(* step assumes `TypeOK` because it is included in the conjunction of       *)
(* invariants proved so far, and the invariance of `TypeOK` follows from the *)
(* invariance of `Inv1` (the step that proves it does exactly that).        *)
(***************************************************************************)

THEOREM Thm1 == Spec => []Inv1
  (***********************************************************************)
  (* The three steps of this level <1> proof (Init => Inv1, the           *)
  (* invariance step, and the QED step) are the standard way of proving    *)
  (* []Inv1.  Step <2>2 is the only one TLAPS couldn't prove with a BY    *)
  (* proof.                                                               *)
  (***********************************************************************)
  <1>1. Init => Inv1
    BY RootAssump DEF Init, Inv1, TypeOK
  <1>2. Inv1 /\ [Next]_vars => Inv1'
    (*******************************************************************)
    (* The steps of this level <2> proof are the standard way of proving *)
    (* the formula <1>2.  They were generated by the Toolbox's Decompose *)
    (* Proof Command.  The algorithm is simple enough that TLAPS can      *)
    (* prove steps <2>1 and <2>2, which are the only nontrivial ones,     *)
    (* with BY proofs.                                                   *)
    (*******************************************************************)
    <2> SUFFICES ASSUME Inv1,
                        [Next]_vars
                 PROVE  Inv1'
      OBVIOUS
    <2>1. CASE a
        BY <2>1, SuccAssump DEF Inv1, TypeOK, a
    <2>2. CASE UNCHANGED vars
      BY <2>2 DEF Inv1, TypeOK, vars
    <2>3. QED
      BY <2>1, <2>2 DEF Next, Terminating
  <1>3. QED
    BY <1>1, <1>2, PTL DEF Spec

THEOREM Thm2 == Spec => []Inv2
  (***********************************************************************)
  (* This theorem is a trivial consequence of a general fact about         *)
  (* reachability in a directed graph, which is called Reachable1 and      *)
  (* proved in Module ReachabilityProofs                                  *)
  (***********************************************************************)
  <1>1. Inv1 => Inv2
    BY Reachable1 DEF Inv1, Inv2
  <1> QED
    BY <1>1, Thm1, PTL

THEOREM Thm3 == Spec => []Inv3
  (***********************************************************************)
  (* The invariance of Inv3 depends on everything proved so far: the      *)
  (* invariance of TypeOK and of Inv2, plus the invariance of Inv3 itself  *)
  (* and the fact that the three variables change together in the one step *) 
  (* that changes them.                                                   *)
  (***********************************************************************)
  <1>1. Init => Inv3  
    BY RootAssump DEF Init, Inv3, TypeOK, Reachable 
  <1>2. TypeOK /\ TypeOK' /\ Inv2 /\ Inv2' /\ Inv3 /\ [Next]_vars => Inv3'
    (*******************************************************************)
    (* The SUFFICES step and its proof, the QED step and its proof, and  *)
    (* the CASE steps <2>2 and <2>3 were generated by the Toolbox's       *)
    (* Decompose Proof command.                                         *)
    (*******************************************************************)
    <2> SUFFICES ASSUME TypeOK,
                        TypeOK',
                        Inv2,
                        Inv2',
                        Inv3,
                        [Next]_vars
                 PROVE  Inv3'
      OBVIOUS
    (*******************************************************************)
    (* `a' is a simple enough formula that this step does not need to    *)
    (* hide its definition when it is not needed.                        *)
    (*******************************************************************)
    <2>1. /\ Reachable' = Reachable
          /\ ReachableFrom(vroot)' = ReachableFrom(vroot')
          /\ ReachableFrom(marked \cup vroot)' = ReachableFrom(marked' \cup vroot')
      OBVIOUS 
    <2>2. CASE a
      <3> USE <2>2 DEF a
      <3>1. CASE vroot = {}
        BY <2>1, <3>1 DEF Inv3, TypeOK
      <3>2. CASE vroot # {}
        (*****************************************************************)
        (* To use a fact of the form \E x \in S : P(x) you pick a fitting  *)
        (* x in S.  To use a fact of the form IF P THEN Q1 ELSE Q2 you     *)
        (* split into the two cases P and ~P.  The proof written here is   *)
        (* the straightforward way of applying both of those, and it is  *)
        (* exactly the way the Toolbox's case-split and pick commands     *)
        (* write the proof, so the proof is short and easy to read.       *)
        (*****************************************************************)
        <4>1. PICK v \in vroot :
                IF v \notin marked
                   THEN /\ marked' = (marked \cup {v})
                        /\ vroot' = vroot \cup Succ[v]
                   ELSE /\ vroot' = vroot \ {v}
                        /\ UNCHANGED marked
          BY <3>2
        <4>2. CASE v \notin marked
          (*****************************************************************)
          (* This case follows immediately from a general reachability      *)
          (* result proved in module ReachabilityProofs:                    *)
          (*   Reachable2 == \A S \in SUBSET Nodes :                         *)
          (*                  (\A n \in S : Succ[n] \subseteq S) =>          *)
          (*                  (S = reachableFrom(S \cup Succ[n])))          *)
          (* The result says adding a fresh node and its successors to a    *)
          (* closed set can never make the set larger, which is exactly the *)
          (* situation here.                                               *)
          (*****************************************************************)
          <5>1. /\ ReachableFrom(vroot') = ReachableFrom(vroot)
                /\ v \notin ReachableFrom(vroot)
            BY <4>1, <4>2, Reachable2 DEF TypeOK 
          <5>2. QED
            BY <5>1, <4>1, <4>2, <5>1, <2>1 DEF Inv3
        <4>3. CASE v \in marked
          (*****************************************************************)
          (* This case is completely routine: the frontier does not change  *)
          (* when the node it is working from is already in the reachable *)
          (* set.                                                          *)
          (*****************************************************************)
          <5>1. marked' \cup vroot' = marked \cup vroot
            BY <4>1, <4>3
          <5>2. QED
            BY <5>1, <2>1 DEF Inv2, Inv3
        <4>4. QED
          BY <4>2, <4>3
        <3>3. QED
          BY <3>1, <3>2   
    <2>3. CASE UNCHANGED vars
      BY <2>1, <2>3 DEF Inv3, TypeOK, vars  
    <2>4. QED
      BY <2>2, <2>3 DEF Next, Terminating
  <1>3. QED
    BY <1>1, <1>2, Thm2, PTL DEF Spec

THEOREM Spec => []((pc = "Done") => (marked = Reachable))
  (***********************************************************************)
  (* Partial correctness: once the frontier is empty, the reachable set    *)
  (* is reached, so the algorithm terminates exactly when the reachable    *)
  (* set is reached.  The only property of Reachable needed here is that   *)
  (* Reachable({}) = {}.                                                  *)
  (***********************************************************************)
  <1>1. Inv1 => ((pc = "Done") => (vroot = {}))
    BY DEF Inv1, TypeOK
  <1>2. Inv3 /\ (vroot = {}) => (marked = Reachable)
    BY Reachable3 DEF Inv3
  <1>3. QED
    BY <1>1, <1>2, Thm1, Thm3, PTL

=============================================================================