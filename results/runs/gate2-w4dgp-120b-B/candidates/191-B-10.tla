---- MODULE Hanoi ----------------------------------------------------------------
EXTENDS Naturals, Bits, FiniteSets, TLC

(***************************************************************************)
(* TRUE iff i is a power of two                                            *)
(***************************************************************************)
PowerOfTwo(i) == i & (i - 1) = 0

(***************************************************************************)
(* A set of all powers of two up to n                                      *)
(***************************************************************************)
SetOfPowerOfTwo(n) == {x \in 1..(2 ^ n - 1): PowerOfTwo(x)}

(***************************************************************************)
(* Copied from TLA+'s Bags standard library. The sum of f[x] for all x in    *)
(* DOMAIN f.                                                               *)
(***************************************************************************)
Sum(f) == LET DSum[S \in SUBSET DOMAIN f] ==
              LET elt == CHOOSE e \in S : TRUE
              IN  IF S = {} THEN 0
                    ELSE f[elt] + DSum[S \ {elt}]
          IN  DSum[DOMAIN f]

(***************************************************************************)
(* D is number of disks and N number of towers                             *)
(***************************************************************************)
CONSTANTS D, N

(***************************************************************************)
(* Towers of Hanoi with N towers                                           *)
(***************************************************************************)
VARIABLES towers
vars == <<towers>>

(***************************************************************************)
(* Towers are naturals in the interval (0, 2^D]                             *)
(***************************************************************************)
TypeOK == \A i \in DOMAIN towers : towers[i] \in Nat /\ towers[i] < 2 ^ D

(***************************************************************************)
(* The total sum of all towers must amount to the disks in the system      *)
(***************************************************************************)
Inv == Sum(towers) = 2 ^ D - 1

(***************************************************************************)
(* Initial: all disks on the first tower                                    *)
(***************************************************************************)
Init == towers = [i \in 1..N |-> IF i = 1 THEN 2 ^ D - 1 ELSE 0]

(***************************************************************************)
(* TRUE iff the tower is empty                                             *)
(***************************************************************************)
IsEmpty(i) == i = 0

(***************************************************************************)
(* TRUE iff the disk is the smallest disk on tower                         *)
(***************************************************************************)
IsSmallest(t, d) == /\ ~IsEmpty(t)
                    /\ t & (d - 1) = 0

(***************************************************************************)
(* TRUE iff the disk can be moved off of tower                             *)
(***************************************************************************)
CanMoveOff(t, d) == ~IsEmpty(t) /\ IsSmallest(t, d)

(***************************************************************************)
(* TRUE iff the disk can be moved to the tower                             *)
(***************************************************************************)
CanMoveTo(t, d) == ~IsEmpty(t) => IsSmallest(t, d)

(***************************************************************************)
(* Move a disk from one tower to another                                   *)
(***************************************************************************)
Move(i, j, d) == /\ CanMoveOff(towers[i], d)
                 /\ CanMoveTo(towers[j], d)
                 /\ towers' = [towers EXCEPT ![i] = towers[i] - d, ![j] = towers[j] + d]

(***************************************************************************)
(* Any possible move of any disk between any two distinct towers           *)
(***************************************************************************)
Next == \E d \in SetOfPowerOfTwo(D) : \E i, j \in DOMAIN towers :
            /\ i # j
            \/ Move(i, j, d)

(***************************************************************************)
(* The system either takes a move or stays put                              *)
(***************************************************************************)
Spec == Init /\ [][Next]_vars

(***************************************************************************)
(* A solution leaves all disks on the right-most tower                     *)
(***************************************************************************)
NotSolved == towers[N] # 2 ^ D - 1

=============================================================================