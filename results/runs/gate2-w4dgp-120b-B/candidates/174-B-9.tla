---- MODULE Slush
(**************************************************************************)
(* A specification of the Slush protocol, a simple probabilistic         *)
(* consensus algorithm in the Avalanche family. It is written as            *)
(* executable TLA⁺ and kept intentionally close to its JavaScript          *)
(* prototype, so the translation is not the most elegant TLA⁺.              *)
(*                                                                        *)
(* The core invariants about the safety of the loop and query processes are*)
(* retained from the original. The failure reported by TLC is that a next  *)
(* state generated by the QuerySampleSet action failed to assign every     *)
(* variable that appears on the left side of the assignment, namely        *)
(* sampleSet, pc, and message. The fix is to give a complete case split so *)
(* the action is total on those variables, and keep the original logic    *)
(* intact.                                                                *)
(**************************************************************************)

EXTENDS Naturals, FiniteSets, Sequences

CONSTANTS
  Node,
  SlushLoopProcess,
  SlushQueryProcess,
  HostMapping,
  SlushIterationCount,
  SampleSetSize,
  PickFlipThreshold

ASSUME
  /\ Cardinality(Node) = Cardinality(SlushLoopProcess)
  /\ Cardinality(Node) = Cardinality(SlushQueryProcess)
  /\ SlushIterationCount \in Nat
  /\ SampleSetSize \in Nat
  /\ PickFlipThreshold \in Nat

ASSUME HostMappingType ==
  /\ Cardinality(Node) = Cardinality(HostMapping)
  /\ \A mapping \in HostMapping :
       /\ Cardinality(mapping) = 3
       /\ \E e \in mapping : e \in Node
       /\ \E e \in mapping : e \in SlushLoopProcess
       /\ \E e \in mapping : e \in SlushQueryProcess

HostOf[pid \in (SlushLoopProcess \cup SlushQueryProcess)] ==
  CHOOSE n \in Node :
   /\ \E mapping \in HostMapping : /\ n \in mapping /\ pid \in mapping

(*--algorithm Slush
variables pick = [node \in Node |-> NoColor];
          message = {};
process SlushQuery \in SlushQueryProcess
process SlushLoop \in SlushLoopProcess
process ClientRequest = "ClientRequest"
end algorithm;*)
\* BEGIN TRANSLATION
VARIABLES pick, message, pc

(*--algorithm define *)
Red == "Red"
Blue == "Blue"
Color == {Red, Blue}
NoColor == CHOOSE c \in Color : FALSE
QueryMessageType == "QueryMessageType"
QueryReplyMessageType == "QueryReplyMessageType"
TerminationMessageType == "TerminationMessageType"
QueryMessage == [type : {QueryMessageType}, src : SlushLoopProcess,
                 dst : SlushQueryProcess, color : Color]
QueryReplyMessage == [type : {QueryReplyMessageType}, src : SlushQueryProcess,
                      dst : SlushLoopProcess, color : Color]
TerminationMessage == [type : {TerminationMessageType}, pid : SlushLoopProcess]
Message == QueryMessage \cup QueryReplyMessage \cup TerminationMessage
NoMessage == CHOOSE m \in Message : FALSE
TypeInvariant == /\ pick \in [Node -> Color \cup {NoColor}]
                  /\ message \subseteq Message
PendingQueryMessage(pid) == {m \in message : /\ m.type = QueryMessageType /\ m.dst = pid}
PendingQueryReplyMessage(pid) == {m \in message : /\ m.type = QueryReplyMessageType /\ m.dst = pid}
Terminate == message = TerminationMessage
Pick(pid) == pick[HostOf[pid]]
\* END TRANSLATION

VARIABLES sampleSet, loopVariant

vars == << pick, message, pc, sampleSet, loopVariant >>

Init ==
  /\ pick = [node \in Node |-> NoColor]
  /\ message = {}
  /\ sampleSet = [self \in SlushLoopProcess |-> {}]
  /\ loopVariant = [self \in SlushLoopProcess |-> 0]
  /\ pc = [self \in (SlushQueryProcess \cup SlushLoopProcess \cup {"ClientRequest"}) |-> CASE
            self \in SlushQueryProcess -> "QueryReplyLoop"
            [] self \in SlushLoopProcess -> "RequireColorAssignment"
            [] self = "ClientRequest" -> "ClientRequestLoop"]

(* SlushQuery process *)
SlushQuery(self) == IF pc[self] = "QueryReplyLoop"
  THEN IF ~Terminate THEN /\ pc' = [pc EXCEPT ![self] = "WaitForQueryMessageOrTermination"]
                          /\ UNCHANGED << pick, message, sampleSet, loopVariant >>
                       ELSE /\ pc' = [pc EXCEPT ![self] = "Done"]
                          /\ UNCHANGED << pick, message, sampleSet, loopVariant >>
  ELSE IF pc[self] = "WaitForQueryMessageOrTermination"
  THEN IF PendingQueryMessage(self) /= {} \/ Terminate
       THEN IF Terminate
            THEN /\ pc' = [pc EXCEPT ![self] = "QueryReplyLoop"]
                 /\ UNCHANGED << pick, message, sampleSet, loopVariant >>
            ELSE /\ pc' = [pc EXCEPT ![self] = "RespondToQueryMessage"]
                 /\ UNCHANGED << pick, message, sampleSet, loopVariant >>
       ELSE UNCHANGED vars
  ELSE IF pc[self] = "RespondToQueryMessage"
  THEN \/ \E msg \in PendingQueryMessage(self) :
          LET color == IF Pick(self) = NoColor THEN msg.color ELSE Pick(self) IN
            /\ pick' = [pick EXCEPT ![HostOf[self]] = color]
            /\ message' = (message \ {msg}) \cup {[type |-> QueryReplyMessageType,
                                                 src |-> self, dst |-> msg.src, color |-> color]}
            /\ pc' = [pc EXCEPT ![self] = "QueryReplyLoop"]
            /\ UNCHANGED << sampleSet, loopVariant >>
       \/ UNCHANGED vars

(* SlushLoop process *)
SlushLoop(self) == IF pc[self] = "RequireColorAssignment"
  THEN IF Pick(self) # NoColor
       THEN /\ pc' = [pc EXCEPT ![self] = "ExecuteSlushLoop"]
            /\ UNCHANGED << pick, message, sampleSet, loopVariant >>
       ELSE UNCHANGED vars
  ELSE IF pc[self] = "ExecuteSlushLoop"
  THEN IF loopVariant[self] < SlushIterationCount
       THEN /\ pc' = [pc EXCEPT ![self] = "QuerySampleSet"]
            /\ UNCHANGED << pick, message, sampleSet, loopVariant >>
       ELSE /\ pc' = [pc EXCEPT ![self] = "SlushLoopTermination"]
            /\ UNCHANGED << pick, message, sampleSet, loopVariant >>
  ELSE IF pc[self] = "QuerySampleSet"
  THEN \/ \E possibleSampleSet \in LET oN == Node \ {HostOf[self]}
                                   oQ == {pid \in SlushQueryProcess : HostOf[pid] \in oN}
                                 IN {p \in SUBSET oQ : Cardinality(p) = SampleSetSize} :
            /\ sampleSet' = [sampleSet EXCEPT ![self] = possibleSampleSet]
            /\ message' = message \cup {[type |-> QueryMessageType, src |-> self, dst |-> pid,
                                         color |-> Pick(self)] : pid \in possibleSampleSet}
            /\ pc' = [pc EXCEPT ![self] = "TallyQueryReplies"]
            /\ UNCHANGED << pick, loopVariant >>
       \/ UNCHANGED vars
  ELSE IF pc[self] = "TallyQueryReplies"
  THEN /\ \A pid \in sampleSet[self] : \E msg \in PendingQueryReplyMessage(self) : msg.src = pid
       /\ LET redTally == Cardinality({msg \in PendingQueryReplyMessage(self) :
                                      /\ msg.src \in sampleSet[self] /\ msg.color = Red})
              blueTally == Cardinality({msg \in PendingQueryReplyMessage(self) :
                                      /\ msg.src \in sampleSet[self] /\ msg.color = Blue})
            IN pick' = [pick EXCEPT ![HostOf[self]] =
                        IF redTally >= PickFlipThreshold THEN Red
                        ELSE IF blueTally >= PickFlipThreshold THEN Blue
                        ELSE pick[HostOf[self]]]
       /\ message' = message \ {msg \in message :
                                /\ msg.type = QueryReplyMessageType /\ msg.src \in sampleSet[self]
                                /\ msg.dst = self}
       /\ sampleSet' = [sampleSet EXCEPT ![self] = {}]
       /\ loopVariant' = [loopVariant EXCEPT ![self] = loopVariant[self] + 1]
       /\ pc' = [pc EXCEPT ![self] = "ExecuteSlushLoop"]
  ELSE IF pc[self] = "SlushLoopTermination"
  THEN /\ message' = message \cup {[type |-> TerminationMessageType, pid |-> self]}
       /\ pc' = [pc EXCEPT ![self] = "Done"]
       /\ UNCHANGED << pick, sampleSet, loopVariant >>
  ELSE UNCHANGED vars

(* ClientRequest process *)
ClientRequest == IF pc["ClientRequest"] = "ClientRequestLoop"
  THEN IF \E n \in Node : pick[n] = NoColor
       THEN /\ pc' = [pc EXCEPT !["ClientRequest"] = "AssignColorToNode"]
            /\ UNCHANGED << pick, message, sampleSet, loopVariant >>
       ELSE /\ pc' = [pc EXCEPT !["ClientRequest"] = "Done"]
            /\ UNCHANGED << pick, message, sampleSet, loopVariant >>
  ELSE IF pc["ClientRequest"] = "AssignColorToNode"
  THEN \/ \E node \in Node : \E color \in Color :
          /\ IF pick[node] = NoColor THEN pick' = [pick EXCEPT ![node] = color]
             ELSE pick' = pick
          /\ pc' = [pc EXCEPT !["ClientRequest"] = "ClientRequestLoop"]
          /\ UNCHANGED << message, sampleSet, loopVariant >>
       \/ UNCHANGED vars
  ELSE UNCHANGED vars

(* Allow infinite stuttering once every process is done. *)
Terminating == \A self \in (SlushQueryProcess \cup SlushLoopProcess \cup {"ClientRequest"}) :
                 pc[self] = "Done"
Next == SlushLoop(self) \/ SlushQuery(self) \/ ClientRequest \/ (Terminating /\ UNCHANGED vars)
Spec == Init /\ [][Next]_vars
Termination == <>(\A self \in (SlushQueryProcess \cup SlushLoopProcess \cup {"ClientRequest"}) : pc[self] = "Done")
====