---- MODULE DyadicRationals ----
EXTENDS Naturals, Integers

CONSTANTS One, Half, Norm

(* ------------------------------------------------------------------------- *)
(*  State variable                                                          *)
(* ------------------------------------------------------------------------- *)
VARIABLE p

(* ------------------------------------------------------------------------- *)
(*  Helper definitions                                                     *)
(* ------------------------------------------------------------------------- *)
OneDef   == [num |-> 1, den |-> 1]
HalfDef  == [num |-> p.num, den |-> p.den * 2]

(* ------------------------------------------------------------------------- *)
(*  Normalization operator                                                  *)
(* ------------------------------------------------------------------------- *)
Norm(p) ==
  IF p.num % 2 = 0 /\ p.den % 2 = 0
    THEN Norm([num |-> p.num \div 2, den |-> p.den \div 2])
    ELSE p

(* ------------------------------------------------------------------------- *)
(*  Initialization                                                          *)
(* ------------------------------------------------------------------------- *)
Init == p = OneDef

(* ------------------------------------------------------------------------- *)
(*  Actions                                                                 *)
(* ------------------------------------------------------------------------- *)
Halve == p' = HalfDef

Normalize == p' = Norm(p)

Next == \/ Halve
        \/ Normalize

(* ------------------------------------------------------------------------- *)
(*  Specification                                                          *)
(* ------------------------------------------------------------------------- *)
Spec == Init /\ [][Next]_<<p>>

=============================================================================