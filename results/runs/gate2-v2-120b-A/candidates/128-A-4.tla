---- MODULE Quicksort ----
EXTENDS Naturals, Sequences, TLC

\* ----------------------------------------------------------------------
\* Constants (to be instantiated by the .cfg file)
\* ----------------------------------------------------------------------
CONSTANTS Values, MaxSeqLen, Seq

\* ----------------------------------------------------------------------
\* Types
\* ----------------------------------------------------------------------
Idx == 1 .. MaxSeqLen
Interval == [l : Idx, u : Idx]  \* l <= u

\* ----------------------------------------------------------------------
\* State variables
\* ----------------------------------------------------------------------
VARIABLES seq, orig, work, pc

\* ----------------------------------------------------------------------
\* Helper definitions
\* ----------------------------------------------------------------------
SeqDom == 1 .. Len(seq)

\* Permutation definition: a bijection on the domain of the sequence
Permutation == { f \in [SeqDom -> SeqDom] :
                   \A i \in SeqDom : f[i] \in SeqDom /\
                   \A i, j \in SeqDom : (f[i] = f[j]) => i = j }

\* Apply a permutation to a sequence
ApplyPerm(p, s) == [i \in 1..Len(s) |-> s[p[i]]]

\* Binary relation indicating that two sequences are permutations of each other
Permutes(a, b) == \E f \in Permutation : b = ApplyPerm(f, a)

\* Sortedness predicate
Sorted(s) == \A i \in 1 .. Len(s)-1 : s[i] <= s[i+1]

\* Partition predicate for a given interval [l..u] and pivot index p
\* (All elements outside [l..u] stay unchanged, and every element at or
\*  below the pivot position is <= every element above it.)
Partition(s, l, u, p, sNew) ==
    /\ l \in Idx /\ u \in Idx /\ l <= u /\ p \in l .. u
    /\ \A i \in 1 .. Len(s) :
          (i < l \/ i > u) => sNew[i] = s[i]
    /\ \A i \in l .. p :
          \A j \in p+1 .. u :
              sNew[i] <= sNew[j]
    /\ Permutes(s, sNew)

\* Subintervals generated by partitioning [l..u] with pivot p
SubIntervals(l, u, p) ==
    IF p = l THEN {}
    ELSE IF p = u THEN {}
    ELSE { [l |-> l, u |-> p-1], [l |-> p+1, u |-> u] }

\* ----------------------------------------------------------------------
\* Initial state
\* ----------------------------------------------------------------------
Init ==
    /\ seq = Seq
    /\ orig = seq
    /\ work = { [l |-> 1, u |-> Len(seq)] }
    /\ pc = "Loop"

\* ----------------------------------------------------------------------
\* Actions
\* ----------------------------------------------------------------------
PartitionStep ==
    /\ pc = "Loop"
    /\ work # {}
    /\ \E int \in work :
        LET l == int.l
            u == int.u
        IN
        IF l = u THEN
            /\ work' = work \ {int}
            /\ UNCHANGED << seq, orig, pc >>
        ELSE
            /\ \E p \in l .. u :
                /\ \E sNew \in Seq :
                    /\ Len(sNew) = Len(seq)
                    /\ Partition(seq, l, u, p, sNew)
                    /\ seq' = sNew
                    /\ work' = (work \ {int}) \cup SubIntervals(l, u, p)
                    /\ UNCHANGED orig
            /\ pc' = "Loop"

Terminate ==
    /\ pc = "Loop"
    /\ work = {}
    /\ pc' = "Done"
    /\ UNCHANGED << seq, orig, work >>

Stutter ==
    /\ pc = "Done"
    /\ UNCHANGED << seq, orig, work, pc >>

Next == PartitionStep \/ Terminate \/ Stutter

\* ----------------------------------------------------------------------
\* Specification
\* ----------------------------------------------------------------------
Spec == Init /\ [][Next]_<<seq, orig, work, pc>>

\* ----------------------------------------------------------------------
\* Invariants
\* ----------------------------------------------------------------------
PCorrect == pc = "Done" => /\ Sorted(seq) /\ Permutes(orig, seq)

TypeOK ==
    /\ seq \in Seq
    /\ orig \in Seq
    /\ work \subseteq Interval
    /\ pc \in {"Loop", "Done"}

\* A stronger invariant that is useful for model checking
Inv ==
    /\ TypeOK
    /\ PCorrect

\* ----------------------------------------------------------------------
\* Liveness property (termination)
\* ----------------------------------------------------------------------
Termination == <> (pc = "Done")

=============================================================================