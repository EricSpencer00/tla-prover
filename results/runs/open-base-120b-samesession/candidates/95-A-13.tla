---- MODULE GameOfLife ----
EXTENDS Naturals, FiniteSets

CONSTANT N

VARIABLES grid

(*-------------------------------------------------------------------*)
(*  Types and helper definitions                                      *)
(*-------------------------------------------------------------------*)

Pos == 1..N \X 1..N

(* Number of live neighbours of a position p in the current grid *)
LiveNeighbors(p) ==
  Cardinality(
    { q \in Pos :
        /\ p # q
        /\ (p[1] - q[1]) \in {-1, 0, 1}
        /\ (p[2] - q[2]) \in {-1, 0, 1}
        /\ grid[q] } )

(*-------------------------------------------------------------------*)
(*  Initialization                                                    *)
(*-------------------------------------------------------------------*)

Init ==
  /\ grid \in [Pos -> BOOLEAN]

(*-------------------------------------------------------------------*)
(*  Next-state relation                                               *)
(*-------------------------------------------------------------------*)

Next ==
  /\ grid' = [ p \in Pos |
                IF grid[p] THEN
                  (LiveNeighbors(p) = 2) \/ (LiveNeighbors(p) = 3)
                ELSE
                  LiveNeighbors(p) = 3 ]

(*-------------------------------------------------------------------*)
(*  Specification                                                    *)
(*-------------------------------------------------------------------*)

Spec ==
  Init /\ [] [Next]_<<grid>>

(*-------------------------------------------------------------------*)
(*  Invariant                                                        *)
(*-------------------------------------------------------------------*)

TypeOK ==
  /\ grid \in [Pos -> BOOLEAN]

====