---- MODULE Slush ----
EXTENDS Naturals, FiniteSets, Sequences

CONSTANTS
  Node,                \* Set of node identifiers
  SlushLoopProcess,    \* Set of loop process identifiers (one per node)
  SlushQueryProcess,   \* Set of query process identifiers (one per node)
  HostMapping,         \* Set of triples <<loopProc, queryProc, node>>
  SlushIterationCount, \* Number of iterations each loop process runs
  SampleSetSize,       \* Size of the peer sample per iteration
  PickFlipThreshold,   \* Threshold for adopting a color
  NoColor,             \* Value denoting an uncolored node
  NoMessage            \* Value denoting the absence of a message

(***************************************************************************)
(*  Definition of colors used in the protocol.  The two possible colors   *)
(*  are represented by the strings "Red" and "Blue".                      *)
(***************************************************************************)
Color == {"Red", "Blue"}

(***************************************************************************)
(*  Definition of the message record type.  A message is one of three    *)
(*  kinds: Query, Reply, or Termination.  The fields are:               *)
(*    type   ∈ {"Query","Reply","Term"}                                  *)
(*    src    – sender (loop or query process)                              *)
(*    dst    – receiver (loop or query process)                            *)
(*    color  – the color carried in the message (or NoColor for Term)    *)
(***************************************************************************)
Message == [
  type  : {"Query", "Reply", "Term"},
  src   : (SlushLoopProcess \cup SlushQueryProcess),
  dst   : (SlushLoopProcess \cup SlushQueryProcess),
  color : (Color \cup {NoColor})
]

VARIABLES
  color,   \* [Node -> (Color \cup {NoColor})]  current node colors
  msgs,    \* Set of in‑flight messages
  sample,  \* [SlushLoopProcess -> SUBSET Node]   current sample set per loop
  iter,    \* [SlushLoopProcess -> Nat]          iteration counter per loop
  pc       \* program counters generated by PlusCal

(***************************************************************************)
(*  Helper functions to retrieve the node associated with a given process*)
(*  via the HostMapping triple.                                            *)
(***************************************************************************)
LoopNode(lp)    == CHOOSE n \in Node : <<lp, _, n>> \in HostMapping
QueryNode(qp)   == CHOOSE n \in Node : <<_, qp, n>> \in HostMapping
LoopOfNode(n)   == CHOOSE lp \in SlushLoopProcess : <<lp, _, n>> \in HostMapping
QueryOfNode(n)  == CHOOSE qp \in SlushQueryProcess : <<_, qp, n>> \in HostMapping

(***************************************************************************)
(*  The PlusCal algorithm modeling the Slush protocol.                     *)
(***************************************************************************)
(*--algorithm Slush
variables
  color = [n \in Node |-> NoColor],
  msgs  = {},
  sample = [lp \in SlushLoopProcess |-> {}],
  iter   = [lp \in SlushLoopProcess |-> 0];

process (client = "client")
{
  while (TRUE) {
    with n \in Node do
      if (color[n] = NoColor) {
        either
          color' := [color EXCEPT ![n] = "Red"];
        or
          color' := [color EXCEPT ![n] = "Blue"];
        end either;
      };
    end with;
  }
}

process (lp \in SlushLoopProcess)
{
  variable hostNode;
  begin
    hostNode := LoopNode(lp);
    await color[hostNode] # NoColor;               \* wait for initial assignment

    while (iter[lp] < SlushIterationCount) {
      \* ------------------- 1. Choose a random sample -------------------
      with s \subseteq Node \ {hostNode} do
        if (Cardinality(s) = SampleSetSize) {
          sample' := [sample EXCEPT ![lp] = s];
        };
      end with;

      \* ------------------- 2. Send queries to the sampled peers -----
      with s \in sample[lp] do
        let qp == QueryOfNode(s) in
          msgs' := msgs \cup {
            [type |-> "Query",
             src  |-> lp,
             dst  |-> qp,
             color|-> color[hostNode]]
          };
        end let;
      end with;

      \* ------------------- 3. Await all replies ----------------------
      await \A s \in sample[lp] :
        \E m \in msgs :
          /\ m.type = "Reply"
          /\ m.dst  = lp
          /\ m.src  = QueryOfNode(s);

      \* ------------------- 4. Tally replies -------------------------
      let reds  == Cardinality({
                     m \in msgs :
                       /\ m.type = "Reply"
                       /\ m.dst = lp
                       /\ m.color = "Red"
                   });
          blues == Cardinality({
                     m \in msgs :
                       /\ m.type = "Reply"
                       /\ m.dst = lp
                       /\ m.color = "Blue"
                   })
      in
        if (reds >= PickFlipThreshold) {
          color' := [color EXCEPT ![hostNode] = "Red"];
        } elsif (blues >= PickFlipThreshold) {
          color' := [color EXCEPT ![hostNode] = "Blue"];
        } else {
          skip;
        };
      end let;

      \* ------------------- 5. Clean up and advance -------------------
      msgs' := { m \in msgs :
                  ~(
                    (m.dst = lp /\ m.type = "Reply") \/
                    (m.src = lp /\ m.type = "Query")
                  ) };
      sample' := [sample EXCEPT ![lp] = {}];
      iter'   := [iter EXCEPT ![lp] = @ + 1];
    }

    \* ------------------- 6. Broadcast termination --------------------
    with allLp \in SlushLoopProcess do
      msgs' := msgs \cup {
                 [type |-> "Term",
                  src  |-> lp,
                  dst  |-> allLp,
                  color|-> NoColor]
               };
    end with;
  end while;
}

process (qp \in SlushQueryProcess)
{
  variable hostNode;
  begin
    hostNode := QueryNode(qp);
    while (TRUE) {
      await \E m \in msgs : m.type = "Query" /\ m.dst = qp;
      with m \in msgs do
        if (m.type = "Query" /\ m.dst = qp) {
          if (color[hostNode] = NoColor) {
            color' := [color EXCEPT ![hostNode] = m.color];
          };
          \* send reply
          let lp == m.src in
            msgs' := msgs \cup {
                       [type |-> "Reply",
                        src  |-> qp,
                        dst  |-> lp,
                        color|-> color[hostNode]]
                     };
          end let;
          \* remove the processed query
          msgs' := msgs' \ { m };
        };
      end with;
    }
  end while;
}
}
*)

(***************************************************************************)
(*  The generated PlusCal variables and actions:                           *)
(*    pc    – program counters for each process                           *)
(*    Init  – initial state                                                *)
(*    Next  – disjunction of all possible actions                         *)
(*    Spec  – the standard behavior specification (Init /\ []Next)       *)
(***************************************************************************)

Init ==
  /\ pc = [p \in {"client"} \cup SlushLoopProcess \cup SlushQueryProcess |-> "Init"]
  /\ color = [n \in Node |-> NoColor]
  /\ msgs = {}
  /\ sample = [lp \in SlushLoopProcess |-> {}]
  /\ iter = [lp \in SlushLoopProcess |-> 0]

Next ==
  \/ \E p \in {"client"} \cup SlushLoopProcess \cup SlushQueryProcess :
       /\ pc[p] # "Done"
       /\ UNCHANGED <<color, msgs, sample, iter>>

Spec == Init /\ [][Next]_<<pc, color, msgs, sample, iter>>

(***************************************************************************)
(*  Type invariant: all variables have values of the expected shape.      *)
(***************************************************************************)
TypeInvariant ==
  /\ color \in [Node -> (Color \cup {NoColor})]
  /\ msgs \subseteq Message
  /\ sample \in [SlushLoopProcess -> SUBSET Node]
  /\ iter \in [SlushLoopProcess -> Nat]

=============================================================================