---- MODULE Slush ----
EXTENDS Naturals, FiniteSets, Sequences, TLC

CONSTANTS
  Node,                     \* set of node identifiers
  SlushLoopProcess,         \* set of loop process identifiers (one per node)
  SlushQueryProcess,        \* set of query process identifiers (one per node)
  HostMapping,              \* set of triples <<node, loopProc, queryProc>>
  SlushIterationCount,      \* number of iterations each loop process must run
  SampleSetSize,            \* size of the peer sample each iteration
  PickFlipThreshold,        \* minimum number of equal replies to trigger a flip
  NoColor,                  \* value representing “uncolored”
  NoMessage                 \* value representing “no message” (unused but required)

(* ---------------------------------------------------------------------- *)
(* Helper definitions that derive the bijective mappings from HostMapping *)
(* ---------------------------------------------------------------------- *)

LoopProcOfNode(n) == 
  CHOOSE lp \in SlushLoopProcess : 
    \E qp \in SlushQueryProcess : <<n, lp, qp>> \in HostMapping

QueryProcOfNode(n) == 
  CHOOSE qp \in SlushQueryProcess : 
    \E lp \in SlushLoopProcess : <<n, lp, qp>> \in HostMapping

NodeOfLoop(lp) == 
  CHOOSE n \in Node : 
    \E qp \in SlushQueryProcess : <<n, lp, qp>> \in HostMapping

NodeOfQuery(qp) == 
  CHOOSE n \in Node : 
    \E lp \in SlushLoopProcess : <<n, lp, qp>> \in HostMapping

OtherNodes(n) == Node \ {n}

ChooseSample(n) == 
  CHOOSE s \in SUBSET OtherNodes(n) : Cardinality(s) = SampleSetSize

Colors == {"Red", "Blue"}

(* ---------------------------------------------------------------------- *)
(* State variables *)
(* ---------------------------------------------------------------------- *)

VARIABLES
  color,        \* [node -> "Red" | "Blue" | NoColor]
  msgs,         \* set of messages (records)
  sampleSet,    \* [loopProc -> SUBSET Node]   the current peer sample
  iterCount,    \* [loopProc -> Nat]           number of completed iterations
  pc            \* program counters generated by PlusCal (unused here)

(* ---------------------------------------------------------------------- *)
(* Message record shape *)
(* ---------------------------------------------------------------------- *)

Message == 
  [type   : {"query", "reply", "term"},
   src    : (SlushLoopProcess \cup SlushQueryProcess),
   dst    : (SlushLoopProcess \cup SlushQueryProcess),
   color  : (Colors \cup {NoColor})]

(* ---------------------------------------------------------------------- *)
(* Initial state *)
(* ---------------------------------------------------------------------- *)

Init ==
  /\ color    = [n \in Node |-> NoColor]
  /\ msgs     = {}
  /\ sampleSet = [lp \in SlushLoopProcess |-> {}]
  /\ iterCount = [lp \in SlushLoopProcess |-> 0]
  /\ pc       = [p \in {"client"} \cup SlushLoopProcess \cup SlushQueryProcess |-> "Init"]

(* ---------------------------------------------------------------------- *)
(* Actions *)
(* ---------------------------------------------------------------------- *)

(* 1. Client assigns a random color to an uncolored node *)
ClientAssign ==
  \E n \in Node :
    /\ color[n] = NoColor
    /\ color' = [color EXCEPT ![n] = 
                     IF RandomChoice THEN "Red" ELSE "Blue"]
    /\ UNCHANGED <<msgs, sampleSet, iterCount, pc>>

(* 2. Loop process chooses a sample of peers and sends queries *)
ChooseSampleAndQuery(lp) ==
  LET n == NodeOfLoop(lp) IN
  /\ color[n] # NoColor                         \* node already colored
  /\ iterCount[lp] < SlushIterationCount
  /\ sampleSet[lp] = {}
  /\ s == ChooseSample(n)
  /\ sampleSet' = [sampleSet EXCEPT ![lp] = s]
  /\ msgs' = msgs \cup {
        [type  |-> "query",
         src   |-> lp,
         dst   |-> QueryProcOfNode(p),
         color |-> color[n]] : p \in s }
  /\ UNCHANGED <<color, iterCount, pc>>

(* 3. Query process receives a query, possibly adopts the color, and replies *)
RespondToQuery(qp) ==
  \E m \in msgs :
    /\ m.type = "query"
    /\ m.dst  = qp
    LET n == NodeOfQuery(qp) IN
    /\ IF color[n] = NoColor
         THEN color' = [color EXCEPT ![n] = m.color]
         ELSE UNCHANGED color
    /\ msgs' = (msgs \ {m}) \cup {
          [type  |-> "reply",
           src   |-> qp,
           dst   |-> m.src,
           color |-> (IF color[n] = NoColor THEN m.color ELSE color[n])]}
    /\ UNCHANGED <<sampleSet, iterCount, pc>>

(* 4. Loop process tallies replies and possibly flips its node's color *)
TallyAndFlip(lp) ==
  LET n  == NodeOfLoop(lp)
      s  == sampleSet[lp]
  IN
  /\ s # {}
  /\ \A p \in s :
        \E r \in msgs :
          /\ r.type = "reply"
          /\ r.dst  = lp
          /\ r.src  = QueryProcOfNode(p)
  /\ countRed  == Cardinality({ r \in msgs : r.type = "reply" /\ r.dst = lp /\ r.color = "Red" })
  /\ countBlue == Cardinality({ r \in msgs : r.type = "reply" /\ r.dst = lp /\ r.color = "Blue" })
  /\ \/ (countRed  >= PickFlipThreshold /\ color' = [color EXCEPT ![n] = "Red"])
     \/ (countBlue >= PickFlipThreshold /\ color' = [color EXCEPT ![n] = "Blue"])
     \/ UNCHANGED color
  /\ sampleSet' = [sampleSet EXCEPT ![lp] = {}]
  /\ iterCount' = [iterCount EXCEPT ![lp] = @ + 1]
  /\ UNCHANGED <<msgs, pc>>

(* 5. After finishing all iterations, a loop process broadcasts termination *)
BroadcastTerm(lp) ==
  /\ iterCount[lp] = SlushIterationCount
  /\ msgs' = msgs \cup {
        [type |-> "term",
         src  |-> lp,
         dst  |-> dstLp,
         color|-> NoColor] : dstLp \in SlushLoopProcess }
  /\ UNCHANGED <<color, sampleSet, iterCount, pc>>

(* 6. (Optional) Query processes could exit after hearing all term messages;
       omitted for brevity – they simply remain idle. *)

Next ==
  \/ ClientAssign
  \/ \E lp \in SlushLoopProcess : ChooseSampleAndQuery(lp)
  \/ \E qp \in SlushQueryProcess   : RespondToQuery(qp)
  \/ \E lp \in SlushLoopProcess : TallyAndFlip(lp)
  \/ \E lp \in SlushLoopProcess : BroadcastTerm(lp)

(* ---------------------------------------------------------------------- *)
(* Specification *)
(* ---------------------------------------------------------------------- *)

Spec == Init /\ [][Next]_<<color, msgs, sampleSet, iterCount, pc>>

(* ---------------------------------------------------------------------- *)
(* Type invariant *)
(* ---------------------------------------------------------------------- *)

TypeInvariant ==
  /\ \A n \in Node : color[n] \in (Colors \cup {NoColor})
  /\ \A m \in msgs :
        /\ m.type  \in {"query", "reply", "term"}
        /\ m.src   \in (SlushLoopProcess \cup SlushQueryProcess)
        /\ m.dst   \in (SlushLoopProcess \cup SlushQueryProcess)
        /\ m.color \in (Colors \cup {NoColor})

(* ---------------------------------------------------------------------- *)
(* Nondeterministic choice used to model “random” decisions *)
(* ---------------------------------------------------------------------- *)

RandomChoice == TRUE \/ FALSE

====