---- MODULE Quicksort ----
EXTENDS Naturals, FiniteSets, Sequences

CONSTANTS Values, MaxSeqLen, Seq

Interval == [lo: 1..MaxSeqLen, hi: 1..MaxSeqLen]

RECURSIVE Permutes(_, _)
Permutes(f, s) ==
  IF s = <<>> THEN TRUE
  ELSE \E i \in 1..Len(s) : f[i] = s[1] /\ Permutes([j \in 1..(Len(s) - 1) |-> IF j < i THEN f[j] ELSE f[j + 1]], Tail(s))

\* Permutations are generated by composing the current sequence with an automorphism
\* that re-orders indices. This is the definition referred to in the description.
RECURSIVE PermuteBy(_, _)
PermuteBy(f, s) ==
  \E g \in [DOMAIN s -> DOMAIN s] :
     /\ \A i \in DOMAIN s : \E j \in DOMAIN s : g[i] = j /\ \A j \in DOMAIN s : \E i \in DOMAIN s : g[i] = j
     /\ f = [i \in DOMAIN s |-> s[g[i]]]

VARIABLES seq, orig, work, pc

vars == <<seq, orig, work, pc>>

TypeOK ==
  /\ seq \in Seq
  /\ orig \in Seq
  /\ work \subseteq Interval
  /\ pc \in {"loop", "term"}

Init ==
  /\ seq \in Seq
  /\ orig = seq
  /\ work = IF Len(seq) > 0 THEN {[lo |-> 1, hi |-> Len(seq)]} ELSE {}
  /\ pc = "loop"

\* The partition step abstracts away the actual partition algorithm and instead chooses
\* any new sequence that a valid partition over the chosen interval and pivot could have
\* produced: elements within the interval are rearranged, everything else is untouched.
PartitionStep(s, i, p) ==
  { t \in Seq :
       /\ PermuteBy(t, s)
       /\ \A k \in 1..Len(s) : (k < p) <=> (t[k] <= s[p])
       /\ \A k \in 1..Len(s) : (k >= p) <=> (s[p] <= t[k])
       /\ \A k \in 1..Len(s) : (k < i \/ k > i) => t[k] = s[k] }

Split(i) ==
  /\ i.lo < i.hi
  /\ \E p \in i.lo..i.hi :
       /\ \E s' \in PartitionStep(seq, i.lo, p) :
            /\ seq' = s'
            /\ work' = (work \ {i}) \cup {[lo |-> i.lo, hi |-> p], [lo |-> p + 1, hi |-> i.hi]}
  /\ pc' = pc

Terminate ==
  /\ work = {}
  /\ pc' = "term"
  /\ UNCHANGED <<seq, orig, work>>

Stall == UNCHANGED vars

Next ==
  \/ \E i \in work : Split(i)
  \/ Terminate
  \/ Stall

Spec == Init /\ [][Next]_vars
        /\ WF_vars(Next)

PCorrect == pc = "term" => Permutes(seq, orig)
TypeOKInv == TypeOK
Inv == PCorrect
Termination == <>(pc = "term")
====