---- MODULE GameOfLife ----
EXTENDS Naturals, Integers, FiniteSets

CONSTANT N

VARIABLE A

(*-------------------------------------------------------------------*)
(*   Definitions                                                    *)
(*-------------------------------------------------------------------*)

Cell == (1 .. N) \X (1 .. N)

Abs(x) == IF x >= 0 THEN x ELSE -x

IsNeighbor(c, d) ==
    /\ c # d
    /\ Abs(c[1] - d[1]) <= 1
    /\ Abs(c[2] - d[2]) <= 1

NeighborCount(c) ==
    Cardinality({ d \in Cell : IsNeighbor(c, d) /\ A[d] })

(*-------------------------------------------------------------------*)
(*   Initialization                                                 *)
(*-------------------------------------------------------------------*)

Init ==
    A \in [Cell -> BOOLEAN]

(*-------------------------------------------------------------------*)
(*   Next-state relation                                            *)
(*-------------------------------------------------------------------*)

Next ==
    /\ A' = [c \in Cell |-> 
                LET n == NeighborCount(c) IN
                IF A[c] THEN (n = 2) \/ (n = 3) ELSE n = 3
            ]

(*-------------------------------------------------------------------*)
(*   Specification                                                  *)
(*-------------------------------------------------------------------*)

Spec == Init /\ [][Next]_A

(*-------------------------------------------------------------------*)
(*   Invariant                                                      *)
(*-------------------------------------------------------------------*)

TypeOK == A \in [Cell -> BOOLEAN]

=============================================================================