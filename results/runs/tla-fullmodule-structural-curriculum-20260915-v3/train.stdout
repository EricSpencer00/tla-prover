poch + 1\n    /\\ avail' = [r \\in Rooms |-> 1]\n    /\\ occupant' = [r \\in Rooms |-> NONE]\n    /\\ pending' = [i \\in Instances |-> {}]\n\nNext ==\n    \\/ \\E i \\in Instances, r \\in Rooms : Request(i, r)\n    \\/ \\E i \\in Instances, r \\in Rooms : Acquire(i, r)\n    \\/ \\E i \\in Instances, r \\in Rooms : Release(i, r)\n    \\/ Reconfigure\n\nSpec == Init /\\ [][Next]_vars\n\nSemaphoreConsistent ==\n    \\A r \\in Rooms : (avail[r] = 1) <=> (occupant[r] = NONE)\n====", "module_sha256": "8d49269fb7805d0a70e66b646449dfc254aabfc5e51bd388179bd64202e566d1", "process": {"cleanup_complete": true, "command": ["/lus/grand/projects/EVITA/eric-spencer/tools/jre21/bin/java", "-Djava.io.tmpdir=/home/eric-spencer/tla-fullmodule-structural-curriculum-20260915-v3/result.7624329/sany_reference/64/jtmp", "-DTLA-Library=/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/tlapm/lib/tlapm/stdlib:/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/community-modules:/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/extra-modules", "-cp", "/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/tla2tools.jar", "tla2sany.SANY", "W4Od0m9p0t2.tla"], "containment": "Best-effort ancestry polling; instantaneous unobserved reparenting is not excluded", "cwd": "/home/eric-spencer/tla-fullmodule-structural-curriculum-20260915-v3/result.7624329/sany_reference/64", "errors": [], "execution_complete": true, "output": "\n****** SANY2 Version 2.1 created 24 February 2014\n\nParsing file /home/eric-spencer/tla-fullmodule-structural-curriculum-20260915-v3/result.7624329/sany_reference/64/W4Od0m9p0t2.tla\nParsing file /home/eric-spencer/tla-fullmodule-structural-curriculum-20260915-v3/result.7624329/sany_reference/64/jtmp/Integers.tla\nParsing file /home/eric-spencer/tla-fullmodule-structural-curriculum-20260915-v3/result.7624329/