 << >>\n  /\\ crashed = {}\n\nAcquireCoarse(w, f) ==\n  /\\ w \\notin crashed\n  /\\ coarse[f] = NONE\n  /\\ coarse' = [coarse EXCEPT ![f] = w]\n  /\\ UNCHANGED <<fine, log, crashed>>\n\nAcquireFine(w, u) ==\n  /\\ w \\notin crashed\n  /\\ coarse[FridgeOf(u)] = w\n  /\\ fine[u] = NONE\n  /\\ fine' = [fine EXCEPT ![u] = w]\n  /\\ UNCHANGED <<coarse, log, crashed>>\n\nDispatch(w, u) ==\n  /\\ w \\notin crashed\n  /\\ coarse[FridgeOf(u)] = w\n  /\\ fine[u] = w\n  /\\ u \\notin Logged\n  /\\ log' = Append(log, u)\n  /\\ fine' = [fine EXCEPT ![u] = NONE]\n  /\\ UNCHANGED <<coarse, crashed>>\n\nReleaseFine(w, u) ==\n  /\\ fine[u] = w\n  /\\ fine' = [fine EXCEPT ![u] = NONE]\n  /\\ UNCHANGED <<coarse, log, crashed>>\n\nReleaseCoarse(w, f) ==\n  /\\ coarse[f] = w\n  /\\ coarse' = [coarse EXCEPT ![f] = NONE]\n  /\\ UNCHANGED <<fine, log, crashed>>\n\nCrash(w) ==\n  /\\ w \\notin crashed\n  /\\ crashed' = crashed \\cup {w}\n  /\\ coarse' = [f \\in Fridges |-> IF coarse[f] = w THEN NONE ELSE coarse[f]]\n  /\\ fine' = [u \\in Units |-> IF fine[u] = w THEN NONE ELSE fine[u]]\n  /\\ UNCHANGED log\n\nIdle == UNCHANGED vars\n\nNext ==\n  \\/ \\E w \\in Workers, f \\in Fridges : AcquireCoarse(w, f)\n  \\/ \\E w \\in Workers, u \\in Units : AcquireFine(w, u)\n  \\/ \\E w \\in Workers, u \\in Units : Dispatch(w, u)\n  \\/ \\E w \\in Workers, u \\in Units : ReleaseFine(w, u)\n  \\/ \\E w \\in Workers, f \\in Fridges : ReleaseCoarse(w, f)\n  \\/ \\E w \\in Workers : Crash(w)\n  \\/ Idle\n\nSpec == Init /\\ [][Next]_vars\n\nEachUnitDispatchedOnce ==\n  \\A i, j \\in DOMAIN log : log[i] = log[j] => i = j\n\n=============================================================================", "module_sha256": "5e3d633c0525479a98a81a339de060809b3fed0743666c4ba53541eedff87a6b", "process": {"cleanup_complete": true, "command": ["/lus/grand/projects/EVITA/eric-spencer/tools/jre21/bin/java", "-Djava.io.tmpdir=/home/eric-spencer/tla-fullmodule-structural-curriculum-20260915-v3/result.7624329/sany_refe