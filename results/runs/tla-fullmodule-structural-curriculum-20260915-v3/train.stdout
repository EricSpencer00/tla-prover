atus": "pass", "syntax_only": true, "task_sha256": "ff69465cd582464220903d5f28f05e322f4e7e15e5de7b897f7427edf36af086", "timeout_seconds": 30}, "52": {"command": ["/lus/grand/projects/EVITA/eric-spencer/tools/jre21/bin/java", "-Djava.io.tmpdir=/home/eric-spencer/tla-fullmodule-structural-curriculum-20260915-v3/result.7624329/sany_reference/52/jtmp", "-DTLA-Library=/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/tlapm/lib/tlapm/stdlib:/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/community-modules:/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/extra-modules", "-cp", "/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/tla2tools.jar", "tla2sany.SANY", "W4Od19m7p2t1.tla"], "dependency_sha256": {}, "module": "---- MODULE W4Od19m7p2t1 ----\nEXTENDS Naturals\nCONSTANTS Patrons, Total\n\nNone == \"none\"\n\nVARIABLES reg, shelf, loaned, inbox\nvars == <<reg, shelf, loaned, inbox>>\n\nMsgs == [patron : Patrons, act : {\"borrow\", \"return\"}]\n\nInit ==\n  /\\ reg = None\n  /\\ shelf = Total\n  /\\ loaned = 0\n  /\\ inbox = {}\n\nRequest(p, a) ==\n  /\\ [patron |-> p, act |-> a] \\notin inbox\n  /\\ inbox' = inbox \\cup {[patron |-> p, act |-> a]}\n  /\\ UNCHANGED <<reg, shelf, loaned>>\n\nAcquire(p) ==\n  /\\ reg = None\n  /\\ reg' = p\n  /\\ UNCHANGED <<shelf, loaned, inbox>>\n\nBorrow(p) ==\n  /\\ reg = p\n  /\\ shelf > 0\n  /\\ [patron |-> p, act |-> \"borrow\"] \\in inbox\n  /\\ shelf' = shelf - 1\n  /\\ loaned' = loaned + 1\n  /\\ inbox' = inbox \\ {[patron |-> p, act |-> \"borrow\"]}\n  /\\ reg' = None\n\nReturn(p) ==\n  /\\ reg = p\n  /\\ loaned > 0\n  /\\ [patron |-> p, act |-> \"return\"] \\in inbox\n  /\\ loaned' = loaned - 1\n  /\\ shelf' = shelf + 1\n  /\\ inbox' = inbox \\ {[patron |-> p, act |-> \"return\"]}\n  /\\ reg' = None\n\nRelease(p) ==\n  /\\ reg = p\n  /\\ reg' = None\n  /\\ UNCHANGED <<shelf, loaned, inbox>>\n\nNext ==\n  \\/ \\E p \\in Patrons, a \\in {\"borrow\", \"return\"} : Request(p, a)\n  \\/ \\E p \\in Patrons : Acquire(p) \\/ Borrow(p) \\/ Return(p) \\/ Release(p)\n\nSpec == Init /\\ [][Next]_vars\n\nCopiesConserved == shelf + loaned = Total\n====", "module_sha256": "769f844aaa3a81ab2a77b59922b84824d678c071468f8ab3b96bd5be021e7132", "process": {"cleanup_complete": true, "command": ["/lus/grand/projects/EVITA/eric-spencer/tools/jre21/bin/java", "-Djava.io.tmpdir=/home/eric-spencer/tla-fullmodule-structural-curriculum-20260915-v3/result.7624329/sany_reference/52/jtmp", "-DTLA-Library=/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/tlapm/lib/tlapm/stdlib:/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/community-modules:/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/extra-modules", "-cp", "/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/tla2tools.jar", "tla2sany.SANY", "W4Od19m7p2t1.tla"], "containment": "Best-effort ancestry polling; instantaneous unobserved reparenting is not excluded", "cwd": "/home/eric-spencer/tla-fullmodule-structural-curriculum-20260915-v3/result.7624329/sany_reference/52", "errors": [], "execution_complete": true, "output": "\n****** SANY2 Version 2.1 created 24 February 2014\n\nParsing file /home/eric-spencer/tla-fullmodule-structural-curriculum-20260915-v3/result.7624329/sany_reference/52/W4Od19m7p2t1.tla\nParsing file /home/eric-spencer/tla-fullmodule-structural-curriculum-20260915-v3/result.7624329/sany_reference/52/jtmp/Naturals.tla\nSemantic processing of module Naturals\nSemantic processing of module W4Od19m7p2t1\n", "output_complete": true, "output_limit": false, "owned_processes": [{"created": 1789495177.25, "pgid": 303124, "pid": 303124}], "returncode": 0, "root_pid": 303124, "root_reaped": true, "seconds": 0.22532848292030394, "signals": [], "surviving_owned_processes": [], "timed_out": false}, "raw_reply_sha256": "769f844aaa3a81ab2a77b59922b84824d678c071468f8ab3b96bd5be021e7132", "sany": 1, "seconds": 0.23644932499155402, "status": "pass", "syntax_only": true, "task_sha256": "46eb59605476a21fdfd5a750608ca181f697687d209abf30af822eefa07c2a2a", "timeout_seconds": 30}, "53": {"command": ["/lus/grand/projects/EVITA/eric-spencer/tools/jre21/bin/java", "-Djava.io.tmpdir=/home/eric-spencer/tla-fullmodule-structural-curriculum-20260915-v3/result.7624329/sany_reference/53/jtmp", "-DTLA-Library=/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/tlapm/lib/tlapm/stdlib:/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/community-modules:/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/extra-modules", "-cp", "/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/tla2tools.jar", "tla2sany.SANY", "W4Od12m7p3t1.tla"], "dependency_sha256": {}, "module": "------------------------------ MODULE W4Od12m7p3t1 ------------------------------\nEXTENDS Naturals, FiniteSets\n\nCONSTANTS Slots, Units, MaxInbox, MaxVersion\n\nAllRequests == [slot : Slots, unit : Units]\n\nVARIABLES inbox, grants, done, version\nvars == <<inbox, grants, done, version>>\n\nInit ==\n    /\\ inbox = {}\n    /\\ grants = {}\n    /\\ done = {}\n    /\\ version = 0\n\nArrive(r) ==\n    /\\ r \\in AllRequests\n    /\\ r \\notin inbox\n    /\\ r \\notin grants\n    /\\ r \\notin done\n    /\\ Cardinality(inbox) < MaxInbox\n    /\\ inbox' = inbox \\cup {r}\n    /\\ UNCHANGED <<grants, done, version>>\n\nCommitCAS(r) ==\n    /\\ r \\in inbox\n    /\\ version < MaxVersion\n    /\\ \\A g \\in grants : g.slot # r.slot\n    /\\ grants' = grants \\cup {r}\n    /\\ inbox' = inbox \\ {r}\n    /\\ version' = version + 1\n    /\\ UNCHANGED done\n\nReject(r) ==\n    /\\ r \\in inbox\n    /\\ \\E g \\in grants : g.slot = r.slot\n    /\\ inbox' = inbox \\ {r}\n    /\\ UNCHANGED <<grants, done, version>>\n\nRelease(r) ==\n    /\\ r \\in grants\n    /\\ grants' = grants \\ {r}\n    /\\ done' = done \\cup {r}\n    /\\ UNCHANGED <<inbox, version>>\n\nRecycle ==\n    /\\ inbox = {}\n    /\\ grants = {}\n    /\\ done # {}\n    /\\ done' = {}\n    /\\ version' = 0\n    /\\ UNCHANGED <<inbox, grants>>\n\nNext ==\n    \\/ Recycle\n    \\/ \\E r \\in AllRequests :\n         Arrive(r) \\/ CommitCAS(r) \\/ Reject(r) \\/ Release(r)\n\nSpec == Init /\\ [][Next]_vars\n\nNoDoubleGrant ==\n    \\A g1, g2 \\in grants : (g1.slot = g2.slot) => (g1 = g2)\n\nGrantsArchiveDisjoint ==\n    grants \\cap done = {}\n\n================================================================================", "module_sha256": "53db414f719adaeb58a9890f7164294c44d16721963b31b855ad648be147d66c", "process": {"cleanup_complete": true, "command": ["/lus/grand/projects/EVITA/eric-spencer/tools/jre21/bin/java", "-Djava.io.tmpdir=/home/eric-spencer/tla-fullmodule-structural-curriculum-20260915-v3/result.7624329/sany_reference/53/jtmp", "-DTLA-Library=/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/tlapm/lib/tlapm/stdlib:/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/community-modules:/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/extra-modules", "-cp", "/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/tla2tools.jar", "tla2sany.SANY", "W4Od12m7p3t1.tla"], "containment": "Best-effort ancestry polling; instantaneous unobserved reparenting is not excluded", "cwd": "/home/eric-spencer/tla-fullmodule-structural-curriculum-20260915-v3/result.7624329/sany_reference/53", "errors": [], "execution_complete": true, "output": "\n****** SANY2 Version 2.1 created 24 February 2014\n\nParsing file /home/eric-spencer/tla-fullmodule-structural-curriculum-20260915-v3/result.7624329/sany_reference/53/W4Od12m7p3t1.tla\nParsing file /home/eric-spencer/tla-fullmodule-structural-curriculum-20260915-v3/result.7624329/sany_reference/53/jtmp/Naturals.tla\nParsing file /home/eric-spencer/tla-fullmodule-structural-curriculum-20260915-v3/result.7624329/sany_reference/53/jtmp/FiniteSets.tla\nParsing file /home/eric-spencer/tla-fullmodule-structural-curriculum-20260915-v3/result.7624329/sany_reference/53/jtmp/Sequences.tla\nSemantic processing of module Naturals\nSemantic processing of module Sequences\nSemantic processing of module FiniteSets\nSemantic processing of module W4Od12m7p3t1\n", "output_complete": true, "output_limit": false, "owned_processes": [{"created": 1789495177.49, "pgid": 303147, "pid": 303147}], "returncode": 0, "root_pid": 303147, "root_reaped": true, "seconds": 0.2391652271617204, "signals": [], "surviving_owned_processes": [], "timed_out": false}, "raw_reply_sha256": "53db414f719adaeb58a9890f7164294c44d16721963b31b855ad648be147d66c", "sany": 1, "seconds": 0.2516540598589927, "status": "pass", "syntax_only": true, "task_sha256": "77346ce41c0bd4baa508d28d5d3850b7754644c798b9781319fcfefd8c787093", "timeout_seconds": 30}, "54": {"command": ["/lus/grand/projects/EVITA/eric-spencer/tools/jre21/bin/java", "-Djava.io.tmpdir=/home/eric-spencer/tla-fullmodule-structural-curriculum-20260915-v3/result.7624329/sany_reference/54/jtmp", "-DTLA-Library=/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/tlapm/lib/tlapm/stdlib:/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/community-modules:/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/extra-modules", "-cp", "/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/tla2tools.jar", "tla2sany.SANY", "W4Od17m2p2t4.tla"], "dependency_sha256": {}, "module": "---- MODULE W4Od17m2p2t4 ----\nEXTENDS Naturals\n\nCONSTANTS Zone, RM, Total, MaxCap, NoMove, Home\n\nASSUME NoMove \\notin (Zone \\X Zone)\n\nVARIABLES bags, vote, pending, cap\nvars == <<bags, vote, pending, cap>>\n\nRECURSIVE SumOf(_)\nSumOf(S) ==\n  IF S = {} THEN 0\n  ELSE LET z == CHOOSE y \\in S : TRUE IN bags[z] + SumOf(S \\ {z})\n\nInit ==\n  /\\ bags = [z \\in Zone |-> IF z = Home THEN Total ELSE 0]\n  /\\ vote = [r \\in RM |-> \"none\"]\n  /\\ pending = NoMove\n  /\\ cap = [z \\in Zone |-> Total]\n\nPropose(s, d) ==\n  /\\ pending = NoMove\n  /\\ s # d\n  /\\ pending' = <<s, d>>\n  /\\ vote' = [r \\in RM |-> \"none\"]\n  /\\ UNCHANGED <<bags, cap>>\n\nPrepare(r) ==\n  /\\ pending # NoMove\n  /\\ vote[r] = \"none\"\n  /\\ vote' = [vote EXCEPT ![r] = \"yes\"]\n  /\\ UNCHANGED <<bags, pending, cap>>\n\nCommit ==\n  /\\ pending # NoMove\n  /\\ \\A r \\in RM : vote[r] = \"yes\"\n  /\\ LET s == pending[1]\n         d == pending[2] IN\n       /\\ bags[s] > 0\n       /\\ bags[d] < cap[d]\n       /\\ bags' = [bags EXCEPT ![s] = @ - 1, ![d] = @ + 1]\n  /\\ pending' = NoMove\n  /\\ UNCHANGED <<vote, cap>>\n\nAbort ==\n  /\\ pending # NoMove\n  /\\ pending' = NoMove\n  /\\ UNCHANGED <<bags, vote, cap>>\n\nResize(z, n) ==\n  /\\ n \\in 1..MaxCap\n  /\\ n >= bags[z]\n  /\\ cap' = [cap EXCEPT ![z] = n]\n  /\\ UNCHANGED <<bags, vote, pending>>\n\nIdle == UNCHANGED vars\n\nNext ==\n  \\/ Idle\n  \\/ \\E s, d \\in Zone : Propose(s, d)\n  \\/ \\E r \\in RM : Prepare(r)\n  \\/ Commit\n  \\/ Abort\n  \\/ \\E z \\in Zone, n \\in 1..MaxCap : Resize(z, n)\n\nSpec == Init /\\ [][Next]_vars\n\nBagConservation == SumOf(Zone) = Total\n====", "module_sha256": "cb2e00379b73e285cd76a024755c357e9947aec239d4b14a74388eb89776c107", "process": {"cleanup_complete": true, "command": ["/lus/grand/projects/EVITA/eric-spencer/tools/jre21/bin/java", "-Djava.io.tmpdir=/home/eric-spencer/tla-fullmodule-structural-curriculum-20260915-v3/result.7624329/sany_reference/54/jtmp", "-DTLA-Lib