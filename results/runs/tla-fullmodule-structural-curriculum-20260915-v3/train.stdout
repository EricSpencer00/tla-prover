ojects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/tla2tools.jar", "tla2sany.SANY", "W4Od18m9p1t2.tla"], "dependency_sha256": {}, "module": "---- MODULE W4Od18m9p1t2 ----\nEXTENDS Naturals\nHubs == {\"h1\", \"h2\"}\nPolicies == {\"day\", \"night\"}\nVARIABLES config, highWater\nvars == <<config, highWater>>\n\nInit ==\n  /\\ config = [policy |-> \"day\", epoch |-> 0]\n  /\\ highWater = 0\n\nReconfigure ==\n  /\\ config.epoch < 3\n  /\\ \\E h \\in Hubs, p \\in Policies :\n       /\\ config' = [policy |-> p, epoch |-> config.epoch + 1]\n  /\\ highWater' = config.epoch + 1\n\nHubHeartbeat ==\n  /\\ config' = config\n  /\\ highWater' = config.epoch\n\nNext == Reconfigure \\/ HubHeartbeat\nSpec == Init /\\ [][Next]_vars\nNoStaleOverwrite == config.epoch >= highWater\n====", "module_sha256": "bad6c0dff5965a7363ecf1abf1a6a3faab714ad81cceff6c88b223cd62dac9fb", "process": {"cleanup_complete": true, "command": ["/lus/grand/projects/EVITA/eric-spencer/tools/jre21/bin/java", "-Djava.io.tmpdir=/home/eric-spencer/tla-fullmodule-structural-curriculum-20260915-v3/result.7624329/sany_reference/45/jtmp", "-DTLA-Library=/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/tlapm/lib/tlapm/stdlib:/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/community-modules:/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/extra-modules", "-cp", "/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/tla2tools.jar", "tla2sany.SANY", "W4Od18m9p1t2.tla"], "containment": "Best-effort ancestry polling; instantaneous unobserved reparenting is not excluded", "cwd": "/home/eric-spencer/tla-fullmodule-structural-curriculum-20260915-v3/result.7624329/sany_reference/45", "errors": [], "execution_complete": true, "output": "\n****** SANY2 Version 2.1 created 24 February 2014\n\nParsing file /home/eric-spencer