cp", "/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/tla2tools.jar", "tla2sany.SANY", "W4Od1m2p2t0.tla"], "dependency_sha256": {}, "module": "---------------------------- MODULE W4Od1m2p2t0 ----------------------------\nEXTENDS Naturals\nTotal   == 4\nTowers  == {\"t1\", \"t2\"}\n\nVARIABLES free, pending, allocated, votes, alive\n\nTypeInv ==\n    /\\ free \\in 0..Total\n    /\\ pending \\in 0..Total\n    /\\ allocated \\in 0..Total\n    /\\ votes \\subseteq Towers\n    /\\ alive \\subseteq Towers\n\nInit ==\n    /\\ free = Total\n    /\\ pending = 0\n    /\\ allocated = 0\n    /\\ votes = {}\n    /\\ alive = Towers\n\nPropose ==\n    /\\ pending = 0\n    /\\ free > 0\n    /\\ free' = free - 1\n    /\\ pending' = 1\n    /\\ votes' = {}\n    /\\ UNCHANGED <<allocated, alive>>\n\nVote(t) ==\n    /\\ pending = 1\n    /\\ t \\in alive\n    /\\ votes' = votes \\cup {t}\n    /\\ UNCHANGED <<free, pending, allocated, alive>>\n\nCommit ==\n    /\\ pending = 1\n    /\\ votes = alive\n    /\\ alive = Towers\n    /\\ pending' = 0\n    /\\ allocated' = allocated + 1\n    /\\ votes' = {}\n    /\\ UNCHANGED <<free, alive>>\n\nAbort ==\n    /\\ pending = 1\n    /\\ pending' = 0\n    /\\ free' = free + 1\n    /\\ votes' = {}\n    /\\ UNCHANGED <<allocated, alive>>\n\nCrash(t) ==\n    /\\ t \\in alive\n    /\\ alive' = alive \\ {t}\n    /\\ UNCHANGED <<free, pending, allocated, votes>>\n\nRelease ==\n    /\\ allocated > 0\n    /\\ allocated' = allocated - 1\n    /\\ free' = free + 1\n    /\\ UNCHANGED <<pending, votes, alive>>\n\nNext ==\n    \\/ Propose \\/ Commit \\/ Abort \\/ Release\n    \\/ \\E t \\in Towers : Vote(t) \\/ Crash(t)\n\nSlotsConserved == free + pending + allocated = Total\n\nvars == <<free, pending, allocated, votes, alive>>\nSpec == Init /\\ [][Next]_vars\n=============================================================================", "module_sha256": "1ae202ef3a51da76886ac4e2e6bf46ad1343d21bebfd1aaf92f4ade3935754e5", "process": {"cleanup_complete": true, "command": ["/lus/grand/projects/EVITA/eric-spencer/tools/jre21/bin/java", "-Djava.io.tmpdir=/home/eric-spencer/tla-fullmodule-structural-curriculum-20260915-v3/result.7624329/sany_reference/62/jtmp", "-DTLA-Library=/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/tlapm/lib/tlapm/stdlib:/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/community-modules:/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/extra-modules", "-cp", "/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/tla2tools.jar", "tla2sany.SANY", "W4Od1m2p2t0.tla"], "containment": "Best-effort ancestry polling; instantaneous unobserved reparenting is not excluded", "cwd": "/home/eric-spencer/tla-fullmodule-structural-curriculum-20260915-v3/result.7624329/sany_reference/62", "errors": [], "execution_complete": true, "output": "\n****** SANY2 Version 2.1 created 24 February 2014\n\nParsing file /home/eric-spencer/tla-fullmodule-structural-curriculum-20260915-v3/result.7624329/sany_reference/62/W4Od1m2p2t0.tla\nParsing file /home/eric-spencer/tla-fullmodule-structural-curriculum-20260915-v3/result.7624329/sany_reference/62/jtmp/Naturals.tla\nSemantic processing of module Naturals\nSemantic processing of module W4Od1m2p2t0\n", "output_complete": true, "output_limit": false, "owned_processes": [{"created": 1789495179.72, "pgid": 303369, "pid": 303369}], "returncode": 0, "root_pid": 303369, "root_reaped": true, "seconds": 0.22603976516984403, "signals": [], "surviving_owned_processes": [], "timed_out": false}, "raw_reply_sha256": "1ae202ef3a51da76886ac4e2e6bf46ad1343d21bebfd1aaf92f4ade3935754e5", "sany": 1, "seconds": 0.23854525806382298, "status": "pass", "syntax_only": true, "task_sha256": "08969326465b5c325024bf869bff6387672b976340f8e71459063dfa5d6b50dd", "timeout_seconds": 30}, "63": {"command": ["/lus/grand/projects/EVITA/eric-spencer/tools/jre21/bin/java", "-Djava.io.tmpdir=/home/eric-spencer/tla-fullmodule-structural-curriculum-20260915-v3/result.7624329/sany_reference/63/jtmp", "-DTLA-Library=/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/tlapm/lib/tlapm/stdlib:/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/community-modules:/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/extra-modules", "-cp", "/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/tla2tools.jar", "tla2sany.SANY", "W4Od6m2p2t3.tla"], "dependency_sha256": {}, "module": "---- MODULE W4Od6m2p2t3 ----\nEXTENDS Naturals\nCONSTANTS f1, f2\nFloors == {f1, f2}\nTOTAL == 2\n\nVARIABLES waiting, car, resv, ph, ready\nvars == <<waiting, car, resv, ph, ready>>\n\nInit ==\n  /\\ waiting = [f \\in Floors |-> 1]\n  /\\ car = 0\n  /\\ resv = [f \\in Floors |-> 0]\n  /\\ ph = \"idle\"\n  /\\ ready = [f \\in Floors |-> FALSE]\n\nBegin ==\n  /\\ ph = \"idle\"\n  /\\ ph' = \"voting\"\n  /\\ ready' = [f \\in Floors |-> FALSE]\n  /\\ UNCHANGED <<waiting, car, resv>>\n\nPrepare(f) ==\n  /\\ ph = \"voting\"\n  /\\ ~ready[f]\n  /\\ waiting[f] >= 1\n  /\\ waiting' = [waiting EXCEPT ![f] = @ - 1]\n  /\\ resv' = [resv EXCEPT ![f] = 1]\n  /\\ ready' = [ready EXCEPT ![f] = TRUE]\n  /\\ UNCHANGED <<car, ph>>\n\nPrepareEmpty(f) ==\n  /\\ ph = \"voting\"\n  /\\ ~ready[f]\n  /\\ waiting[f] = 0\n  /\\ ready' = [ready EXCEPT ![f] = TRUE]\n  /\\ UNCHANGED <<waiting, car, resv, ph>>\n\nCommit ==\n  /\\ ph = \"voting\"\n  /\\ \\A f \\in Floors : ready[f]\n  /\\ car' = car + resv[f1] + resv[f2]\n  /\\ resv' = [f \\in Floors |-> 0]\n  /\\ ph' = \"committed\"\n  /\\ UNCHANGED <<waiting, ready>>\n\nReset ==\n  /\\ ph = \"committed\"\n  /\\ ph' = \"idle\"\n  /\\ UNCHANGED <<waiting, car, resv, ready>>\n\nNext ==\n  \\/ Begin \\/ Commit \\/ Reset\n  \\/ \\E f \\in Floors : Prepare(f) \\/ PrepareEmpty(f)\nSpec == Init /\\ [][Next]_vars\n\nPassengersConserved == (waiting[f1] + waiting[f2]) + (resv[f1] + resv[f2]) + car = TOTAL\n====", "module_sha256": "a7026cc81181b89417536a350a1066cfe041bccdfef129aff30fab675457b697", "process": {"cleanup_complete": true, "command": ["/lus/grand/projects/EVITA/eric-spencer/tools/jre21/bin/java", "-Djava.io.tmpdir=/home/eric-spencer/tla-fullmodule-structural-curriculum-20260915-v3/result.7624329/sany_reference/63/jtmp", "-DTLA-Library=/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/tlapm/lib/tlapm/stdlib:/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/community-modules:/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/extra-modules", "-cp", "/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/tla2tools.jar", "tla2sany.SANY", "W4Od6m2p2t3.tla"], "containment": "Best-effort ancestry polling; instantaneous unobserved reparenting is not excluded", "cwd": "/home/eric-spencer/tla-fullmodule-structural-curriculum-20260915-v3/result.7624329/sany_reference/63", "errors": [], "execution_complete": true, "output": "\n****** SANY2 Version 2.1 created 24 February 2014\n\nParsing file /home/eric-spencer/tla-fullmodule-structural-curriculum-20260915-v3/result.7624329/sany_reference/63/W4Od6m2p2t3.tla\nParsing file /home/eric-spencer/tla-fullmodule-structural-curriculum-20260915-v3/result.7624329/sany_reference/63/jtmp/Naturals.tla\nSemantic processing of module Naturals\nSemantic processing of module W4Od6m2p2t3\n", "output_complete": true, "output_limit": false, "owned_processes": [{"created": 1789495179.97, "pgid": 303393, "pid": 303393}], "returncode": 0, "root_pid": 303393, "root_reaped": true, "seconds": 0.22182608908042312, "signals": [], "surviving_owned_processes": [], "timed_out": false}, "raw_reply_