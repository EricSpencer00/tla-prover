ols/jre21/bin/java", "-Djava.io.tmpdir=/home/eric-spencer/tla-fullmodule-structural-curriculum-20260915-v3/result.7624329/sany_reference/59/jtmp", "-DTLA-Library=/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/tlapm/lib/tlapm/stdlib:/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/community-modules:/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/extra-modules", "-cp", "/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/tla2tools.jar", "tla2sany.SANY", "W4Od17m5p1t1.tla"], "dependency_sha256": {}, "module": "-------------------------------- MODULE W4Od17m5p1t1 --------------------------------\nEXTENDS Naturals, FiniteSets\nCONSTANTS Routers, Pids, MaxVer\nVARIABLES recVer, proposals, ballots, applied\nvars == <<recVer, proposals, ballots, applied>>\n\nOpenPids == { p.pid : p \\in proposals }\nBallotsFor(pid) == { b \\in ballots : b.pid = pid }\nQuorum(pid) == 2 * Cardinality(BallotsFor(pid)) > Cardinality(Routers)\n\nInit ==\n    /\\ recVer = 0\n    /\\ proposals = {}\n    /\\ ballots = {}\n    /\\ applied = {}\n\nPropose(pid) ==\n    /\\ recVer < MaxVer\n    /\\ pid \\notin OpenPids\n    /\\ proposals' = proposals \\union {[pid |-> pid, base |-> recVer]}\n    /\\ UNCHANGED <<recVer, ballots, applied>>\n\nCastBallot(r, pid) ==\n    /\\ pid \\in OpenPids\n    /\\ [pid |-> pid, voter |-> r] \\notin ballots\n    /\\ ballots' = ballots \\union {[pid |-> pid, voter |-> r]}\n    /\\ UNCHANGED <<recVer, proposals, applied>>\n\nCommit(pid) ==\n    /\\ \\E p \\in proposals : p.pid = pid /\\ p.base = recVer\n    /\\ recVer < MaxVer\n    /\\ Quorum(pid)\n    /\\ recVer' = recVer + 1\n    /\\ applied' = applied \\union {pid}\n    /\\ proposals' = { p \\in proposals : p.pid # pid }\n    /\\ ballots' = { b \\in ballots : b.pid # pid }\n\nDiscard(pid) ==\n    /\\ \\E p \\in proposals : p.pid = pid /\\ (p.base # recVer \\/ recVer >= MaxVer)\n    /\\ proposals' = { p \\in proposals : p.pid # pid }\n    /\\ ballots' = { b \\in ballots : b.pid # pid }\n    /\\ UNCHANGED <<recVer, applied>>\n\nRollover ==\n    /\\ recVer >= MaxVer\n    /\\ recVer' = 0\n    /\\ proposals' = {}\n    /\\ ballots' = {}\n    /\\ applied' = {}\n\nNext ==\n    \\/ \\E pid \\in Pids : Propose(pid)\n    \\/ \\E r \\in Routers, pid \\in Pids : CastBallot(r, pid)\n    \\/ \\E pid \\in Pids : Commit(pid)\n    \\/ \\E pid \\in Pids : Discard(pid)\n    \\/ Rollover\n\nSpec == Init /\\ [][Next]_vars\n\nBaseNeverAhead == \\A p \\in proposals : p.base <= recVer\n=============================================================================", "module_sha256": "d363d2179a91f476fe1047e496df3e7cfeae24a54d8422b5672351a8265b6bd7", "process": {"cleanup_complete": true, "command": ["/lus/grand/projects/EVITA/eric-spencer/tools/jre21/bin/java", "-Djava.io.tmpdir=/home/eric-spencer/tla-fullmodule-structural-curriculum-20260915-v3/result.7624329/sany_reference/59/jtmp", "-DTLA-Library=/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/tlapm/lib/tlapm/stdlib:/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/community-modules:/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/extra-modules", "-cp", "/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/tla2tools.jar", "tla2sany.SANY", "W4Od17m5p1t1.tla"], "containment": "Best-effort ancestry polling; instantaneous unobserved reparenting is not excluded", "cwd": "/home/eric-spencer/tla-fullmodule-structural-curriculum-20260915-v3/result.7624329/sany_reference/59", "errors": [], "execution_complete": true, "output": "\n****** SANY2 Version 2.1 created 24 February 2014\n\nParsing file /home/eric-spencer/tla-fullmodule-structural-curriculum-20260915-v3/result.7624329/sany_reference/59/W4Od17m5p1t1.tla\nParsing file /home/eric-spencer/tla-fullmodule-structural-curriculum-20260915-v3/result.7624329/sany_reference/59/jtmp/Naturals.tla\nParsing file /home/eric-spencer/tla-fullmodule-structural-curriculum-20260915-v3/result.7624329/sany_reference/59/jtmp/FiniteSets.tla\nParsing file /home/eric-spencer/tla-fullmodule-structural-curriculum-20260915-v3/result.7624329/sany_reference/59/jtmp/Sequences.tla\nSemantic processing of module Naturals\nSemantic processing of module Sequences\nSemantic processing of module FiniteSets\nSemantic processing of module W4Od17m5p1t1\n", "output_complete": true, "output_limit": false, "owned_processes": [{"created": 1789495178.96, "pgid": 303295, "pid": 303295}], "returncode": 0, "root_pid": 303295, "root_reaped": true, "seconds": 0.24029391002841294, "signals": [], "surviving_owned_processes": [], "timed_out": false}, "raw_reply_sha256": "d363d2179a91f476fe1047e496df3e7cfeae24a54d8422b5672351a8265b6bd7", "sany": 1, "seconds": 0.2540038269944489, "status": "pass", "syntax_only": true, "task_sha256": "19a3080e6bb18951c750cd1cc21798a81e214e8a99dd96342dad8578bceaae49", "timeout_seconds": 30}, "60": {"command": ["/lus/grand/projects/EVITA/eric-spencer/tools/jre21/bin/java", "-Djava.io.tmpdir=/home/eric-spencer/tla-fullmodule-structural-curriculum-20260915-v3/result.7624329/sany_reference/60/jtmp", "-DTLA-Library=/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/tlapm/lib/tlapm/stdlib:/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/community-modules:/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/extra-modules", "-cp", "/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/tla2tools.jar", "tla2sany.SANY", "W4Od14m2p2t1.tla"], "dependency_sha256": {}, "module": "-------------------------- MODULE W4Od14m2p2t1 --------------------------\nEXTENDS Naturals\nCONSTANTS Drones, Budget\n\nVARIABLES phase, vote, tokens, src, dst\n\nvars == <<phase, vote, tokens, src, dst>>\n\nNoDrone == \"none\"\n\nRECURSIVE SumOver(_)\nSumOver(S) ==\n    IF S = {} THEN 0\n    ELSE LET x == CHOOSE y \\in S : TRUE IN tokens[x] + SumOver(S \\ {x})\n\nAllYes == \\A d \\in Drones : vote[d] = \"yes\"\nSomeNo == \\E d \\in Drones : vote[d] = \"no\"\n\nInit ==\n    /\\ phase = \"idle\"\n    /\\ vote = [d \\in Drones |-> \"none\"]\n    /\\ tokens = [d \\in Drones |-> IF d = CHOOSE x \\in Drones : TRUE THEN Budget ELSE 0]\n    /\\ src = NoDrone\n    /\\ dst = NoDrone\n\nBegin(s, t) ==\n    /\\ phase = \"idle\"\n    /\\ s # t\n    /\\ tokens[s] > 0\n    /\\ phase' = \"voting\"\n    /\\ vote' = [d \\in Drones |-> \"none\"]\n    /\\ src' = s\n    /\\ dst' = t\n    /\\ UNCHANGED tokens\n\nVote(d, v) ==\n    /\\ phase = \"voting\"\n    /\\ vote[d] = \"none\"\n    /\\ v \\in {\"yes\", \"no\"}\n    /\\ vote' = [vote EXCEPT ![d] = v]\n    /\\ UNCHANGED <<phase, tokens, src, dst>>\n\nCommit ==\n    /\\ phase = \"voting\"\n    /\\ AllYes\n    /\\ tokens' = [tokens EXCEPT ![src] = @ - 1, ![dst] = @ + 1]\n    /\\ phase' = \"committed\"\n    /\\ UNCHANGED <<vote, src, dst>>\n\nAbort ==\n    /\\ phase = \"voting\"\n    /\\ SomeNo\n    /\\ phase' = \"aborted\"\n    /\\ UNCHANGED <<vote, tokens, src, dst>>\n\nReset ==\n    /\\ phase \\in {\"committed\", \"aborted\"}\n    /\\ phase' = \"idle\"\n    /\\ vote' = [d \\in Drones |-> \"none\"]\n    /\\ src' = NoDrone\n    /\\ dst' = NoDrone\n    /\\ UNCHANGED tokens\n\nNext ==\n    \\/ \\E s, t \\in Drones : Begin(s, t)\n    \\/ \\E d \\in Drones, v \\in {\"yes\", \"no\"} : Vote(d, v)\n    \\/ Commit\n    \\/ Abort\n    \\/ Reset\n\nSpec == Init /\\ [][Next]_vars\n\nTokensConserved == SumOver(Drones) = Budget\n=============================================================================", "module_sha256": "02da4343b3f670e13f69d7a879b102e3988f040a3901f98584a6d2ae4f24e5d5", "process": {"cleanup_complete": true, "command": ["/lus/g