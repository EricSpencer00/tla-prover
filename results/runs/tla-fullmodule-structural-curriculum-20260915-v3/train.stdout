Drones : holds[d] # NONE => assign[holds[d]] = d\n====", "module_sha256": "8be5178f8ac92665e3ec72ab2e71d7252a97ac4bfe0cb54e3e558600fcfce314", "process": {"cleanup_complete": true, "command": ["/lus/grand/projects/EVITA/eric-spencer/tools/jre21/bin/java", "-Djava.io.tmpdir=/home/eric-spencer/tla-fullmodule-structural-curriculum-20260915-v3/result.7624329/sany_reference/55/jtmp", "-DTLA-Library=/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/tlapm/lib/tlapm/stdlib:/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/community-modules:/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/extra-modules", "-cp", "/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/tla2tools.jar", "tla2sany.SANY", "W4Od14m8p3t1.tla"], "containment": "Best-effort ancestry polling; instantaneous unobserved reparenting is not excluded", "cwd": "/home/eric-spencer/tla-fullmodule-structural-curriculum-20260915-v3/result.7624329/sany_reference/55", "errors": [], "execution_complete": true, "output": "\n****** SANY2 Version 2.1 created 24 February 2014\n\nParsing file /home/eric-spencer/tla-fullmodule-structural-curriculum-20260915-v3/result.7624329/sany_reference/55/W4Od14m8p3t1.tla\nSemantic processing of module W4Od14m8p3t1\n", "output_complete": true, "output_limit": false, "owned_processes": [{"created": 1789495177.98, "pgid": 303195, "pid": 303195}], "returncode": 0, "root_pid": 303195, "root_reaped": true, "seconds": 0.21595224714837968, "signals": [], "surviving_owned_processes": [], "timed_out": false}, "raw_reply_sha256": "8be5178f8ac92665e3ec72ab2e71d7252a97ac4bfe0cb54e3e558600fcfce314", "sany": 1, "seconds": 0.22723397007212043, "status": "pass", "syntax_only": true, "task_sha256": "5b66845d6599c787f99d4fc143c9d64daa9fd69de04266fd9de65e5c6a0b16db", "timeout_seconds": 30}, "56": {"command": ["/lus/grand/projects/EVITA/eric-spencer/tools/jre21/bin/java", "-Djava.io.tmpdir=/home/eric-spencer/tla-fullmodule-structural-curriculum-20260915-v3/result.7624329/sany_reference/56/jtmp", "-DTLA-Library=/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/tlapm/lib/tlapm/stdlib:/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/community-modules:/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/extra-modules", "-cp", "/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/tla2tools.jar", "tla2sany.SANY", "W4Od16m3p3t1.tla"], "dependency_sha256": {}, "module": "-------------------------- MODULE W4Od16m3p3t1 --------------------------\nEXTENDS Naturals\nCONSTANTS Nodes, Slots, Scripts, MaxTerm\nASSUME MaxTerm \\in Nat\n\nVARIABLES term, leader, owner, requests, log\nvars == <<term, leader, owner, requests, log>>\n\nNone == \"none\"\nBump(t) == IF t < MaxTerm THEN t + 1 ELSE t\n\nReqs == [script : Scripts, slot : Slots]\nEntries == [slot : Slots, script : Scripts, term : 0..MaxTerm]\n\nTypeOK ==\n  /\\ term \\in 0..MaxTerm\n  /\\ leader \\in (Nodes \\cup {None})\n  /\\ owner \\in [Slots -> (Scripts \\cup {None})]\n  /\\ requests \\in SUBSET Reqs\n  /\\ log \\in SUBSET Entries\n\nAllocated(sc) == \\E s \\in Slots : owner[s] = sc\n\nInit ==\n  /\\ term = 0\n  /\\ leader = None\n  /\\ owner = [s \\in Slots |-> None]\n  /\\ requests = {}\n  /\\ log = {}\n\nElectLeader(n) ==\n  /\\ leader = None\n  /\\ leader' = n\n  /\\ term' = Bump(term)\n  /\\ UNCHANGED <<owner, requests, log>>\n\nFailLeader(n) ==\n  /\\ leader = n\n  /\\ leader' = None\n  /\\ UNCHANGED <<term, owner, requests, log>>\n\nSubmitRequest(sc, s) ==\n  /\\ ~Allocated(sc)\n  /\\ [script |-> sc, slot |-> s] \\notin requests\n  /\\ requests' = requests \\cup {[script |-> sc, slot |-> s]}\n  /\\ UNCHANGED <<term, leader, owner, log>>\n\n\\* Leader allocates a free slot; reordered requests handled in any order.\nAllocate(r) ==\n  /\\ leader # None\n  /\\ r \\in requests\n  /\\ owner[r.slot] = None\n  /\\ ~Allocated(r.script)\n  /\\ owner' = [owner EXCEPT ![r.slot] = r.script]\n  /\\ log' = log \\cup {[slot |-> r.slot, script |-> r.script, term |-> term]}\n  /\\ requests' = requests \\ {r}\n  /\\ UNCHANGED <<term, leader>>\n\nRejectRequest(r) ==\n  /\\ r \\in requests\n  /\\ owner[r.slot] # None\n  /\\ requests' = requests \\ {r}\n  /\\ UNCHANGED <<term, leader, owner, log>>\n\nNext ==\n  \\/ \\E n \\in Nodes : ElectLeader(n) \\/ FailLeader(n)\n  \\/ \\E sc \\in Scripts, s \\in Slots : SubmitRequest(sc, s)\n  \\/ \\E r \\in requests : Allocate(r) \\/ RejectRequest(r)\n\nSpec == Init /\\ [][Next]_vars\n\n\\* The allocation log is functional on slots: one slot never maps to two scripts.\nNoDoubleAllocation ==\n  \\A e1, e2 \\in log : (e1.slot = e2.slot) => (e1.script = e2.script)\n=============================================================================", "module_sha256": "370c233b2b83340ab9973c1ce2420a930786fcb80e56c3c33a7db179ab2ce6ff", "process": {"cleanup_complete": true, "command": ["/lus/grand/projects/EVITA/eric-spencer/tools/jre21/bin/java", "-Djava.io.tmpdir=/home/eric-spencer/tla-fullmodule-structural-curriculum-20260915-v3/result.7624329/sany_reference/56/jtmp", "-DTLA-Library=/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/tlapm/lib/tlapm/stdlib:/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/community-modules:/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/extra-modules", "-cp", "/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/tla2tools.jar", "tla2sany.SANY", "W4Od16m3p3t1.tla"], "containment": "Best-effort ancestry polling; instantaneous unobserved reparenting is not excluded", "cwd": "/home/eric-spencer/tla-fullmodule-structural-curriculum-20260915-v3/result.7624329/sany_reference/56", "errors": [], "execution_complete": true, "output": "\n****** SANY2 Version 2.1 created 24 February 2014\n\nParsing file /home/eric-spencer/tla-fullmodule-structural-curriculum-20260915-v3/result.7624329/sany_reference/56/W4Od16m3p3t1.tla\nParsing file /home/eric-spencer/tla-fullmodule-structural-curriculum-20260915-v3/result.7624329/sany_reference/56/jtmp/Naturals.tla\nSemantic processing of module Naturals\nSemantic processing of module W4Od16m3p3t1\n", "output_complete": true, "output_limit": false, "owned_processes": [{"created": 1789495178.22, "pgid": 303222, "pid": 303222}], "returncode": 0, "root_pid": 303222, "root_reaped": true, "seconds": 0.22823302913457155, "signals": [], "surviving_owned_processes": [], "timed_out": false}, "raw_reply_sha256": "370c233b2b83340ab9973c1ce2420a930786fcb80e56c3c33a7db179ab2ce6ff", "sany": 1, "seconds": 0.24061573296785355, "status": "pass", "syntax_only": true, "task_sha256": "8283827e40011ae8a07b29413a269796bc6dddc76589783e6c929460642012d9", "timeout_seconds": 30}, "57": {"command": ["/lus/grand/projects/EVITA/eric-spencer/tools/jre21/bin/java", "-Djava.io.tmpdir=/home/eric-spencer/tla-fullmodule-structural-curriculum-20260915-v3/result.7624329/sany_reference/57/jtmp", "-DTLA-Library=/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/tlapm/lib/tlapm/stdlib:/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/community-modules:/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/extra-modules", "-cp", "/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/tla2tools.jar", "tla2sany.SANY", "W4Od12m1p6t5.tla"], "dependency_sha256": {}, "module": "---- MODULE W4Od12m1p6t5 ----\nEXTENDS Integers\nCONSTANTS CAP, MAXGEN\nASSUME CAP \\in Nat /\\ MAXGEN \\in Nat\n\nTrackers == {\"b1\", \"b2\", \"b3\"}\nNextR(t) == CASE t = \"b1\" -> \"b2\"\n              [] t = \"b2\" -> \"b3\"\n              [] OTHER    -> \"b1\"\n\nVARIABLES tokenHolder, tokenGen, phase, usedGen, stock\nvars == <<tokenHolder, tokenGen, phase, usedGen, stock>>\n\nInit == /\\ tokenHolder = \"b1\"\n        /\\ tokenGen = 0\n        /\\ phase = [t \\in Trackers |-> \"idle\"]\n        /\\ usedGen = [t \\in Trackers |-> -1]\n        /\\ stock = 0\n\nPass(t) == /\\ tokenHolder = t\n           /\\ phase[t] = \"idle\"\n           /\\ tokenHolder' = NextR(t)\n           /\\ UNCHANGED <<tokenGen, phase, usedGen, stock>>\n\nArm(t) == /\\ tokenHolder = t\n          /\\ phase[t] = \"idle\"\n          /\\ phase' = [phase EXCEPT ![t] = \"armed\"]\n          /\\ usedGen' = [usedGen EXCEPT ![t] = tokenGen]\n          /\\ UNCHANGED <<tokenHolder, tokenGen, stock>>\n\nWrite(t) == /\\ tokenHolder = t\n            /\\ phase[t] = \"armed\"\n            /\\ usedGen[t] = tokenGen\n            /\\ stock < CAP\n            /\\ phase' = [phase EXCEPT ![t] = \"writing\"]\n            /\\ stock' = stock + 1\n            /\\ UNCHANGED <<tokenHolder, tokenGen, usedGen>>\n\nFinish(t) == /\\ phase[t] = \"writing\"\n             /\\ phase' = [phase EXCEPT ![t] = \"idle\"]\n             /\\ usedGen' = [usedGen EXCEPT ![t] = -1]\n             /\\ UNCHANGED <<tokenHolder, tokenGen, stock>>\n\nDropStale(t) == /\\ phase[t] \\in {\"armed\", \"writing\"}\n                /\\ (tokenHolder # t \\/ usedGen[t] # tokenGen)\n                /\\ phase' = [phase EXCEPT ![t] = \"idle\"]\n                /\\ usedGen' = [usedGen EXCEPT ![t] = -1]\n                /\\ UNCHANGED <<tokenHolder, tokenGen, stock>>\n\nAdminRevoke == /\\ tokenGen' = IF tokenGen < MAXGEN THEN tokenGen + 1 ELSE tokenGen\n               /\\ phase' = [t \\in Trackers |-> \"idle\"]\n               /\\ usedGen' = [t \\in Trackers |-> -1]\n               /\\ \\E e \\in Trackers : tokenHolder' = e\n               /\\ UNCHANGED stock\n\nNext == \\/ \\E t \\in Trackers : Pass(t) \\/ Arm(t) \\/ Write(t) \\/ Finish(t) \\/ DropStale(t)\n        \\/ AdminRevoke\n\nSpec == Init /\\ [][Next]_vars\n\nNoUnauthorizedWriter ==\n    \\A t \\in Trackers :\n        phase[t] \\in {\"armed\", \"writing\"} =>\n            (tokenHolder = t /\\ usedGen[t] = tokenGen)\n====", "module_sha256": "cc4e338038b796251b2e1a98e7482a75b910e6cbfceb953beb9d0ca24796e686", "process": {"cleanup_complete": true, "command": ["/lus/grand/projects/EVITA/eric-spencer/tools/jre21/bin/java", "-Djava.io.tmpdir=/home/eric-spencer/tla-fullmodule-structural-curriculum-20260915-v3/result.7624329/sany_reference/57/jtmp", "-DTLA-Library=/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/tlapm/lib/tlapm/stdlib:/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/community-modules:/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/extra-modules", "-cp", "/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/tla2tools.jar", "tla2sany.SANY", "W4Od12m1p6t5.tla"], "containment": "Best-effort ancestry polling; instantaneous unobserved reparenting is not excluded", "cwd": "/home/eric-spencer/tla-fullmodule-structural-curriculum-20260915-v3/result.7624329/sany_reference/57", "errors": [], "execution_complete": true, "output": "\n****** SANY2 Version 2.1 created 24 February 2014\n\nParsing file /home/eric-spencer/tla-fullmodule-structural-curriculum-20260915-v3/result.7624329/sany_reference/57/W4Od12m1p6t5.tla\nParsing file /home/eric-spencer/tla-fullmodule-structural-curriculum-20260915-v3/result.7624329/sany_reference/57/jtmp/Integers.tla\nParsing file /home/eric-spencer/tla-fullmodule-structural-curriculum-20260915-v3/result.7624329/sany_reference/57/jtmp/Naturals.tla\nSemantic processing of module Naturals\nSemantic processing of module Integers\nSemantic processing of module W4Od12m1p6t5\n", "output_complete": true, "output_limit": 