se, "generated_feedback_loaded": false, "input_sha256": "a125a0d5bf66dedfb664c692c69dcd612181a8b7ac316c264075ca434061ce6c", "kind": "fullmodule_clean_structural_length_curriculum", "nonvacuity_claim": false, "proof_claim": false, "protected_candidate_sany_pass": {"107": false, "47": false}, "protected_reference_sany_pass": {"107": true, "47": true}, "protected_targets_never_train": true, "quality_claim": false, "references": {"107": {"command": ["/lus/grand/projects/EVITA/eric-spencer/tools/jre21/bin/java", "-Djava.io.tmpdir=/home/eric-spencer/tla-fullmodule-structural-curriculum-20260915-v3/result.7624329/sany_reference/107/jtmp", "-DTLA-Library=/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/tlapm/lib/tlapm/stdlib:/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/community-modules:/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/extra-modules", "-cp", "/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/tla2tools.jar", "tla2sany.SANY", "W4Od3m0p0t0.tla"], "dependency_sha256": {}, "module": "---- MODULE W4Od3m0p0t0 ----\nEXTENDS Integers\n\nBanks == {\"b1\", \"b2\", \"b3\"}\nNONE == \"none\"\n\nVARIABLES lock, status, snap, ledger\nvars == <<lock, status, snap, ledger>>\n\nInit ==\n    /\\ lock = NONE\n    /\\ status = [b \\in Banks |-> \"idle\"]\n    /\\ snap = [b \\in Banks |-> NONE]\n    /\\ ledger = NONE\n\nRead(b) ==\n    /\\ status[b] = \"idle\"\n    /\\ status' = [status EXCEPT ![b] = \"trying\"]\n    /\\ snap' = [snap EXCEPT ![b] = lock]\n    /\\ UNCHANGED <<lock, ledger>>\n\nAcquire(b) ==\n    /\\ status[b] = \"trying\"\n    /\\ snap[b] = NONE\n    /\\ lock = NONE\n    /\\ lock' = b\n    /\\ status' = [status EXCEPT ![b] = \"cs\"]\n    /\\ UNCHANGED <<snap, ledger>>\n\nRetry(b) ==\n    /\\ status[b] = \"trying\"\n    /\\ snap[b] # lock\n    /\\ snap' = [snap EXCEPT ![b] = lock]\n    /\\ UNCHANGED <<lock, status, ledger>>\n\nExit(b) ==\n    /\\ status[b] = \"cs\"\n    /\\ lock = b\n    /\\ lock' = NONE\n    /\\ status' = [status EXCEPT ![b] = \"idle\"]\n    /\\ ledger' = b\n    /\\ UNCHANGED snap\n\nCrash(b) ==\n    /\\ status[b] # \"crashed\"\n    /\\ status' = [status EXCEPT ![b] = \"crashed\"]\n    /\\ UNCHANGED <<lock, snap, ledger>>\n\nRecover(b) ==\n    /\\ status[b] = \"crashed\"\n    /\\ status' = [status EXCEPT ![b] = \"idle\"]\n    /\\ lock' = IF lock = b THEN NONE ELSE lock\n    /\\ snap' = [snap EXCEPT ![b] = NONE]\n    /\\ UNCHANGED ledger\n\nNext ==\n    \\/ \\E b \\in Banks : Read(b)\n    \\/ \\E b \\in Banks : Acquire(b)\n    \\/ \\E b \\in Banks : Retry(b)\n    \\/ \\E b \\in Banks : Exit(b)\n    \\/ \\E b \\in Banks : Crash(b)\n    \\/ \\E b \\in Banks : Recover(b)\n\nSpec == Init /\\ [][Next]_vars\n\nTypeOK ==\n    /\\ lock \\in Banks \\cup {NONE}\n    /\\ status \\in [Banks -> {\"idle\",\"trying\",\"cs\",\"crashed\"}]\n    /\\ snap \\in [Banks -> Banks \\cup {NONE}]\n    /\\ ledger \\in Banks \\cup {NONE}\n\nMutEx ==\n    \\A b \\in Banks : (status[b] = \"cs\") => (lock = b)\n\n====", "module_sha256": "5f6b169dc010369d4e6f65b7766b7961e44a4df15790988c5763861a06e3e853", "process": {"cleanup_complete": true, "command": ["/lus/grand/projects/EVITA/eric-spencer/tools/jre21/bin/java", "-Djava.io.tmpdir=/home/eric-spencer/tla-fullmodule-structural-curriculum-20260915-v3/result.7624329/sany_reference/107/jtmp", "-DTLA-Library=/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/tlapm/lib/tlapm/stdlib:/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/community-modules:/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/extra-modules", "-cp", "/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/tla2tools.jar", "tla2sany.SANY", "W4Od3m0p0t0.tla"], "containment": "Best-effort ancestry polling; instantaneous unobserved reparenting is not excluded", "cwd": "/home/eric-spencer/tla-fullmodule-structural-curriculum-20260915-v3/result.7624329/sany_reference/107", "errors": [], "execution_complete": true, "output": "\n****** SANY2 Version 2.1 created 24 February 2014\n\nParsing file /home/eric-spencer/tla-fullmodule-structural-curriculum-20260915-v3/result.7624329/sany_reference/107/W4Od3m0p0t0.tla\nParsing file /home/eric-spencer/tla-fullmodule-structural-curriculum-20260915-v3/result.7624329/sany_reference/107/jtmp/Integers.tla\nParsing file /home/eric-spencer/tla-fullmodule-structural-curriculum-20260915-v3/result.7624329/sany_reference/107/jtmp/Naturals.tla\nSemantic processing of module Naturals\nSemantic processing of module Integers\nSemantic processing of module W4Od3m0p0t0\n", "output_complete": true, "output_limit": false, "owned_processes": [{"created": 1789495180.68, "pgid": 303468, "pid": 303468}], "returncode": 0, "root_pid": 303468, "root_reaped": true, "seconds": 0.22278800909407437, "signals": [], "surviving_owned_processes": [], "timed_out": false}, "raw_reply_sha256": "5f6b169dc010369d4e6f65b7766b7961e44a4df15790988c5763861a06e3e853", "sany": 1, "seconds": 0.23431208496913314, "status": "pass", "syntax_only": true, "task_sha256": "d29a5c54e17b31913ab9725791f6820539ae59361587c8f60c08f4a075723c33", "timeout_seconds": 30}, "42": {"command": ["/lus/grand/projects/EVITA/eric-spencer/tools/jre21/bin/java", "-Djava.io.tmpdir=/home/eric-spencer/tla-fullmodule-structural-curriculum-20260915-v3/result.7624329/sany_reference/42/jtmp", "-DTLA-Library=/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/tlapm/lib/tlapm/stdlib:/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/community-modules:/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/extra-modules", "-cp", "/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/tla2tools.jar", "tla2sany.SANY", "W4Od14m4p0t4.tla"], "dependency_sha256": {}, "module": "---- MODULE W4Od14m4p0t4 ----\nEXTENDS Integers\nVARIABLES holders, queue, cap\nInit == holders = 0 /\\ queue = 0 /\\ cap = 2\nGrab == holders = 0 /\\ holders' = (holders) + 1 /\\ UNCHANGED <<queue, cap>>\nRelease == holders > 0 /\\ holders' = holders - 1 /\\ UNCHANGED <<queue, cap>>\nEnqueue == queue < cap /\\ queue' = queue + 1 /\\ UNCHANGED <<holders, cap>>\nDrain == queue > 0 /\\ queue' = queue - 1 /\\ UNCHANGED <<holders, cap>>\nReconfig == \\E c \\in {2, 3} : c >= queue /\\ cap' = c /\\ UNCHANGED <<holders, queue>>\nNext == Grab \\/ Release \\/ Enqueue \\/ Drain \\/ Reconfig\nSpec == Init /\\ [][Next]_<<holders, queue, cap>>\nExclusiveDownlink == holders >= 0 /\\ holders <= 1 /\\ queue >= 0 /\\ queue <= cap\n====", "module_sha256": "39d35a34deda13d950e72efaf0641e1d6c0ef980a9d75bd8260a57290be1c910", "process": {"cleanup_complete": true, "command": ["/lus/grand/projects/EVITA/eric-spencer/tools/jre21/bin/java", "-Djava.io.tmpdir=/home/eric-spencer/tla-fullmodule-structural-curriculum-20260915-v3/result.7624329/sany_reference/42/jtmp", "-DTLA-Library=/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/tlapm/lib/tlapm/stdlib:/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/community-modules:/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/extra-modules", "-cp", "/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/tla2tools.jar", "tla2sany.SANY", "W4Od14m4p0t4.tla"], "containment": "Best-effort ancestry polling; instantaneous unobserved reparenting is not excluded", "cwd": "/home/eric-spencer/tla-fullmodule-structural-curriculum-20260915-v3/result.7624329/sany_reference/42", "errors": [], "execution_complete": true, "output": "\n****** SANY2 Version 2.1 created 24 February 2014\n\nParsing file /home/eric-spencer/tla-fullmodule-structural-curriculum-20260915-v3/result.7624329/sany_reference/42/W4Od14m4p0t4.tla\nParsing file /home/eric-spencer/tla-fullmodule-structural-curriculum-20260915-v3/result.7624329/sany_reference/42/jtmp/Integers.tla\nParsing file /home/eric-spencer/tla-fullmodule-structural-curriculum-20260915-v3/result.7624329/sany_reference/42/jtmp/Naturals.tla\nSemantic processing of module Naturals\nSemantic processing of module Integers\nSemantic processing of module W4Od14m4p0t4\n", "output_complete": true, "output_limit": false, "owned_processes": [{"created": 1789495175.09, "pgid": 302898, "pid": 302898}], "returncode": 0, "root_pid": 302898, "root_reaped": true, "seconds": 0.29627580498345196, "signals": [], "surviving_owned_processes": [], "timed_out": false}, "raw_reply_sha256": "39d35a34deda13d950e72efaf0641e1d6c0ef980a9d75bd8260a57290be1c910", "sany": 1, "seconds": 0.3062417460605502, "status": "pass", "syntax_only": true, "task_sha256": "42855a304b10e252033690543fe878eb5963860cb2cf762987bdc33e5ad41349", "timeout_seconds": 30}, "43": {"command": ["/lus/grand/projects/EVITA/eric-spencer/tools/jre21/bin/java", "-Djava.io.tmpdir=/home/eric-spencer/tla-fullmodule-structural-curriculum-20260915-v3/result.7624329/sany_reference/43/jtmp", "-DTLA-Library=/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/tlapm/lib/tlapm/stdlib:/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/community-modules:/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/extra-modules", "-cp", "/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/tla2tools.jar", "tla2sany.SANY", "W4Od13m7p1t4.tla"], "dependency_sha256": {}, "module": "------------------------- MODULE W4Od13m7p1t4 -------------------------\n(* Vending-machine network with a shared restock record held in a\n   compare-and-swap register.  Each restock reads the record's current value\n   as its expected value, then does a CAS that writes value+1 only if the\n   register still holds that expected value; a CAS whose expectation no longer\n   matches has been raced and is discarded, so it can never overwrite and lose\n   a concurrent restock.  The shelf capacity can change at runtime but never\n   drops below the current record.  We count accepted restocks; safety: the\n   record equals the number of accepted restocks, so no restock is lost. *)\nEXTENDS Naturals\n\nMaxCap == 3\n\nVARIABLES record, inflight, numUpdates, capacity\n\nTypeInv ==\n    /\\ record \\in 0..MaxCap\n    /\\ inflight \\subseteq [expect : 0..MaxCap]\n    /\\ numUpdates \\in 0..MaxCap\n    /\\ capacity \\in 1..MaxCap\n\nInit ==\n    /\\ record = 0\n    /\\ inflight = {}\n    /\\ numUpdates = 0\n    /\\ capacity = 1\n\nBeginCAS ==\n    /\\ inflight' = inflight \\union {[expect |-> record]}\n    /\\ UNCHANGED <<record, numUpdates, capacity>>\n\nCommitCAS(op) ==\n    /\\ op \\in inflight\n    /\\ op.expect = record\n    /\\ record < capacity\n    /\\ record' = op.expect + 1\n    /\\ numUpdates' = numUpdates + 1\n    /\\ inflight' = inflight \\ {op}\n    /\\ UNCHANGED capacity\n\nFailCAS(op) ==\n    /\\ op \\in inflight\n    /\\ op.expect # record\n    /\\ inflight' = inflight \\ {op}\n    /\\ UNCHANGED <<record, numUpdates, capacity>>\n\nResize ==\n    /\\ \\E c \\in 1..MaxCap :\n        /\\ c >= record\n        /\\ capacity' = c\n    /\\ UNCHANGED <<record, inflight, numUpdates>>\n\nNext ==\n    \\/ BeginCAS\n    \\/ \\E op \\in inflight : CommitCAS(op)\n    \\/ \\E op \\in inflight : FailCAS(op)\n    \\/ Resize\n\nNoLostUpdates == record = numUpdates\n\nvars == <<record, inflight, numUpdates, capacity>>\nSpec == Init /\\ [][Next]_vars\n=======================================================================", "module_sha256": "0adf63f07aa9367cc90de5f7d12d0be303549f42c660729dfa6e10620f1c8194", "process": {"cleanup_complete": true, "command": ["/lus/grand/projects/EVITA/eric-spencer/tools/jre21/bin/java", "-Djava.io.tmpdir=/home/eric-spencer/tla-fullmodule-structural-curriculum-20260915-v3/result.7624329/sany_reference/43/jtmp", "-DTLA-Library=/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/tlapm/lib/tlapm/stdlib:/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/community-modules:/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/extra-modules", "-cp", "/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/tla2tools.jar", "tla2sany.SANY", "W4Od13m7p1t4.tla"], "containment": "Best-effort ancestry polling; instantaneous unobserved reparenting is not excluded", "cwd": "/home/eric-spencer/tla-fullmodule-structural-curriculum-20260915-v3/result.7624329/sany_reference/43", "errors": [], "execution_complete": true, "output": "\n****** SANY2 Version 2.1 created 24 February 2014\n\nParsing file /home/eric-spencer/tla-fullmodule-structural-curriculum-20260915-v3/result.7624329/sany_reference/43/W4Od13m7p1t4.tla\nParsing file /home/eric-spencer/tla-fullmodule-structural-curriculum-20260915-v3/result.7624329/sany_reference/43/jtmp/Naturals.tla\nSemantic processing of module Naturals\nSemantic processing of module W4Od13m7p1t4\n", "output_complete": true, "output_limit": false, "owned_processes": [{"created": 1789495175.4, "pgid": 302924, "pid": 302924}], "returncode": 0, "root_pid": 302924, "root_reaped": true, "seconds": 0.22310430090874434, "signals": [], "surviving_owned_processes": [], "timed_out": false}, "raw_reply_sha256": "0adf63f07aa9367cc90de5f7d12d0be303549f42c660729dfa6e10620f1c8194", "sany": 1, "seconds": 0.23439403902739286, "status": "pass", "syntax_only": true, "task_sha256": "30d80ad2afb6aee235a8197b0ba6ba496d16144dcc9012d01a467edb8d8c65a6", "timeout_seconds"