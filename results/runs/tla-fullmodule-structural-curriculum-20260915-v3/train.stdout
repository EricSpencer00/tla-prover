21/bin/java", "-Djava.io.tmpdir=/home/eric-spencer/tla-fullmodule-structural-curriculum-20260915-v3/result.7624329/sany_reference/61/jtmp", "-DTLA-Library=/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/tlapm/lib/tlapm/stdlib:/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/community-modules:/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/extra-modules", "-cp", "/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/tla2tools.jar", "tla2sany.SANY", "W4Od18m8p6t4.tla"], "dependency_sha256": {}, "module": "---- MODULE W4Od18m8p6t4 ----\nEXTENDS Naturals, FiniteSets\nCONSTANTS Residents, Doors, MaxEpoch\nNone == \"none\"\nVARIABLES zoneOwner, doorOwner, epoch, cred, capacity\nvars == <<zoneOwner, doorOwner, epoch, cred, capacity>>\n\nLocked == {d \\in Doors : doorOwner[d] # None}\n\nTypeInv ==\n    /\\ zoneOwner \\in Residents \\cup {None}\n    /\\ doorOwner \\in [Doors -> Residents \\cup {None}]\n    /\\ epoch \\in 0..MaxEpoch\n    /\\ cred \\in [Residents -> 0..MaxEpoch]\n    /\\ capacity \\in 1..Cardinality(Doors)\n\nInit ==\n    /\\ zoneOwner = None\n    /\\ doorOwner = [d \\in Doors |-> None]\n    /\\ epoch = 0\n    /\\ cred = [p \\in Residents |-> 0]\n    /\\ capacity = Cardinality(Doors)\n\nAcquireZone(p) ==\n    /\\ zoneOwner = None\n    /\\ cred[p] = epoch\n    /\\ zoneOwner' = p\n    /\\ UNCHANGED <<doorOwner, epoch, cred, capacity>>\n\nReleaseZone(p) ==\n    /\\ zoneOwner = p\n    /\\ \\A d \\in Doors : doorOwner[d] # p\n    /\\ zoneOwner' = None\n    /\\ UNCHANGED <<doorOwner, epoch, cred, capacity>>\n\nLockDoor(p, d) ==\n    /\\ zoneOwner = p\n    /\\ cred[p] = epoch\n    /\\ doorOwner[d] = None\n    /\\ Cardinality(Locked) < capacity\n    /\\ doorOwner' = [doorOwner EXCEPT ![d] = p]\n    /\\ UNCHANGED <<zoneOwner, epoch, cred, capacity>>\n\nUnlockDoor(p, d) ==\n    /\\ doorOwner[d] = p\n    /\\ doorOwner' = [doorOwner EXCEPT ![d] = None]\n    /\\ UNCHANGED <<zoneOwner, epoch, cred, capacity>>\n\nRefresh(p) ==\n    /\\ cred[p] # epoch\n    /\\ cred' = [cred EXCEPT ![p] = epoch]\n    /\\ UNCHANGED <<zoneOwner, doorOwner, epoch, capacity>>\n\nRotateEpoch ==\n    /\\ epoch < MaxEpoch\n    /\\ epoch' = epoch + 1\n    /\\ zoneOwner' = None\n    /\\ doorOwner' = [d \\in Doors |-> None]\n    /\\ UNCHANGED <<cred, capacity>>\n\nChangeCapacity ==\n    /\\ \\E c \\in 1..Cardinality(Doors) : capacity' = c\n    /\\ UNCHANGED <<zoneOwner, doorOwner, epoch, cred>>\n\nNext ==\n    \\/ \\E p \\in Residents : AcquireZone(p) \\/ ReleaseZone(p) \\/ Refresh(p)\n    \\/ \\E p \\in Residents, d \\in Doors : LockDoor(p, d) \\/ UnlockDoor(p, d)\n    \\/ RotateEpoch \\/ ChangeCapacity\n\nSpec == Init /\\ [][Next]_vars\n\nHierarchyAuthorized ==\n    \\A d \\in Doors :\n        doorOwner[d] # None =>\n            /\\ doorOwner[d] = zoneOwner\n            /\\ cred[doorOwner[d]] = epoch\n====", "module_sha256": "c3706eff466c602ba477bfb7b53c83ded57353df7aa2daa17d6af0f69c9a02e6", "process": {"cleanup_complete": true, "command": ["/lus/grand/projects/EVITA/eric-spencer/tools/jre21/bin/java", "-Djava.io.tmpdir=/home/eric-spencer/tla-fullmodule-structural-curriculum-20260915-v3/result.7624329/sany_reference/61/jtmp", "-DTLA-Library=/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/tlapm/lib/tlapm/stdlib:/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/community-modules:/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/extra-modules", "-cp", "/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tools/tla2tools.jar", "tla2sany.SANY", "W4Od18m8p6t4.tla"], "containment": "Best-effort ancestry polling; instantaneous unobserved reparenting is not excluded", "cwd": "/home/eric-spencer/tla-fullmodule-structural-c