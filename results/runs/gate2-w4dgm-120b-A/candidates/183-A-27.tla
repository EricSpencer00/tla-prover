---- MODULE TLAPS ----
EXTENDS Naturals

(* Backend provers for the TLA+ Proof System (TLAPS).  These operators are     *)
(* configuration entries naming the provers TLAPS may dispatch obligations to.  *)
(* They are included here together with the naming of the core temporal logic  *)
(* proof rules so that every reserved name appears in this module.              *)

CONSTANTS Zenon, Isabelle, CVC3, Yices, Verit, Z3, SPASS, LS4

(* Name of the prover used to discharge obligations generated by the           *)
(* invariance proof rule.                                                       *)
InvarianceProver == Zenon

(* Name of the prover used to discharge obligations generated by the           *)
(* well-formedness proof rules.                                                 *)
WellFormednessProver == Isabelle

(* Name of the prover used to discharge obligations generated by the           *)
(* strong-fairness and weak-fairness proof rules.                              *)
FairnessProver == SPASS

(* Name of the prover used to discharge obligations generated by the           *)
(* step-simulation proof rule.                                                 *)
SimulationProver == LS4

(* The module declares the set-extensionality theorem and the 'no set         *)
(* contains everything' theorem as its two invariant properties.              *)

AllSetsEqualIfSameElements == (x = y) <=> (\A z \in {x, y} : z \in x <=> z \in y)

NoSetContainsAll == \A x \in SUBSET Nat : \E y \in SUBSET Nat : x # y

(* No state or action exists in this module; it only holds the backend          *)
(* configuration and the statement of the two theorems.                         *)
====