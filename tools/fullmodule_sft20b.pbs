#!/bin/bash
#PBS -A EVITA
#PBS -q by-gpu
#PBS -N tla-fullmodule-sft20-map
#PBS -l select=1:ngpus=4:ncpus=64:mem=256gb
#PBS -l place=pack:shared
#PBS -l walltime=01:00:00
#PBS -l filesystems=home:grand
#PBS -j oe
set -euo pipefail
exec > "/home/eric-spencer/fullmodule_sft20b.${PBS_JOBID%%.*}.log" 2>&1
module load conda/2026-06-08 >/dev/null 2>&1
conda activate base >/dev/null 2>&1
export HF_HUB_OFFLINE=1 HF_HOME=/grand/EVITA/eric-spencer/hf-cache
export OMP_NUM_THREADS=4 OPENBLAS_NUM_THREADS=4 MKL_NUM_THREADS=4 NUMEXPR_NUM_THREADS=4
export PYTHONUNBUFFERED=1 TOKENIZERS_PARALLELISM=false
BASE=/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1
MODEL=/grand/EVITA/eric-spencer/hf-cache/hub/models--EricSpencer00--chattla-20b/snapshots/c1a3e8b5c6916ce4a0ed830e996662ca28e0a262
OUT=$BASE/results/runs/fullmodule-sft20b-$(date +%Y%m%d-%H%M%S)-${PBS_JOBID%%.*}
cd "$BASE"
python tools/fullmodule_sft20b.py --model "$MODEL" --input train.json --output "$OUT" --rows 127 --epochs 3 --max-length 4096
