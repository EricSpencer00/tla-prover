#!/bin/bash
# Frozen direct 2x2x2 generation from the restored protected checkpoint.
#PBS -A EVITA
#PBS -q debug
#PBS -N tla-checkpoint-paired
#PBS -l select=1:system=polaris:ngpus=1
#PBS -l walltime=00:15:00
#PBS -l filesystems=home:grand
#PBS -j oe
set -euo pipefail

STAGE=/grand/EVITA/eric-spencer/tla-checkpoint-paired-generation-20260911-v1
XGRAMMAR_SITE=/grand/EVITA/eric-spencer/tla-checkpoint-preflight-deps/xgrammar-0.2.2-cp312
cd "$STAGE"
exec > "job.${PBS_JOBID%%.*}.log" 2>&1
export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 TOKENIZERS_PARALLELISM=false
export HF_HOME=/grand/EVITA/eric-spencer/hf-cache PYTHONUNBUFFERED=1
# Triton builds XGrammar's token-mask launcher with CC. Polaris defaults CC to
# nvc, which rejects Triton's GCC-specific -Wno-psabi compiler flag.
export CC=/usr/bin/gcc
BASE=/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-learning-20260906-v1
MODEL=/grand/EVITA/eric-spencer/hf-cache/hub/models--meta-llama--Llama-3.1-8B-Instruct/snapshots/0e9e39f249a16976918f6564b8830bc894c89659
CHECKPOINT=/grand/EVITA/eric-spencer/tla-structured-polaris-20260911/result.7605656/policy_optimizer.pt
GRAMMAR=$BASE/harness/grammars/tla_module_v0.ebnf
sha256sum -c SHA256SUMS
/home/eric-spencer/ChatTLA/.venv/bin/python -u protected_checkpoint_paired_generation.py \
  --packet "$BASE/train.json" --model "$MODEL" --checkpoint "$CHECKPOINT" \
  --grammar "$GRAMMAR" --xgrammar-site "$XGRAMMAR_SITE" \
  --output "result.${PBS_JOBID%%.*}"
