#!/bin/bash
#PBS -A EVITA
#PBS -q debug
#PBS -N tla-typed-agenda-v1
#PBS -l select=1:system=polaris:ncpus=64:ngpus=1
#PBS -l walltime=00:15:00
#PBS -l filesystems=home:grand
#PBS -j oe
#PBS -o /home/eric-spencer/tla-typed-agenda-20260917-v1/train.stdout
#PBS -e /home/eric-spencer/tla-typed-agenda-20260917-v1/train.stderr
set -euo pipefail
ROOT=/home/eric-spencer/tla-typed-agenda-20260917-v1
BASE=/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1
export PYTHONPATH="$ROOT:$ROOT/tools:$BASE:$BASE/tools"
export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 TOKENIZERS_PARALLELISM=false
export HF_HOME=/grand/EVITA/eric-spencer/hf-cache PYTHONUNBUFFERED=1
export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1
export PATH="/grand/EVITA/eric-spencer/tools/jre21/bin:$PATH"
export JAVA_HOME=/grand/EVITA/eric-spencer/tools/jre21
PYTHON=/home/eric-spencer/ChatTLA/.venv/bin/python
MODEL=/grand/EVITA/eric-spencer/hf-cache/hub/models--meta-llama--Llama-3.1-8B-Instruct/snapshots/0e9e39f249a16976918f6564b8830bc894c89659
PARENT=/home/eric-spencer/tla-structured-span-train-20260914-v3/result.7618905/policy_optimizer.pt
PACKET="$ROOT/packet.json"
OUT="$ROOT/result.${PBS_JOBID%%.*}"
test -x "$PYTHON" -a -f "$MODEL/config.json" -a -f "$PACKET"
test -f "$ROOT/tools/__init__.py"
test ! -e "$OUT"
test "$(sha256sum "$PACKET" | awk '{print $1}')" = c85da2971dc9152378373b041e7f6b7af9e718b53fb317037283c0d3f4fe2373
test "$(sha256sum "$PARENT" | awk '{print $1}')" = 87489e4778193c15e12d1714eb26dd8da03c0bacb3712e26f96f24454dcf8511
"$PYTHON" -m py_compile "$ROOT/tools/proof_typed_agenda.py" "$ROOT/tools/proof_typed_agenda_cuda_train.py" "$ROOT/tools/proof_cuda_train.py"
"$PYTHON" "$ROOT/tools/proof_typed_agenda.py" --packet "$PACKET" \
  --expected-packet-sha256 c85da2971dc9152378373b041e7f6b7af9e718b53fb317037283c0d3f4fe2373 >/dev/null
"$PYTHON" -u "$ROOT/tools/proof_typed_agenda_cuda_train.py" \
  --packet "$PACKET" --expected-packet-sha256 c85da2971dc9152378373b041e7f6b7af9e718b53fb317037283c0d3f4fe2373 \
  --model "$MODEL" --parent "$PARENT" --output "$OUT" --updates 32 --lr 0.01
