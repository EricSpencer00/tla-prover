#!/bin/bash
# Bounded admission test for the validated ChattLA 20B GPT-OSS base and a
# theorem-repair LoRA. This is an execution gate only: no benchmark result is
# scored unless the engine starts, answers a request, and exits cleanly.
#PBS -N chattla20b-admit
#PBS -A EVITA
#PBS -q by-gpu
#PBS -l select=1:ngpus=4:ncpus=64:mem=256gb
#PBS -l place=pack:shared
#PBS -l walltime=00:30:00
#PBS -l filesystems=home:grand
#PBS -j oe
exec > "/home/eric-spencer/chattla20b_admission.${PBS_JOBID%%.*}.log" 2>&1
set -euxo pipefail
ulimit -n 65536 || true
module load conda/2026-06-08 >/dev/null 2>&1
conda activate base >/dev/null 2>&1
export HF_HUB_OFFLINE=1
export HF_HOME=/grand/EVITA/eric-spencer/hf-cache
export OMP_NUM_THREADS=8 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1
export VLLM_LOGGING_LEVEL=INFO
export PYTHONUNBUFFERED=1

BASE=/grand/EVITA/eric-spencer/hf-cache/hub/models--EricSpencer00--chattla-20b/snapshots/c1a3e8b5c6916ce4a0ed830e996662ca28e0a262
ADAPTER=/grand/EVITA/eric-spencer/chattla_artifacts/tla_repair_proof_primary/178602/checkpoints/final
PORT=8321
test -f "$BASE/config.json"
test -f "$BASE/model.safetensors"
test -f "$ADAPTER/adapter_config.json"
test -f "$ADAPTER/adapter_model.safetensors"
# The HF snapshot carries PEFT files beside the base weights. Stage a clean
# symlink-only base directory so vLLM cannot mistake adapter_model.safetensors
# for a base checkpoint during engine initialization.
STAGE="/home/eric-spencer/chattla20b-adapter-base-stage-${PBS_JOBID%%.*}"
mkdir -p "$STAGE"
for f in config.json generation_config.json tokenizer.json tokenizer_config.json chat_template.jinja model.safetensors; do
  ln -sfn "$BASE/$f" "$STAGE/$f"
done
python -u -c 'import vllm, transformers; print("RUNTIME", vllm.__version__, transformers.__version__, flush=True)'

vllm serve "$STAGE" --tokenizer "$STAGE" \
  --served-model-name chattla20b-repair \
  --tensor-parallel-size 4 --max-model-len 4096 \
  --gpu-memory-utilization 0.88 --max-num-seqs 2 --enforce-eager \
  --enable-lora --lora-modules repair="$ADAPTER" \
  --port "$PORT" --host 127.0.0.1 --trust-remote-code \
  > "/home/eric-spencer/chattla20b_vllm.${PBS_JOBID%%.*}.log" 2>&1 &
SERVER=$!
cleanup() { kill "$SERVER" 2>/dev/null || true; wait "$SERVER" 2>/dev/null || true; }
trap cleanup EXIT

for _ in $(seq 1 120); do
  if curl --noproxy "*" -fsS "http://127.0.0.1:${PORT}/openapi.json" >/dev/null 2>&1; then break; fi
  kill -0 "$SERVER" 2>/dev/null || { cat "/home/eric-spencer/chattla20b_vllm.${PBS_JOBID%%.*}.log"; exit 1; }
  sleep 5
done
curl --noproxy "*" -fsS "http://127.0.0.1:${PORT}/openapi.json" >/dev/null
curl --noproxy "*" -fsS "http://127.0.0.1:${PORT}/openapi.json" > "/home/eric-spencer/chattla20b_models.${PBS_JOBID%%.*}.json"
curl --noproxy "*" -fsS "http://127.0.0.1:${PORT}/v1/completions" \
  -H 'Content-Type: application/json' \
  -d '{"model":"chattla20b-repair","prompt":"Return exactly OK.","max_tokens":4,"temperature":0}' \
  > "/home/eric-spencer/chattla20b_completion.${PBS_JOBID%%.*}.json"
echo ADMISSION_PASS
