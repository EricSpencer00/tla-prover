#!/bin/bash
# Isolate base-model admission from PEFT/LoRA compatibility.
#PBS -N chattla20b-base
#PBS -A EVITA
#PBS -q by-gpu
#PBS -l select=1:ngpus=4:ncpus=64:mem=256gb
#PBS -l place=pack:shared
#PBS -l walltime=00:20:00
#PBS -l filesystems=home:grand
#PBS -j oe
exec > "/home/eric-spencer/chattla20b_base.${PBS_JOBID%%.*}.log" 2>&1
set -euxo pipefail
module load conda/2026-06-08 >/dev/null 2>&1
conda activate base >/dev/null 2>&1
export HF_HUB_OFFLINE=1 HF_HOME=/grand/EVITA/eric-spencer/hf-cache
export OMP_NUM_THREADS=8 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1
export VLLM_LOGGING_LEVEL=INFO PYTHONUNBUFFERED=1
BASE=/grand/EVITA/eric-spencer/hf-cache/hub/models--EricSpencer00--chattla-20b/snapshots/c1a3e8b5c6916ce4a0ed830e996662ca28e0a262
test -f "$BASE/config.json"; test -f "$BASE/model.safetensors"
# The HF snapshot also contains PEFT files. vLLM scans every safetensors file
# in the model directory, so isolate the base weights without copying them.
STAGE="/home/eric-spencer/chattla20b-base-stage-${PBS_JOBID%%.*}"
mkdir -p "$STAGE"
for f in config.json generation_config.json tokenizer.json tokenizer_config.json chat_template.jinja model.safetensors; do
  ln -sfn "$BASE/$f" "$STAGE/$f"
done
PORT=8322
vllm serve "$STAGE" --tokenizer "$STAGE" --served-model-name chattla20b-base \
  --tensor-parallel-size 4 --max-model-len 2048 --gpu-memory-utilization 0.88 \
  --max-num-seqs 2 --enforce-eager --port "$PORT" --host 127.0.0.1 \
  --trust-remote-code > "/home/eric-spencer/chattla20b_base_vllm.${PBS_JOBID%%.*}.log" 2>&1 &
SERVER=$!; trap 'kill "$SERVER" 2>/dev/null || true; wait "$SERVER" 2>/dev/null || true' EXIT
for _ in $(seq 1 120); do
  curl --noproxy "*" -fsS "http://127.0.0.1:${PORT}/openapi.json" >/dev/null 2>&1 && break
  kill -0 "$SERVER" 2>/dev/null || { cat "/home/eric-spencer/chattla20b_base_vllm.${PBS_JOBID%%.*}.log"; exit 1; }
  sleep 5
done
curl --noproxy "*" -fsS "http://127.0.0.1:${PORT}/openapi.json" >/dev/null
curl --noproxy "*" -fsS "http://127.0.0.1:${PORT}/v1/completions" -H 'Content-Type: application/json' \
  -d '{"model":"chattla20b-base","prompt":"Return exactly OK.","max_tokens":4,"temperature":0}' \
  > "/home/eric-spencer/chattla20b_base_completion.${PBS_JOBID%%.*}.json"
echo BASE_ADMISSION_PASS
