#!/bin/bash
#PBS -A EVITA
#PBS -q debug
#PBS -N tla-learn169-eval
#PBS -l select=1:system=polaris
#PBS -l walltime=01:00:00
#PBS -l filesystems=home:grand
#PBS -j oe
set -euo pipefail
: "${FULLMODULE_ROOT:?isolated staged root required}"
: "${FULLMODULE_PACKET_SHA:?exact protected30 packet hash required}"
: "${FULLMODULE_PARENT:?immutable8866 parent required}"
: "${FULLMODULE_CHILD:?actual338-SFT child required}"
: "${FULLMODULE_TRAINING_ROOT:?actual complete338 SFT output required}"
: "${FULLMODULE_INPUT_SHA:?exact TRAIN169 packet hash required}"
: "${FULLMODULE_CHILD_SHA:?actual validated338-update child hash required}"
: "${FULLMODULE_PARENT_TRAINING_INPUT:?actual TRAIN42 packet required}"
: "${FULLMODULE_PARENT_TRAINING_ADMISSION:?actual84-update admission required}"
: "${FULLMODULE_PARENT_TRAINING_OUTPUT:?actual84-update output required}"
: "${FULLMODULE_PARENT_PARENT:?immutable1bb6 grandparent required}"
cd "$FULLMODULE_ROOT"
export PYTHONUNBUFFERED=1
export OMP_NUM_THREADS=4 OPENBLAS_NUM_THREADS=4 MKL_NUM_THREADS=4 NUMEXPR_NUM_THREADS=4
export TLA_PROMPT_WRAPPER_AWARE=0 TLA_PROMPT_NO_REDEF=0 TLA_PROMPT_ARITY=0 GEN_EVAL_CONCURRENCY=1
timeout --signal=TERM --kill-after=20s 3500s /home/eric-spencer/ChatTLA/.venv/bin/python \
 tools/proof_fullmodule_learning_eval.py run --packet prompts.json --expected-packet-sha256 "$FULLMODULE_PACKET_SHA" \
 --model-path /grand/EVITA/eric-spencer/hf-cache/hub/models--meta-llama--Llama-3.1-8B-Instruct/snapshots/0e9e39f249a16976918f6564b8830bc894c89659 \
 --parent-checkpoint "$FULLMODULE_PARENT" --checkpoint "$FULLMODULE_CHILD" \
 --training-input train.json --training-admission training-admission.json --training-output "$FULLMODULE_TRAINING_ROOT" \
 --parent-training-input "$FULLMODULE_PARENT_TRAINING_INPUT" --parent-training-admission "$FULLMODULE_PARENT_TRAINING_ADMISSION" \
 --parent-training-output "$FULLMODULE_PARENT_TRAINING_OUTPUT" --parent-parent-checkpoint "$FULLMODULE_PARENT_PARENT" \
 --expected-input-sha256 "$FULLMODULE_INPUT_SHA" --expected-child-sha256 "$FULLMODULE_CHILD_SHA" \
 --admission paired-admission.json --output results/paired
