#!/bin/bash
#PBS -A EVITA
#PBS -q debug
#PBS -N tla-rl-numerics
#PBS -l select=1:system=polaris
#PBS -l walltime=00:30:00
#PBS -l filesystems=home:grand
#PBS -j oe
set -euo pipefail
: "${PROOF_NUMERICS_ROOT:?isolated diagnostic root required}"
cd "$PROOF_NUMERICS_ROOT"
export PYTHONUNBUFFERED=1
timeout --signal=TERM --kill-after=20s 1500s \
 /home/eric-spencer/ChatTLA/.venv/bin/python tools/proof_token_rl_numerics_probe.py \
 --requests requests.json --broader-prompts broader-prompts.json \
 --model-path /grand/EVITA/eric-spencer/hf-cache/hub/models--meta-llama--Llama-3.1-8B-Instruct/snapshots/0e9e39f249a16976918f6564b8830bc894c89659 \
 --checkpoint /grand/EVITA/eric-spencer/prove-tla-exposure-cuda-20260905-v1/results/cycle/training/policy_optimizer.pt \
 --rollouts /grand/EVITA/eric-spencer/prove-tla-token-rl-20260906-v2/results/cycle/training/rollouts.jsonl \
 --reward-file /grand/EVITA/eric-spencer/prove-tla-token-rl-20260906-v2/results/cycle/training/rewards.json \
 --receipt /grand/EVITA/eric-spencer/prove-tla-token-rl-20260906-v2/results/cycle/training/rewards.receipt.json \
 --output results/probe
