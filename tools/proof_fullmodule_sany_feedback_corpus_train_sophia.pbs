#!/bin/bash
#PBS -A EVITA
#PBS -q by-gpu
#PBS -N tla-sany-corpus-train
#PBS -l select=1:system=sophia:ncpus=32:ngpus=1:mem=120gb
#PBS -l walltime=01:00:00
#PBS -l filesystems=home:grand
#PBS -j oe
#PBS -o /lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tla-sany-corpus-train.stdout
#PBS -e /lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1/tla-sany-corpus-train.stderr
set -euo pipefail
: "${SFB_ROOT:?}"
cd "$SFB_ROOT"
module load conda/2026-06-08 >/dev/null 2>&1
conda activate base >/dev/null 2>&1
export PATH="/grand/EVITA/eric-spencer/tools/jre21/bin:$PATH"
export JAVA_HOME=/grand/EVITA/eric-spencer/tools/jre21
export PYTHONUNBUFFERED=1 OMP_NUM_THREADS=4 OPENBLAS_NUM_THREADS=4 MKL_NUM_THREADS=4 NUMEXPR_NUM_THREADS=4
MODEL_PATH=/grand/projects/EVITA/eric-spencer/hf-cache/hub/models--meta--llama--Llama-3.1-8B-Instruct/snapshots/0e9e39f249a16976918f6564b8830bc894c89659
if [[ ! -f "$MODEL_PATH/config.json" ]]; then MODEL_PATH=/lus/grand/projects/EVITA/eric-spencer/hf-cache/hub/models--meta--llama--Llama-3.1-8B-Instruct/snapshots/0e9e39f249a16976918f6564b8830bc894c89659; fi
if [[ ! -f "$MODEL_PATH/config.json" ]]; then MODEL_PATH=/grand/EVITA/eric-spencer/hf-cache/hub/models--meta-llama--Llama-3.1-8B-Instruct/snapshots/0e9e39f249a16976918f6564b8830bc894c89659; fi
test -f "$MODEL_PATH/config.json"
BASE=/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-train-probe-eval-20260906-v1
INPUT=/lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-learning-20260906-v1/train.json
BASE_ADMISSION=$BASE/multi4-admission-v7.json
CHECKPOINT=$BASE/results/multi4-runtime-sophia-v2/policy_optimizer.pt
FEEDBACK=$BASE/results/sany-feedback-corpus-runtime-20260907-005612
if [[ ! -f sany-feedback-corpus-scaffold.json ]]; then
  python proof_fullmodule_sany_feedback_corpus_probe.py admit --input "$INPUT" --base-admission "$BASE_ADMISSION" --output sany-feedback-corpus-scaffold.json
fi
if [[ ! -f corpus-repair-admission-v8.json ]]; then
  python proof_fullmodule_sany_feedback_corpus_train.py repair-admit --input "$INPUT" --base-admission "$BASE_ADMISSION" --scaffold sany-feedback-corpus-scaffold.json --feedback "$FEEDBACK" --eval-receipt "$BASE/results/multi4-runtime-sophia-v2/receipt.json" --checkpoint "$CHECKPOINT" --output corpus-repair-admission-v8.json
fi
python proof_fullmodule_sany_feedback_corpus_train.py repair-worker --input "$INPUT" --base-admission "$BASE_ADMISSION" --scaffold sany-feedback-corpus-scaffold.json --feedback "$FEEDBACK" --eval-receipt "$BASE/results/multi4-runtime-sophia-v2/receipt.json" --checkpoint "$CHECKPOINT" --admission corpus-repair-admission-v8.json --model-path "$MODEL_PATH" --output results/sany-feedback-corpus-repair-v8-$(date +%Y%m%d-%H%M%S)
