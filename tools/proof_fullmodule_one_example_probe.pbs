#!/bin/bash
#PBS -A EVITA
#PBS -q debug
#PBS -N tla-one-example
#PBS -l select=1:system=polaris
#PBS -l walltime=01:00:00
#PBS -l filesystems=home:grand
#PBS -j oe
set -euo pipefail
: "${ONE_EXAMPLE_ROOT:?}"
: "${ONE_EXAMPLE_ADMISSION_SHA:?}"
cd "$ONE_EXAMPLE_ROOT"
export PATH="/grand/EVITA/eric-spencer/tools/jre21/bin:$PATH"
export JAVA_HOME=/grand/EVITA/eric-spencer/tools/jre21
java -version
export PYTHONUNBUFFERED=1
export OMP_NUM_THREADS=4 OPENBLAS_NUM_THREADS=4 MKL_NUM_THREADS=4 NUMEXPR_NUM_THREADS=4
timeout --signal=TERM --kill-after=20s 3500s /home/eric-spencer/ChatTLA/.venv/bin/python \
 tools/proof_fullmodule_one_example_probe.py worker \
 --input /lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-learning-20260906-v1/train.json \
 --model-path /grand/EVITA/eric-spencer/hf-cache/hub/models--meta-llama--Llama-3.1-8B-Instruct/snapshots/0e9e39f249a16976918f6564b8830bc894c89659 \
 --checkpoint /lus/grand/projects/EVITA/eric-spencer/prove-tla-fullmodule-learning-20260906-v1/results/training/policy_optimizer.pt \
 --lineage-checkpoint /lus/grand/projects/EVITA/eric-spencer/prove-tla-sany-repair-learning-20260906-v1/results/training/policy_optimizer.pt \
 --parent-training-input /lus/grand/projects/EVITA/eric-spencer/prove-tla-sany-repair-learning-20260906-v1/train.json \
 --parent-training-admission /lus/grand/projects/EVITA/eric-spencer/prove-tla-sany-repair-learning-20260906-v1/training-admission.json \
 --parent-training-output /lus/grand/projects/EVITA/eric-spencer/prove-tla-sany-repair-learning-20260906-v1/results/training \
 --parent-parent-checkpoint /lus/grand/projects/EVITA/eric-spencer/prove-tla-sumsequence-proof-rl-20260906-v1/results/training/policy_optimizer.pt \
 --expected-input-sha256 a125a0d5bf66dedfb664c692c69dcd612181a8b7ac316c264075ca434061ce6c \
 --admission one-example-admission.json --output results/one-example-runtime-fixed-v2
